bglro:Context a owl:Class ;
    rdfs:label "Context"@en ;
    rdfs:comment "Life context in which a Bhagavad Gita law may be applicable."@en .

bglro:Intervention a owl:Class ;
    rdfs:label "Intervention"@en ;
    rdfs:comment "Recommended action associated with a mental state."@en .

bglro:LawApplicability a owl:Class ;
    rdfs:label "Law Applicability"@en ;
    rdfs:comment "Applicability of a fine-grained law to a context and situation."@en .

bglro:Recommendation a owl:Class ;
    rdfs:label "Recommendation"@en ;
    rdfs:comment "Recommendation connecting intervention, life situation, current mental state, fine-grained law, target mental state, and goal."@en .

bglro:LifeSituation a owl:Class ;
    rdfs:label "Life Situation"@en ;
    rdfs:comment "Specific life situation associated with a mental state."@en .

