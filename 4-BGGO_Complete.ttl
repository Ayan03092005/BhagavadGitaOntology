@prefix bggo: <http://www.semanticweb.org/apurbapaul/bggo#> .
@prefix bglo: <http://www.semanticweb.org/apurbapaul/bglo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bggo:BGGO a owl:Ontology ;
    rdfs:label "Bhagavad Gita Guna Ontology"@en ;
    rdfs:comment "Ontology representing Gunas, characteristics, actions, goals, categories, action records and Guna-Law mappings. Fine-Grained Laws are authoritatively defined in BGLO."@en .

bggo:action a owl:DatatypeProperty ;
    rdfs:label "Action"@en ;
    rdfs:domain bggo:Action ;
    rdfs:range xsd:string .

bggo:actionID a owl:DatatypeProperty ;
    rdfs:label "Action ID"@en ;
    rdfs:domain bggo:Action ;
    rdfs:range xsd:string .

bggo:actionRecordID a owl:DatatypeProperty ;
    rdfs:label "Action Record ID"@en ;
    rdfs:domain bggo:ActionRecord ;
    rdfs:range xsd:string .

bggo:associatedWithLaw a owl:ObjectProperty ;
    rdfs:label "associated with law"@en ;
    rdfs:domain bggo:Guna ;
    rdfs:range bglo:FineGrainedLaw .

bggo:category a owl:DatatypeProperty ;
    rdfs:label "Category"@en ;
    rdfs:domain bggo:Category ;
    rdfs:range xsd:string .

bggo:categoryID a owl:DatatypeProperty ;
    rdfs:label "Category ID"@en ;
    rdfs:domain bggo:Category ;
    rdfs:range xsd:string .

bggo:characteristic a owl:DatatypeProperty ;
    rdfs:label "Characteristic"@en ;
    rdfs:domain bggo:Characteristic ;
    rdfs:range xsd:string .

bggo:characteristicID a owl:DatatypeProperty ;
    rdfs:label "Characteristic ID"@en ;
    rdfs:domain bggo:Characteristic ;
    rdfs:range xsd:string .

bggo:effect a owl:DatatypeProperty ;
    rdfs:label "Effect"@en ;
    rdfs:domain bggo:Characteristic ;
    rdfs:range xsd:string .

bggo:goal a owl:DatatypeProperty ;
    rdfs:label "Goal"@en ;
    rdfs:domain bggo:Goal ;
    rdfs:range xsd:string .

bggo:goalID a owl:DatatypeProperty ;
    rdfs:label "Goal ID"@en ;
    rdfs:domain bggo:Goal ;
    rdfs:range xsd:string .

bggo:gunaID a owl:DatatypeProperty ;
    rdfs:label "Guna ID"@en ;
    rdfs:domain bggo:Guna ;
    rdfs:range xsd:string .

bggo:gunaLawID a owl:DatatypeProperty ;
    rdfs:label "Guna Law ID"@en ;
    rdfs:domain bggo:GunaLaw ;
    rdfs:range xsd:string .

bggo:hasAction a owl:ObjectProperty ;
    rdfs:label "has action"@en ;
    rdfs:domain bggo:ActionRecord ;
    rdfs:range bggo:Action .

bggo:hasActionRecord a owl:ObjectProperty ;
    rdfs:label "has action record"@en ;
    rdfs:domain bggo:Guna ;
    rdfs:range bggo:ActionRecord .

bggo:hasCategory a owl:ObjectProperty ;
    rdfs:label "has category"@en ;
    rdfs:domain bggo:ActionRecord ;
    rdfs:range bggo:Category .

bggo:hasCharacteristic a owl:ObjectProperty ;
    rdfs:label "has characteristic"@en ;
    rdfs:domain bggo:Guna ;
    rdfs:range bggo:Characteristic .

bggo:hasFineGrainedLaw a owl:ObjectProperty ;
    rdfs:label "has fine-grained law"@en ;
    rdfs:domain bggo:GunaLaw ;
    rdfs:range bglo:FineGrainedLaw .

bggo:hasGoal a owl:ObjectProperty ;
    rdfs:label "has goal"@en ;
    rdfs:domain bggo:ActionRecord ;
    rdfs:range bggo:Goal .

bggo:hasGuna a owl:ObjectProperty ;
    rdfs:label "has Guna"@en ;
    rdfs:domain bggo:GunaLaw ;
    rdfs:range bggo:Guna .

bggo:hasGunaLaw a owl:ObjectProperty ;
    rdfs:label "has Guna law"@en ;
    rdfs:domain bggo:Guna ;
    rdfs:range bggo:GunaLaw .

bggo:name a owl:DatatypeProperty ;
    rdfs:label "Name"@en ;
    rdfs:domain bggo:Guna ;
    rdfs:range xsd:string .

bggo:ontologyClass a owl:DatatypeProperty ;
    rdfs:label "Ontology Class"@en ;
    rdfs:domain bggo:Guna ;
    rdfs:range xsd:string .

