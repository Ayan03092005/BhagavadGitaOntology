@prefix bg: <http://www.semanticweb.org/apurbapaul/bgso#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bg:BGSO a owl:Ontology ;
    rdfs:label "Bhagavad Gita Structural Ontology" ;
    rdfs:comment "Ontology representing the structural organization of the Bhagavad Gita including book, chapter and verse information." ;
    owl:versionInfo "Version 3.0 - Complete Chapter and Verse Integration" .

bg:bookID a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Book ID" ;
    rdfs:domain bg:Book ;
    rdfs:range xsd:string .

bg:bookTitle a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Book Title" ;
    rdfs:domain bg:Book ;
    rdfs:range xsd:string .

bg:bookTitleSanskrit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Book Title Sanskrit" ;
    rdfs:domain bg:Book ;
    rdfs:range xsd:string .

bg:chapterID a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Chapter ID" ;
    rdfs:domain bg:Chapter ;
    rdfs:range xsd:string .

bg:chapterName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Chapter Name" ;
    rdfs:domain bg:Chapter ;
    rdfs:range xsd:string .

bg:chapterNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Chapter Number" ;
    rdfs:domain bg:Chapter ;
    rdfs:range xsd:integer .

bg:citation a owl:AnnotationProperty ;
    rdfs:label "citation" ;
    rdfs:comment "Citation information." .

bg:definition a owl:AnnotationProperty ;
    rdfs:label "definition" ;
    rdfs:comment "Definition or explanatory description." .

bg:edition a owl:AnnotationProperty ;
    rdfs:label "edition" ;
    rdfs:comment "Book edition information." .

bg:hasChapter a owl:ObjectProperty ;
    rdfs:label "has Chapter" ;
    rdfs:comment "Connects the Bhagavad Gita book to a chapter." ;
    rdfs:domain bg:Book ;
    rdfs:range bg:Chapter ;
    owl:inverseOf bg:belongsToBook .

bg:hasComponent a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has Component" ;
    rdfs:comment "Generic structural relationship between book components." ;
    rdfs:domain bg:BookComponent ;
    rdfs:range bg:BookComponent .

bg:hasVerse a owl:ObjectProperty ;
    rdfs:label "has Verse" ;
    rdfs:comment "Connects a chapter to its verses." ;
    rdfs:domain bg:Chapter ;
    rdfs:range bg:Verse ;
    owl:inverseOf bg:belongsToChapter .

bg:note a owl:AnnotationProperty ;
    rdfs:label "note" ;
    rdfs:comment "Additional notes." .

bg:sanskritChapterName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Sanskrit Chapter Name" ;
    rdfs:domain bg:Chapter ;
    rdfs:range xsd:string .

bg:source a owl:AnnotationProperty ;
    rdfs:label "source" ;
    rdfs:comment "Original source." .

bg:translator a owl:AnnotationProperty ;
    rdfs:label "translator" ;
    rdfs:comment "Translator information." .

bg:verseID a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Verse ID" ;
    rdfs:domain bg:Verse ;
    rdfs:range xsd:string .

bg:verseNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Verse Number" ;
    rdfs:domain bg:Verse ;
    rdfs:range xsd:string .

bg:verseText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Verse Text" ;
    rdfs:domain bg:Verse ;
    rdfs:range xsd:string .

bg:belongsToBook a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to Book" ;
    rdfs:comment "Connects a chapter to the Bhagavad Gita book." ;
    rdfs:domain bg:Chapter ;
    rdfs:range bg:Book .

bg:belongsToChapter a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to Chapter" ;
    rdfs:comment "Connects a verse to its chapter." ;
    rdfs:domain bg:Verse ;
    rdfs:range bg:Chapter .

bg:follows a owl:ObjectProperty ;
    rdfs:label "follows" ;
    rdfs:comment "Inverse canonical ordering relation." ;
    rdfs:domain bg:BookComponent ;
    rdfs:range bg:BookComponent ;
    owl:inverseOf bg:precedes .

bg:nextChapter a owl:ObjectProperty ;
    rdfs:label "next Chapter" ;
    rdfs:comment "Immediate next chapter." ;
    rdfs:domain bg:Chapter ;
    rdfs:range bg:Chapter ;
    owl:inverseOf bg:previousChapter .

bg:nextVerse a owl:ObjectProperty ;
    rdfs:label "next Verse" ;
    rdfs:comment "Immediate next verse in canonical order." ;
    rdfs:domain bg:Verse ;
    rdfs:range bg:Verse ;
    owl:inverseOf bg:previousVerse .

bg:precedes a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes" ;
    rdfs:comment "Canonical ordering relation between book components." ;
    rdfs:domain bg:BookComponent ;
    rdfs:range bg:BookComponent ;
    owl:inverseOf bg:follows .

bg:previousChapter a owl:ObjectProperty ;
    rdfs:label "previous Chapter" ;
    rdfs:comment "Immediate previous chapter." ;
    rdfs:domain bg:Chapter ;
    rdfs:range bg:Chapter ;
    owl:inverseOf bg:nextChapter .

bg:previousVerse a owl:ObjectProperty ;
    rdfs:label "previous Verse" ;
    rdfs:comment "Immediate previous verse in canonical order." ;
    rdfs:domain bg:Verse ;
    rdfs:range bg:Verse ;
    owl:inverseOf bg:nextVerse .

bg:V001 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:nextVerse bg:V002 ;
    bg:precedes bg:V002 ;
    bg:verseID "V001"^^xsd:string ;
    bg:verseNumber "1.1" ;
    bg:verseText "Dhṛtarāṣṭra said: O Sañjaya, after my sons and the sons of Pāṇḍu assembled in the place of pilgrimage at Kurukṣetra, desiring to fight, what did they do?" .

bg:V663 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V662 ;
    bg:previousVerse bg:V662 ;
    bg:verseID "V663"^^xsd:string ;
    bg:verseNumber "18.78" ;
    bg:verseText "Wherever there is Kṛṣṇa, the master of all mystics, and wherever there is Arjuna, the supreme archer, there will also certainly be opulence, victory, extraordinary power, and morality. That is my opinion." .

bg:V002 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V001 ;
    bg:nextVerse bg:V003 ;
    bg:precedes bg:V003 ;
    bg:previousVerse bg:V001 ;
    bg:verseID "V002"^^xsd:string ;
    bg:verseNumber "1.2" ;
    bg:verseText "Sañjaya said: O King, after looking over the army arranged in military formation by the sons of Pāṇḍu, King Duryodhana went to his teacher and spoke the following words." .

bg:V003 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V002 ;
    bg:nextVerse bg:V004 ;
    bg:precedes bg:V004 ;
    bg:previousVerse bg:V002 ;
    bg:verseID "V003"^^xsd:string ;
    bg:verseNumber "1.3" ;
    bg:verseText "O my teacher, behold the great army of the sons of Pāṇḍu, so expertly arranged by your intelligent disciple the son of Drupada." .

bg:V004 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V003 ;
    bg:nextVerse bg:V005 ;
    bg:precedes bg:V005 ;
    bg:previousVerse bg:V003 ;
    bg:verseID "V004"^^xsd:string ;
    bg:verseNumber "1.4" ;
    bg:verseText "Here in this army are many heroic bowmen equal in fighting to Bhīma and Arjuna: great fighters like Yuyudhāna, Virāṭa and Drupada." .

bg:V005 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V004 ;
    bg:nextVerse bg:V006 ;
    bg:precedes bg:V006 ;
    bg:previousVerse bg:V004 ;
    bg:verseID "V005"^^xsd:string ;
    bg:verseNumber "1.5" ;
    bg:verseText "There are also great heroic, powerful fighters like Dhṛṣṭaketu, Cekitāna, Kāśirāja, Purujit, Kuntibhoja and Śaibya." .

bg:V006 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V005 ;
    bg:nextVerse bg:V007 ;
    bg:precedes bg:V007 ;
    bg:previousVerse bg:V005 ;
    bg:verseID "V006"^^xsd:string ;
    bg:verseNumber "1.6" ;
    bg:verseText "There are the mighty Yudhāmanyu, the very powerful Uttamaujā, the son of Subhadrā and the sons of Draupadī. All these warriors are great chariot fighters." .

bg:V007 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V006 ;
    bg:nextVerse bg:V008 ;
    bg:precedes bg:V008 ;
    bg:previousVerse bg:V006 ;
    bg:verseID "V007"^^xsd:string ;
    bg:verseNumber "1.7" ;
    bg:verseText "But for your information, O best of the brāhmaṇas, let me tell you about the captains who are especially qualified to lead my military force." .

bg:V008 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V007 ;
    bg:nextVerse bg:V009 ;
    bg:precedes bg:V009 ;
    bg:previousVerse bg:V007 ;
    bg:verseID "V008"^^xsd:string ;
    bg:verseNumber "1.8" ;
    bg:verseText "There are personalities like you, Bhīṣma, Karṇa, Kṛpa, Aśvatthāmā, Vikarṇa and the son of Somadatta called Bhūriśravā, who are always victorious in battle." .

bg:V009 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V008 ;
    bg:nextVerse bg:V010 ;
    bg:precedes bg:V010 ;
    bg:previousVerse bg:V008 ;
    bg:verseID "V009"^^xsd:string ;
    bg:verseNumber "1.9" ;
    bg:verseText "There are many other heroes who are prepared to lay down their lives for my sake. All of them are well equipped with different kinds of weapons, and all are experienced in military science." .

bg:V010 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V009 ;
    bg:nextVerse bg:V011 ;
    bg:precedes bg:V011 ;
    bg:previousVerse bg:V009 ;
    bg:verseID "V010"^^xsd:string ;
    bg:verseNumber "1.10" ;
    bg:verseText "Our strength is immeasurable, and we are perfectly protected by Grandfather Bhīṣma, whereas the strength of the Pāṇḍavas, carefully protected by Bhīma, is limited." .

bg:V011 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V010 ;
    bg:nextVerse bg:V012 ;
    bg:precedes bg:V012 ;
    bg:previousVerse bg:V010 ;
    bg:verseID "V011"^^xsd:string ;
    bg:verseNumber "1.11" ;
    bg:verseText "All of you must now give full support to Grandfather Bhīṣma, as you stand at your respective strategic points of entrance into the phalanx of the army." .

bg:V012 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V011 ;
    bg:nextVerse bg:V013 ;
    bg:precedes bg:V013 ;
    bg:previousVerse bg:V011 ;
    bg:verseID "V012"^^xsd:string ;
    bg:verseNumber "1.12" ;
    bg:verseText "Then Bhīṣma, the great valiant grandsire of the Kuru dynasty, the grandfather of the fighters, blew his conchshell very loudly, making a sound like the roar of a lion, giving Duryodhana joy." .

bg:V013 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V012 ;
    bg:nextVerse bg:V014 ;
    bg:precedes bg:V014 ;
    bg:previousVerse bg:V012 ;
    bg:verseID "V013"^^xsd:string ;
    bg:verseNumber "1.13" ;
    bg:verseText "After that, the conchshells, drums, bugles, trumpets and horns were all suddenly sounded, and the combined sound was tumultuous." .

bg:V014 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V013 ;
    bg:nextVerse bg:V015 ;
    bg:precedes bg:V015 ;
    bg:previousVerse bg:V013 ;
    bg:verseID "V014"^^xsd:string ;
    bg:verseNumber "1.14" ;
    bg:verseText "On the other side, both Lord Kṛṣṇa and Arjuna, stationed on a great chariot drawn by white horses, sounded their transcendental conchshells." .

bg:V015 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V014 ;
    bg:nextVerse bg:V016 ;
    bg:precedes bg:V016 ;
    bg:previousVerse bg:V014 ;
    bg:verseID "V015"^^xsd:string ;
    bg:verseNumber "1.15" ;
    bg:verseText "Lord Kṛṣṇa blew His conchshell, called Pāñcajanya; Arjuna blew his, the Devadatta; and Bhīma, the voracious eater and performer of herculean tasks, blew his terrific conchshell, called Pauṇḍra." .

bg:V016 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V015 ;
    bg:nextVerse bg:V017 ;
    bg:precedes bg:V017 ;
    bg:previousVerse bg:V015 ;
    bg:verseID "V016"^^xsd:string ;
    bg:verseNumber "1.16–18" ;
    bg:verseText "King Yudhiṣṭhira, Nakula, Sahadeva, Śikhaṇḍī, Dhṛṣṭadyumna, Virāṭa, Sātyaki, Drupada, the sons of Draupadī and Abhimanyu all blew their respective conchshells." .

bg:V017 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V016 ;
    bg:nextVerse bg:V018 ;
    bg:precedes bg:V018 ;
    bg:previousVerse bg:V016 ;
    bg:verseID "V017"^^xsd:string ;
    bg:verseNumber "1.19" ;
    bg:verseText "The tremendous vibration of the conchshells shattered the hearts of the sons of Dhṛtarāṣṭra." .

bg:V018 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V017 ;
    bg:nextVerse bg:V019 ;
    bg:precedes bg:V019 ;
    bg:previousVerse bg:V017 ;
    bg:verseID "V018"^^xsd:string ;
    bg:verseNumber "1.20" ;
    bg:verseText "Arjuna, seated on the chariot bearing Hanumān's flag, lifted his bow and addressed Lord Kṛṣṇa after seeing the opposing armies." .

bg:V019 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V018 ;
    bg:nextVerse bg:V020 ;
    bg:precedes bg:V020 ;
    bg:previousVerse bg:V018 ;
    bg:verseID "V019"^^xsd:string ;
    bg:verseNumber "1.21–22" ;
    bg:verseText "Arjuna requested Kṛṣṇa to place the chariot between the two armies so he could observe those assembled for battle." .

bg:V020 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V019 ;
    bg:nextVerse bg:V021 ;
    bg:precedes bg:V021 ;
    bg:previousVerse bg:V019 ;
    bg:verseID "V020"^^xsd:string ;
    bg:verseNumber "1.23" ;
    bg:verseText "Arjuna wished to see those who had come to fight in support of Duryodhana." .

bg:V021 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V020 ;
    bg:nextVerse bg:V022 ;
    bg:precedes bg:V022 ;
    bg:previousVerse bg:V020 ;
    bg:verseID "V021"^^xsd:string ;
    bg:verseNumber "1.24" ;
    bg:verseText "Sañjaya described how Kṛṣṇa placed the chariot between the two armies." .

bg:V022 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V021 ;
    bg:nextVerse bg:V023 ;
    bg:precedes bg:V023 ;
    bg:previousVerse bg:V021 ;
    bg:verseID "V022"^^xsd:string ;
    bg:verseNumber "1.25" ;
    bg:verseText "Kṛṣṇa asked Arjuna to behold all the Kurus assembled there." .

bg:V023 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V022 ;
    bg:nextVerse bg:V024 ;
    bg:precedes bg:V024 ;
    bg:previousVerse bg:V022 ;
    bg:verseID "V023"^^xsd:string ;
    bg:verseNumber "1.26" ;
    bg:verseText "Arjuna saw his relatives, teachers, friends, sons, grandfathers and well-wishers on both sides." .

bg:V024 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V023 ;
    bg:nextVerse bg:V025 ;
    bg:precedes bg:V025 ;
    bg:previousVerse bg:V023 ;
    bg:verseID "V024"^^xsd:string ;
    bg:verseNumber "1.27" ;
    bg:verseText "Overwhelmed with compassion, Arjuna began speaking." .

bg:V025 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V024 ;
    bg:nextVerse bg:V026 ;
    bg:precedes bg:V026 ;
    bg:previousVerse bg:V024 ;
    bg:verseID "V025"^^xsd:string ;
    bg:verseNumber "1.28" ;
    bg:verseText "Arjuna described his trembling body and drying mouth upon seeing his relatives." .

bg:V026 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V025 ;
    bg:nextVerse bg:V027 ;
    bg:precedes bg:V027 ;
    bg:previousVerse bg:V025 ;
    bg:verseID "V026"^^xsd:string ;
    bg:verseNumber "1.29" ;
    bg:verseText "Arjuna's body trembled, his bow slipped from his hand, and his skin burned." .

bg:V027 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V026 ;
    bg:nextVerse bg:V028 ;
    bg:precedes bg:V028 ;
    bg:previousVerse bg:V026 ;
    bg:verseID "V027"^^xsd:string ;
    bg:verseNumber "1.30" ;
    bg:verseText "Arjuna declared he could not remain standing and foresaw only misfortune." .

bg:V028 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V027 ;
    bg:nextVerse bg:V029 ;
    bg:precedes bg:V029 ;
    bg:previousVerse bg:V027 ;
    bg:verseID "V028"^^xsd:string ;
    bg:verseNumber "1.31" ;
    bg:verseText "Arjuna questioned the value of victory, kingdom and happiness obtained by killing his own relatives." .

bg:V029 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V028 ;
    bg:nextVerse bg:V030 ;
    bg:precedes bg:V030 ;
    bg:previousVerse bg:V028 ;
    bg:verseID "V029"^^xsd:string ;
    bg:verseNumber "1.32–35" ;
    bg:verseText "Arjuna rejected fighting for kingdom or pleasure when all his loved ones stood before him, even refusing to fight for sovereignty over the three worlds." .

bg:V030 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V029 ;
    bg:nextVerse bg:V031 ;
    bg:precedes bg:V031 ;
    bg:previousVerse bg:V029 ;
    bg:verseID "V030"^^xsd:string ;
    bg:verseNumber "1.36" ;
    bg:verseText "Arjuna argued that killing relatives would bring sin and no happiness." .

bg:V031 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V030 ;
    bg:nextVerse bg:V032 ;
    bg:precedes bg:V032 ;
    bg:previousVerse bg:V030 ;
    bg:verseID "V031"^^xsd:string ;
    bg:verseNumber "1.37–38" ;
    bg:verseText "Arjuna reasoned that although blinded by greed, his opponents failed to see the consequences of destroying the family, he himself should not commit such sin." .

bg:V032 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V031 ;
    bg:nextVerse bg:V033 ;
    bg:precedes bg:V033 ;
    bg:previousVerse bg:V031 ;
    bg:verseID "V032"^^xsd:string ;
    bg:verseNumber "1.39" ;
    bg:verseText "Arjuna explained that destruction of the family destroys eternal family traditions and promotes irreligion." .

bg:V033 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V032 ;
    bg:nextVerse bg:V034 ;
    bg:precedes bg:V034 ;
    bg:previousVerse bg:V032 ;
    bg:verseID "V033"^^xsd:string ;
    bg:verseNumber "1.40" ;
    bg:verseText "Irreligion leads to degradation of women and the rise of unwanted progeny." .

bg:V034 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V033 ;
    bg:nextVerse bg:V035 ;
    bg:precedes bg:V035 ;
    bg:previousVerse bg:V033 ;
    bg:verseID "V034"^^xsd:string ;
    bg:verseNumber "1.41" ;
    bg:verseText "Unwanted progeny leads families and ancestors toward hellish existence because sacred rites cease." .

bg:V035 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V034 ;
    bg:nextVerse bg:V036 ;
    bg:precedes bg:V036 ;
    bg:previousVerse bg:V034 ;
    bg:verseID "V035"^^xsd:string ;
    bg:verseNumber "1.42" ;
    bg:verseText "Family destruction devastates social welfare, traditions and religious practices." .

bg:V036 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V035 ;
    bg:nextVerse bg:V037 ;
    bg:precedes bg:V037 ;
    bg:previousVerse bg:V035 ;
    bg:verseID "V036"^^xsd:string ;
    bg:verseNumber "1.43" ;
    bg:verseText "Arjuna recalled hearing that those whose family traditions are destroyed dwell in hell." .

bg:V037 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V036 ;
    bg:nextVerse bg:V038 ;
    bg:precedes bg:V038 ;
    bg:previousVerse bg:V036 ;
    bg:verseID "V037"^^xsd:string ;
    bg:verseNumber "1.44" ;
    bg:verseText "Arjuna lamented that desire for royal happiness had driven them toward grievous sin." .

bg:V038 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V037 ;
    bg:nextVerse bg:V039 ;
    bg:precedes bg:V039 ;
    bg:previousVerse bg:V037 ;
    bg:verseID "V038"^^xsd:string ;
    bg:verseNumber "1.45" ;
    bg:verseText "Arjuna declared it would be better to die unarmed than kill his relatives." .

bg:V039 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH01 ;
    bg:follows bg:V038 ;
    bg:nextVerse bg:V040 ;
    bg:precedes bg:V040 ;
    bg:previousVerse bg:V038 ;
    bg:verseID "V039"^^xsd:string ;
    bg:verseNumber "1.46" ;
    bg:verseText "Sañjaya concluded that Arjuna cast aside his bow and arrows and sat down on the chariot, overwhelmed with grief." .

bg:V040 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V039 ;
    bg:nextVerse bg:V041 ;
    bg:precedes bg:V041 ;
    bg:previousVerse bg:V039 ;
    bg:verseID "V040"^^xsd:string ;
    bg:verseNumber "2.1" ;
    bg:verseText "Sañjaya said: Seeing Arjuna full of compassion, his mind depressed, his eyes full of tears, Madhusūdana, Kṛṣṇa, spoke the following words." .

bg:V041 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V040 ;
    bg:nextVerse bg:V042 ;
    bg:precedes bg:V042 ;
    bg:previousVerse bg:V040 ;
    bg:verseID "V041"^^xsd:string ;
    bg:verseNumber "2.2" ;
    bg:verseText "The Supreme Personality of Godhead said: My dear Arjuna, how have these impurities come upon you? They are not at all befitting a man who knows the value of life. They lead not to higher planets but to infamy." .

bg:V042 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V041 ;
    bg:nextVerse bg:V043 ;
    bg:precedes bg:V043 ;
    bg:previousVerse bg:V041 ;
    bg:verseID "V042"^^xsd:string ;
    bg:verseNumber "2.3" ;
    bg:verseText "O son of Pṛthā, do not yield to this degrading impotence. It does not become you. Give up such petty weakness of heart and arise, O chastiser of the enemy." .

bg:V043 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V042 ;
    bg:nextVerse bg:V044 ;
    bg:precedes bg:V044 ;
    bg:previousVerse bg:V042 ;
    bg:verseID "V043"^^xsd:string ;
    bg:verseNumber "2.4" ;
    bg:verseText "Arjuna said: O killer of enemies, O killer of Madhu, how can I counterattack with arrows in battle men like Bhīṣma and Droṇa, who are worthy of my worship?" .

bg:V044 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V043 ;
    bg:nextVerse bg:V045 ;
    bg:precedes bg:V045 ;
    bg:previousVerse bg:V043 ;
    bg:verseID "V044"^^xsd:string ;
    bg:verseNumber "2.5" ;
    bg:verseText "It would be better to live in this world by begging than to live at the cost of the lives of great souls who are my teachers. Even though desiring worldly gain, they are superiors. If they are killed, everything we enjoy will be tainted with blood." .

bg:V045 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V044 ;
    bg:nextVerse bg:V046 ;
    bg:precedes bg:V046 ;
    bg:previousVerse bg:V044 ;
    bg:verseID "V045"^^xsd:string ;
    bg:verseNumber "2.6" ;
    bg:verseText "Nor do we know which is better – conquering them or being conquered by them. If we killed the sons of Dhṛtarāṣṭra, we should not care to live. Yet they are now standing before us on the battlefield." .

bg:V046 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V045 ;
    bg:nextVerse bg:V047 ;
    bg:precedes bg:V047 ;
    bg:previousVerse bg:V045 ;
    bg:verseID "V046"^^xsd:string ;
    bg:verseNumber "2.7" ;
    bg:verseText "Now I am confused about my duty and have lost all composure because of miserly weakness. In this condition I am asking You to tell me for certain what is best for me. Now I am Your disciple, and a soul surrendered unto You. Please instruct me." .

bg:V047 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V046 ;
    bg:nextVerse bg:V048 ;
    bg:precedes bg:V048 ;
    bg:previousVerse bg:V046 ;
    bg:verseID "V047"^^xsd:string ;
    bg:verseNumber "2.8" ;
    bg:verseText "I can find no means to drive away this grief which is drying up my senses. I will not be able to dispel it even if I win a prosperous, unrivaled kingdom on earth with sovereignty like the demigods in heaven." .

bg:V048 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V047 ;
    bg:nextVerse bg:V049 ;
    bg:precedes bg:V049 ;
    bg:previousVerse bg:V047 ;
    bg:verseID "V048"^^xsd:string ;
    bg:verseNumber "2.9" ;
    bg:verseText "Sañjaya said: Having spoken thus, Arjuna, chastiser of enemies, told Kṛṣṇa, \"Govinda, I shall not fight,\" and fell silent." .

bg:V049 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V048 ;
    bg:nextVerse bg:V050 ;
    bg:precedes bg:V050 ;
    bg:previousVerse bg:V048 ;
    bg:verseID "V049"^^xsd:string ;
    bg:verseNumber "2.10" ;
    bg:verseText "O descendant of Bharata, at that time Kṛṣṇa, smiling, in the midst of both the armies, spoke the following words to the grief-stricken Arjuna." .

bg:V050 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V049 ;
    bg:nextVerse bg:V051 ;
    bg:precedes bg:V051 ;
    bg:previousVerse bg:V049 ;
    bg:verseID "V050"^^xsd:string ;
    bg:verseNumber "2.11" ;
    bg:verseText "The Supreme Personality of Godhead said: While speaking learned words, you are mourning for what is not worthy of grief. Those who are wise lament neither for the living nor for the dead." .

bg:V051 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V050 ;
    bg:nextVerse bg:V052 ;
    bg:precedes bg:V052 ;
    bg:previousVerse bg:V050 ;
    bg:verseID "V051"^^xsd:string ;
    bg:verseNumber "2.12" ;
    bg:verseText "Never was there a time when I did not exist, nor you, nor all these kings; nor in the future shall any of us cease to be." .

bg:V052 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V051 ;
    bg:nextVerse bg:V053 ;
    bg:precedes bg:V053 ;
    bg:previousVerse bg:V051 ;
    bg:verseID "V052"^^xsd:string ;
    bg:verseNumber "2.13" ;
    bg:verseText "As the embodied soul continuously passes, in this body, from boyhood to youth to old age, the soul similarly passes into another body at death. A sober person is not bewildered by such a change." .

bg:V053 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V052 ;
    bg:nextVerse bg:V054 ;
    bg:precedes bg:V054 ;
    bg:previousVerse bg:V052 ;
    bg:verseID "V053"^^xsd:string ;
    bg:verseNumber "2.14" ;
    bg:verseText "O son of Kuntī, the nonpermanent appearance of happiness and distress, and their disappearance in due course, are like the appearance and disappearance of winter and summer seasons. They arise from sense perception, O scion of Bharata, and one must learn to tolerate them without being disturbed." .

bg:V054 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V053 ;
    bg:nextVerse bg:V055 ;
    bg:precedes bg:V055 ;
    bg:previousVerse bg:V053 ;
    bg:verseID "V054"^^xsd:string ;
    bg:verseNumber "2.15" ;
    bg:verseText "O best among men [Arjuna], the person who is not disturbed by happiness and distress and is steady in both is certainly eligible for liberation." .

bg:V055 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V054 ;
    bg:nextVerse bg:V056 ;
    bg:precedes bg:V056 ;
    bg:previousVerse bg:V054 ;
    bg:verseID "V055"^^xsd:string ;
    bg:verseNumber "2.16" ;
    bg:verseText "Those who are seers of the truth have concluded that of the nonexistent [the material body] there is no endurance and of the eternal [the soul] there is no change. This they have concluded by studying the nature of both." .

bg:V056 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V055 ;
    bg:nextVerse bg:V057 ;
    bg:precedes bg:V057 ;
    bg:previousVerse bg:V055 ;
    bg:verseID "V056"^^xsd:string ;
    bg:verseNumber "2.17" ;
    bg:verseText "That which pervades the entire body you should know to be indestructible. No one is able to destroy that imperishable soul." .

bg:V057 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V056 ;
    bg:nextVerse bg:V058 ;
    bg:precedes bg:V058 ;
    bg:previousVerse bg:V056 ;
    bg:verseID "V057"^^xsd:string ;
    bg:verseNumber "2.18" ;
    bg:verseText "The material body of the indestructible, immeasurable and eternal living entity is sure to come to an end; therefore, fight, O descendant of Bharata." .

bg:V058 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V057 ;
    bg:nextVerse bg:V059 ;
    bg:precedes bg:V059 ;
    bg:previousVerse bg:V057 ;
    bg:verseID "V058"^^xsd:string ;
    bg:verseNumber "2.19" ;
    bg:verseText "Neither he who thinks the living entity the slayer nor he who thinks it slain is in knowledge, for the self slays not nor is slain." .

bg:V059 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V058 ;
    bg:nextVerse bg:V060 ;
    bg:precedes bg:V060 ;
    bg:previousVerse bg:V058 ;
    bg:verseID "V059"^^xsd:string ;
    bg:verseNumber "2.20" ;
    bg:verseText "For the soul there is neither birth nor death at any time. He has not come into being, does not come into being, and will not come into being. He is unborn, eternal, ever-existing and primeval. He is not slain when the body is slain." .

bg:V060 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V059 ;
    bg:nextVerse bg:V061 ;
    bg:precedes bg:V061 ;
    bg:previousVerse bg:V059 ;
    bg:verseID "V060"^^xsd:string ;
    bg:verseNumber "2.21" ;
    bg:verseText "O Pārtha, how can a person who knows that the soul is indestructible, eternal, unborn and immutable kill anyone or cause anyone to kill?" .

bg:V061 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V060 ;
    bg:nextVerse bg:V062 ;
    bg:precedes bg:V062 ;
    bg:previousVerse bg:V060 ;
    bg:verseID "V061"^^xsd:string ;
    bg:verseNumber "2.22" ;
    bg:verseText "As a person puts on new garments, giving up old ones, the soul similarly accepts new material bodies, giving up the old and useless ones." .

bg:V062 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V061 ;
    bg:nextVerse bg:V063 ;
    bg:precedes bg:V063 ;
    bg:previousVerse bg:V061 ;
    bg:verseID "V062"^^xsd:string ;
    bg:verseNumber "2.23" ;
    bg:verseText "The soul can never be cut to pieces by any weapon, nor burned by fire, nor moistened by water, nor withered by the wind." .

bg:V063 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V062 ;
    bg:nextVerse bg:V064 ;
    bg:precedes bg:V064 ;
    bg:previousVerse bg:V062 ;
    bg:verseID "V063"^^xsd:string ;
    bg:verseNumber "2.24" ;
    bg:verseText "This individual soul is unbreakable and insoluble, and can be neither burned nor dried. He is everlasting, present everywhere, unchangeable, immovable and eternally the same." .

bg:V064 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V063 ;
    bg:nextVerse bg:V065 ;
    bg:precedes bg:V065 ;
    bg:previousVerse bg:V063 ;
    bg:verseID "V064"^^xsd:string ;
    bg:verseNumber "2.25" ;
    bg:verseText "It is said that the soul is invisible, inconceivable and immutable. Knowing this, you should not grieve for the body." .

bg:V065 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V064 ;
    bg:nextVerse bg:V066 ;
    bg:precedes bg:V066 ;
    bg:previousVerse bg:V064 ;
    bg:verseID "V065"^^xsd:string ;
    bg:verseNumber "2.26" ;
    bg:verseText "If, however, you think that the soul [or the symptoms of life] will always be born and die forever, you still have no reason to lament, O mighty-armed." .

bg:V066 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V065 ;
    bg:nextVerse bg:V067 ;
    bg:precedes bg:V067 ;
    bg:previousVerse bg:V065 ;
    bg:verseID "V066"^^xsd:string ;
    bg:verseNumber "2.27" ;
    bg:verseText "One who has taken his birth is sure to die, and after death one is sure to take birth again. Therefore, in the unavoidable discharge of your duty, you should not lament." .

bg:V067 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V066 ;
    bg:nextVerse bg:V068 ;
    bg:precedes bg:V068 ;
    bg:previousVerse bg:V066 ;
    bg:verseID "V067"^^xsd:string ;
    bg:verseNumber "2.28" ;
    bg:verseText "All created beings are unmanifest in their beginning, manifest in their interim state, and unmanifest again when annihilated. So what need is there for lamentation?" .

bg:V068 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V067 ;
    bg:nextVerse bg:V069 ;
    bg:precedes bg:V069 ;
    bg:previousVerse bg:V067 ;
    bg:verseID "V068"^^xsd:string ;
    bg:verseNumber "2.29" ;
    bg:verseText "Some look on the soul as amazing, some describe him as amazing, and some hear of him as amazing, while others, even after hearing about him, cannot understand him at all." .

bg:V069 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V068 ;
    bg:nextVerse bg:V070 ;
    bg:precedes bg:V070 ;
    bg:previousVerse bg:V068 ;
    bg:verseID "V069"^^xsd:string ;
    bg:verseNumber "2.30" ;
    bg:verseText "O descendant of Bharata, he who dwells in the body can never be slain. Therefore you need not grieve for any living being." .

bg:V070 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V069 ;
    bg:nextVerse bg:V071 ;
    bg:precedes bg:V071 ;
    bg:previousVerse bg:V069 ;
    bg:verseID "V070"^^xsd:string ;
    bg:verseNumber "2.31" ;
    bg:verseText "Considering your specific duty as a kṣatriya, you should know that there is no better engagement for you than fighting on religious principles; and so there is no need for hesitation." .

bg:V071 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V070 ;
    bg:nextVerse bg:V072 ;
    bg:precedes bg:V072 ;
    bg:previousVerse bg:V070 ;
    bg:verseID "V071"^^xsd:string ;
    bg:verseNumber "2.32" ;
    bg:verseText "O Pārtha, happy are the kṣatriyas to whom such fighting opportunities come unsought, opening for them the doors of the heavenly planets." .

bg:V072 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V071 ;
    bg:nextVerse bg:V073 ;
    bg:precedes bg:V073 ;
    bg:previousVerse bg:V071 ;
    bg:verseID "V072"^^xsd:string ;
    bg:verseNumber "2.33" ;
    bg:verseText "If, however, you do not perform your religious duty of fighting, then you will certainly incur sins for neglecting your duties and thus lose your reputation as a fighter." .

bg:V073 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V072 ;
    bg:nextVerse bg:V074 ;
    bg:precedes bg:V074 ;
    bg:previousVerse bg:V072 ;
    bg:verseID "V073"^^xsd:string ;
    bg:verseNumber "2.34" ;
    bg:verseText "People will always speak of your infamy, and for a respectable person, dishonor is worse than death." .

bg:V074 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V073 ;
    bg:nextVerse bg:V075 ;
    bg:precedes bg:V075 ;
    bg:previousVerse bg:V073 ;
    bg:verseID "V074"^^xsd:string ;
    bg:verseNumber "2.35" ;
    bg:verseText "The great generals who have highly esteemed your name and fame will think that you have left the battlefield out of fear only, and thus they will consider you insignificant." .

bg:V075 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V074 ;
    bg:nextVerse bg:V076 ;
    bg:precedes bg:V076 ;
    bg:previousVerse bg:V074 ;
    bg:verseID "V075"^^xsd:string ;
    bg:verseNumber "2.36" ;
    bg:verseText "Your enemies will describe you in many unkind words and scorn your ability. What could be more painful for you?" .

bg:V076 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V075 ;
    bg:nextVerse bg:V077 ;
    bg:precedes bg:V077 ;
    bg:previousVerse bg:V075 ;
    bg:verseID "V076"^^xsd:string ;
    bg:verseNumber "2.37" ;
    bg:verseText "O son of Kuntī, either you will be killed on the battlefield and attain the heavenly planets, or you will conquer and enjoy the earthly kingdom. Therefore, get up with determination and fight." .

bg:V077 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V076 ;
    bg:nextVerse bg:V078 ;
    bg:precedes bg:V078 ;
    bg:previousVerse bg:V076 ;
    bg:verseID "V077"^^xsd:string ;
    bg:verseNumber "2.38" ;
    bg:verseText "Do thou fight for the sake of fighting, without considering happiness or distress, loss or gain, victory or defeat – and by so doing you shall never incur sin." .

bg:V078 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V077 ;
    bg:nextVerse bg:V079 ;
    bg:precedes bg:V079 ;
    bg:previousVerse bg:V077 ;
    bg:verseID "V078"^^xsd:string ;
    bg:verseNumber "2.39" ;
    bg:verseText "Thus far I have described this knowledge to you through analytical study. Now listen as I explain it in terms of working without fruitive results. O son of Pṛthā, when you act in such knowledge you can free yourself from the bondage of works." .

bg:V079 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V078 ;
    bg:nextVerse bg:V080 ;
    bg:precedes bg:V080 ;
    bg:previousVerse bg:V078 ;
    bg:verseID "V079"^^xsd:string ;
    bg:verseNumber "2.40" ;
    bg:verseText "In this endeavor there is no loss or diminution, and a little advancement on this path can protect one from the most dangerous type of fear." .

bg:V080 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V079 ;
    bg:nextVerse bg:V081 ;
    bg:precedes bg:V081 ;
    bg:previousVerse bg:V079 ;
    bg:verseID "V080"^^xsd:string ;
    bg:verseNumber "2.41" ;
    bg:verseText "Those who are on this path are resolute in purpose, and their aim is one. O beloved child of the Kurus, the intelligence of those who are irresolute is many-branched." .

bg:V081 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V080 ;
    bg:nextVerse bg:V082 ;
    bg:precedes bg:V082 ;
    bg:previousVerse bg:V080 ;
    bg:verseID "V081"^^xsd:string ;
    bg:verseNumber "2.42–43" ;
    bg:verseText "Men of small knowledge are very much attached to the flowery words of the Vedas, which recommend various fruitive activities for elevation to heavenly planets, resultant good birth, power, and so forth. Being desirous of sense gratification and opulent life, they say that there is nothing more than this." .

bg:V082 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V081 ;
    bg:nextVerse bg:V083 ;
    bg:precedes bg:V083 ;
    bg:previousVerse bg:V081 ;
    bg:verseID "V082"^^xsd:string ;
    bg:verseNumber "2.44" ;
    bg:verseText "In the minds of those who are too attached to sense enjoyment and material opulence, and who are bewildered by such things, the resolute determination for devotional service to the Supreme Lord does not take place." .

bg:V083 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V082 ;
    bg:nextVerse bg:V084 ;
    bg:precedes bg:V084 ;
    bg:previousVerse bg:V082 ;
    bg:verseID "V083"^^xsd:string ;
    bg:verseNumber "2.45" ;
    bg:verseText "The Vedas deal mainly with the subject of the three modes of material nature. O Arjuna, become transcendental to these three modes. Be free from all dualities and from all anxieties for gain and safety, and be established in the self." .

bg:V084 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V083 ;
    bg:nextVerse bg:V085 ;
    bg:precedes bg:V085 ;
    bg:previousVerse bg:V083 ;
    bg:verseID "V084"^^xsd:string ;
    bg:verseNumber "2.46" ;
    bg:verseText "All purposes served by a small well can at once be served by a great reservoir of water. Similarly, all the purposes of the Vedas can be served to one who knows the purpose behind them." .

bg:V085 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V084 ;
    bg:nextVerse bg:V086 ;
    bg:precedes bg:V086 ;
    bg:previousVerse bg:V084 ;
    bg:verseID "V085"^^xsd:string ;
    bg:verseNumber "2.47" ;
    bg:verseText "You have a right to perform your prescribed duty, but you are not entitled to the fruits of action. Never consider yourself the cause of the results of your activities, and never be attached to not doing your duty." .

bg:V086 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V085 ;
    bg:nextVerse bg:V087 ;
    bg:precedes bg:V087 ;
    bg:previousVerse bg:V085 ;
    bg:verseID "V086"^^xsd:string ;
    bg:verseNumber "2.48" ;
    bg:verseText "Perform your duty equipoised, O Arjuna, abandoning all attachment to success or failure. Such equanimity is called yoga." .

bg:V087 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V086 ;
    bg:nextVerse bg:V088 ;
    bg:precedes bg:V088 ;
    bg:previousVerse bg:V086 ;
    bg:verseID "V087"^^xsd:string ;
    bg:verseNumber "2.49" ;
    bg:verseText "O Dhanañjaya, keep all abominable activities far distant by devotional service, and in that consciousness surrender unto the Lord. Those who want to enjoy the fruits of their work are misers." .

bg:V088 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V087 ;
    bg:nextVerse bg:V089 ;
    bg:precedes bg:V089 ;
    bg:previousVerse bg:V087 ;
    bg:verseID "V088"^^xsd:string ;
    bg:verseNumber "2.50" ;
    bg:verseText "A man engaged in devotional service rids himself of both good and bad reactions even in this life. Therefore strive for yoga, which is the art of all work." .

bg:V089 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V088 ;
    bg:nextVerse bg:V090 ;
    bg:precedes bg:V090 ;
    bg:previousVerse bg:V088 ;
    bg:verseID "V089"^^xsd:string ;
    bg:verseNumber "2.51" ;
    bg:verseText "By thus engaging in devotional service to the Lord, great sages or devotees free themselves from the results of work in the material world. In this way they become free from the cycle of birth and death and attain the state beyond all miseries [by going back to Godhead]." .

bg:V090 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V089 ;
    bg:nextVerse bg:V091 ;
    bg:precedes bg:V091 ;
    bg:previousVerse bg:V089 ;
    bg:verseID "V090"^^xsd:string ;
    bg:verseNumber "2.52" ;
    bg:verseText "When your intelligence has passed out of the dense forest of delusion, you shall become indifferent to all that has been heard and all that is to be heard." .

bg:V091 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V090 ;
    bg:nextVerse bg:V092 ;
    bg:precedes bg:V092 ;
    bg:previousVerse bg:V090 ;
    bg:verseID "V091"^^xsd:string ;
    bg:verseNumber "2.53" ;
    bg:verseText "When your mind is no longer disturbed by the flowery language of the Vedas, and when it remains fixed in the trance of self-realization, then you will have attained the divine consciousness." .

bg:V092 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V091 ;
    bg:nextVerse bg:V093 ;
    bg:precedes bg:V093 ;
    bg:previousVerse bg:V091 ;
    bg:verseID "V092"^^xsd:string ;
    bg:verseNumber "2.54" ;
    bg:verseText "Arjuna said: O Kṛṣṇa, what are the symptoms of one whose consciousness is thus merged in transcendence? How does he speak, and what is his language? How does he sit, and how does he walk?" .

bg:V093 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V092 ;
    bg:nextVerse bg:V094 ;
    bg:precedes bg:V094 ;
    bg:previousVerse bg:V092 ;
    bg:verseID "V093"^^xsd:string ;
    bg:verseNumber "2.55" ;
    bg:verseText "The Supreme Personality of Godhead said: O Pārtha, when a man gives up all varieties of desire for sense gratification, which arise from mental concoction, and when his mind, thus purified, finds satisfaction in the self alone, then he is said to be in pure transcendental consciousness." .

bg:V094 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V093 ;
    bg:nextVerse bg:V095 ;
    bg:precedes bg:V095 ;
    bg:previousVerse bg:V093 ;
    bg:verseID "V094"^^xsd:string ;
    bg:verseNumber "2.56" ;
    bg:verseText "One who is not disturbed in mind even amidst the threefold miseries or elated when there is happiness, and who is free from attachment, fear and anger, is called a sage of steady mind." .

bg:V095 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V094 ;
    bg:nextVerse bg:V096 ;
    bg:precedes bg:V096 ;
    bg:previousVerse bg:V094 ;
    bg:verseID "V095"^^xsd:string ;
    bg:verseNumber "2.57" ;
    bg:verseText "In the material world, one who is unaffected by whatever good or evil he may obtain, neither praising it nor despising it, is firmly fixed in perfect knowledge." .

bg:V096 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V095 ;
    bg:nextVerse bg:V097 ;
    bg:precedes bg:V097 ;
    bg:previousVerse bg:V095 ;
    bg:verseID "V096"^^xsd:string ;
    bg:verseNumber "2.58" ;
    bg:verseText "One who is able to withdraw his senses from sense objects, as the tortoise draws its limbs within the shell, is firmly fixed in perfect consciousness." .

bg:V097 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V096 ;
    bg:nextVerse bg:V098 ;
    bg:precedes bg:V098 ;
    bg:previousVerse bg:V096 ;
    bg:verseID "V097"^^xsd:string ;
    bg:verseNumber "2.59" ;
    bg:verseText "Though the embodied soul may be restricted from sense enjoyment, the taste for sense objects remains. But, ceasing such engagements by experiencing a higher taste, he is fixed in consciousness." .

bg:V098 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V097 ;
    bg:nextVerse bg:V099 ;
    bg:precedes bg:V099 ;
    bg:previousVerse bg:V097 ;
    bg:verseID "V098"^^xsd:string ;
    bg:verseNumber "2.60" ;
    bg:verseText "The senses are so strong and impetuous, O Arjuna, that they forcibly carry away the mind even of a man of discrimination who is endeavoring to control them." .

bg:V099 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V098 ;
    bg:nextVerse bg:V100 ;
    bg:precedes bg:V100 ;
    bg:previousVerse bg:V098 ;
    bg:verseID "V099"^^xsd:string ;
    bg:verseNumber "2.61" ;
    bg:verseText "One who restrains his senses, keeping them under full control, and fixes his consciousness upon Me, is known as a man of steady intelligence." .

bg:V100 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V099 ;
    bg:nextVerse bg:V101 ;
    bg:precedes bg:V101 ;
    bg:previousVerse bg:V099 ;
    bg:verseID "V100"^^xsd:string ;
    bg:verseNumber "2.62" ;
    bg:verseText "While contemplating the objects of the senses, a person develops attachment for them, and from such attachment lust develops, and from lust anger arises." .

bg:V101 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V100 ;
    bg:nextVerse bg:V102 ;
    bg:precedes bg:V102 ;
    bg:previousVerse bg:V100 ;
    bg:verseID "V101"^^xsd:string ;
    bg:verseNumber "2.63" ;
    bg:verseText "From anger, complete delusion arises, and from delusion bewilderment of memory. When memory is bewildered, intelligence is lost, and when intelligence is lost one falls down again into the material pool." .

bg:V102 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V101 ;
    bg:nextVerse bg:V103 ;
    bg:precedes bg:V103 ;
    bg:previousVerse bg:V101 ;
    bg:verseID "V102"^^xsd:string ;
    bg:verseNumber "2.64" ;
    bg:verseText "But a person free from all attachment and aversion and able to control his senses through regulative principles of freedom can obtain the complete mercy of the Lord." .

bg:V103 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V102 ;
    bg:nextVerse bg:V104 ;
    bg:precedes bg:V104 ;
    bg:previousVerse bg:V102 ;
    bg:verseID "V103"^^xsd:string ;
    bg:verseNumber "2.65" ;
    bg:verseText "For one thus satisfied [in Kṛṣṇa consciousness], the threefold miseries of material existence exist no longer; in such satisfied consciousness, one’s intelligence is soon well established." .

bg:V104 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V103 ;
    bg:nextVerse bg:V105 ;
    bg:precedes bg:V105 ;
    bg:previousVerse bg:V103 ;
    bg:verseID "V104"^^xsd:string ;
    bg:verseNumber "2.66" ;
    bg:verseText "One who is not connected with the Supreme [in Kṛṣṇa consciousness] can have neither transcendental intelligence nor a steady mind, without which there is no possibility of peace. And how can there be any happiness without peace?" .

bg:V105 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V104 ;
    bg:nextVerse bg:V106 ;
    bg:precedes bg:V106 ;
    bg:previousVerse bg:V104 ;
    bg:verseID "V105"^^xsd:string ;
    bg:verseNumber "2.67" ;
    bg:verseText "As a strong wind sweeps away a boat on the water, even one of the roaming senses on which the mind focuses can carry away a man’s intelligence." .

bg:V106 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V105 ;
    bg:nextVerse bg:V107 ;
    bg:precedes bg:V107 ;
    bg:previousVerse bg:V105 ;
    bg:verseID "V106"^^xsd:string ;
    bg:verseNumber "2.68" ;
    bg:verseText "Therefore, O mighty-armed, one whose senses are restrained from their objects is certainly of steady intelligence." .

bg:V107 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V106 ;
    bg:nextVerse bg:V108 ;
    bg:precedes bg:V108 ;
    bg:previousVerse bg:V106 ;
    bg:verseID "V107"^^xsd:string ;
    bg:verseNumber "2.69" ;
    bg:verseText "What is night for all beings is the time of awakening for the self-controlled; and the time of awakening for all beings is night for the introspective sage." .

bg:V108 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V107 ;
    bg:nextVerse bg:V109 ;
    bg:precedes bg:V109 ;
    bg:previousVerse bg:V107 ;
    bg:verseID "V108"^^xsd:string ;
    bg:verseNumber "2.70" ;
    bg:verseText "A person who is not disturbed by the incessant flow of desires—that enter like rivers into the ocean, which is ever being filled but is always still—can alone achieve peace, and not the man who strives to satisfy such desires." .

bg:V109 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V108 ;
    bg:nextVerse bg:V110 ;
    bg:precedes bg:V110 ;
    bg:previousVerse bg:V108 ;
    bg:verseID "V109"^^xsd:string ;
    bg:verseNumber "2.71" ;
    bg:verseText "A person who has given up all desires for sense gratification, who lives free from desires, who has given up all sense of proprietorship and is devoid of false ego—he alone can attain real peace." .

bg:V110 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH02 ;
    bg:follows bg:V109 ;
    bg:nextVerse bg:V111 ;
    bg:precedes bg:V111 ;
    bg:previousVerse bg:V109 ;
    bg:verseID "V110"^^xsd:string ;
    bg:verseNumber "2.72" ;
    bg:verseText "That is the way of the spiritual and godly life, after attaining which a man is not bewildered. If one is thus situated even at the hour of death, one can enter into the kingdom of God." .

bg:V111 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V110 ;
    bg:nextVerse bg:V112 ;
    bg:precedes bg:V112 ;
    bg:previousVerse bg:V110 ;
    bg:verseID "V111"^^xsd:string ;
    bg:verseNumber "3.1" ;
    bg:verseText "Arjuna said: O Janārdana, O Keśava, why do You want to engage me in this ghastly warfare, if You think that intelligence is better than fruitive work?" .

bg:V112 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V111 ;
    bg:nextVerse bg:V113 ;
    bg:precedes bg:V113 ;
    bg:previousVerse bg:V111 ;
    bg:verseID "V112"^^xsd:string ;
    bg:verseNumber "3.2" ;
    bg:verseText "My intelligence is bewildered by Your equivocal instructions. Therefore, please tell me decisively which will be most beneficial for me." .

bg:V113 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V112 ;
    bg:nextVerse bg:V114 ;
    bg:precedes bg:V114 ;
    bg:previousVerse bg:V112 ;
    bg:verseID "V113"^^xsd:string ;
    bg:verseNumber "3.3" ;
    bg:verseText "The Supreme Personality of Godhead said: O sinless Arjuna, I have already explained that there are two classes of men who try to realize the self. Some are inclined to understand it by empirical, philosophical speculation, and others by devotional service." .

bg:V114 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V113 ;
    bg:nextVerse bg:V115 ;
    bg:precedes bg:V115 ;
    bg:previousVerse bg:V113 ;
    bg:verseID "V114"^^xsd:string ;
    bg:verseNumber "3.4" ;
    bg:verseText "Not by merely abstaining from work can one achieve freedom from reaction, nor by renunciation alone can one attain perfection." .

bg:V115 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V114 ;
    bg:nextVerse bg:V116 ;
    bg:precedes bg:V116 ;
    bg:previousVerse bg:V114 ;
    bg:verseID "V115"^^xsd:string ;
    bg:verseNumber "3.5" ;
    bg:verseText "Everyone is forced to act helplessly according to the qualities he has acquired from the modes of material nature; therefore no one can refrain from doing something, not even for a moment." .

bg:V116 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V115 ;
    bg:nextVerse bg:V117 ;
    bg:precedes bg:V117 ;
    bg:previousVerse bg:V115 ;
    bg:verseID "V116"^^xsd:string ;
    bg:verseNumber "3.6" ;
    bg:verseText "One who restrains the senses of action but whose mind dwells on sense objects certainly deludes himself and is called a pretender." .

bg:V117 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V116 ;
    bg:nextVerse bg:V118 ;
    bg:precedes bg:V118 ;
    bg:previousVerse bg:V116 ;
    bg:verseID "V117"^^xsd:string ;
    bg:verseNumber "3.7" ;
    bg:verseText "On the other hand, if a sincere person tries to control the active senses by the mind and begins karma-yoga [in Kṛṣṇa consciousness] without attachment, he is by far superior." .

bg:V118 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V117 ;
    bg:nextVerse bg:V119 ;
    bg:precedes bg:V119 ;
    bg:previousVerse bg:V117 ;
    bg:verseID "V118"^^xsd:string ;
    bg:verseNumber "3.8" ;
    bg:verseText "Perform your prescribed duty, for doing so is better than not working. One cannot even maintain one’s physical body without work." .

bg:V119 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V118 ;
    bg:nextVerse bg:V120 ;
    bg:precedes bg:V120 ;
    bg:previousVerse bg:V118 ;
    bg:verseID "V119"^^xsd:string ;
    bg:verseNumber "3.9" ;
    bg:verseText "Work done as a sacrifice for Viṣṇu has to be performed; otherwise work causes bondage in this material world. Therefore, O son of Kuntī, perform your prescribed duties for His satisfaction, and in that way you will always remain free from bondage." .

bg:V120 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V119 ;
    bg:nextVerse bg:V121 ;
    bg:precedes bg:V121 ;
    bg:previousVerse bg:V119 ;
    bg:verseID "V120"^^xsd:string ;
    bg:verseNumber "3.10" ;
    bg:verseText "In the beginning of creation, the Lord of all creatures sent forth generations of men and demigods, along with sacrifices for Viṣṇu, and blessed them by saying, \"Be thou happy by this yajña [sacrifice] because its performance will bestow upon you everything desirable for living happily and achieving liberation.\"" .

bg:V121 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V120 ;
    bg:nextVerse bg:V122 ;
    bg:precedes bg:V122 ;
    bg:previousVerse bg:V120 ;
    bg:verseID "V121"^^xsd:string ;
    bg:verseNumber "3.11" ;
    bg:verseText "The demigods, being pleased by sacrifices, will also please you, and thus, by cooperation between men and demigods, prosperity will reign for all." .

bg:V122 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V121 ;
    bg:nextVerse bg:V123 ;
    bg:precedes bg:V123 ;
    bg:previousVerse bg:V121 ;
    bg:verseID "V122"^^xsd:string ;
    bg:verseNumber "3.12" ;
    bg:verseText "In charge of the various necessities of life, the demigods, being satisfied by the performance of yajña [sacrifice], will supply all necessities to you. But he who enjoys such gifts without offering them to the demigods in return is certainly a thief." .

bg:V123 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V122 ;
    bg:nextVerse bg:V124 ;
    bg:precedes bg:V124 ;
    bg:previousVerse bg:V122 ;
    bg:verseID "V123"^^xsd:string ;
    bg:verseNumber "3.13" ;
    bg:verseText "The devotees of the Lord are released from all kinds of sins because they eat food which is offered first for sacrifice. Others, who prepare food for personal sense enjoyment, verily eat only sin." .

bg:V124 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V123 ;
    bg:nextVerse bg:V125 ;
    bg:precedes bg:V125 ;
    bg:previousVerse bg:V123 ;
    bg:verseID "V124"^^xsd:string ;
    bg:verseNumber "3.14" ;
    bg:verseText "All living bodies subsist on food grains, which are produced from rains. Rains are produced by performance of yajña [sacrifice], and yajña is born of prescribed duties." .

bg:V125 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V124 ;
    bg:nextVerse bg:V126 ;
    bg:precedes bg:V126 ;
    bg:previousVerse bg:V124 ;
    bg:verseID "V125"^^xsd:string ;
    bg:verseNumber "3.15" ;
    bg:verseText "Regulated activities are prescribed in the Vedas, and the Vedas are directly manifested from the Supreme Personality of Godhead. Consequently the all-pervading Transcendence is eternally situated in acts of sacrifice." .

bg:V126 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V125 ;
    bg:nextVerse bg:V127 ;
    bg:precedes bg:V127 ;
    bg:previousVerse bg:V125 ;
    bg:verseID "V126"^^xsd:string ;
    bg:verseNumber "3.16" ;
    bg:verseText "My dear Arjuna, one who does not follow in human life the cycle of sacrifice thus established by the Vedas certainly leads a life full of sin. Living only for the satisfaction of the senses, such a person lives in vain." .

bg:V127 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V126 ;
    bg:nextVerse bg:V128 ;
    bg:precedes bg:V128 ;
    bg:previousVerse bg:V126 ;
    bg:verseID "V127"^^xsd:string ;
    bg:verseNumber "3.17" ;
    bg:verseText "But for one who takes pleasure in the Self, whose human life is one of self-realization, and who is satisfied in the Self only, fully satiated—for him there is no duty." .

bg:V128 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V127 ;
    bg:nextVerse bg:V129 ;
    bg:precedes bg:V129 ;
    bg:previousVerse bg:V127 ;
    bg:verseID "V128"^^xsd:string ;
    bg:verseNumber "3.18" ;
    bg:verseText "A self-realized man has no purpose to fulfill in the discharge of his prescribed duties, nor has he any reason not to perform such work. Nor has he any need to depend on any other living being." .

bg:V129 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V128 ;
    bg:nextVerse bg:V130 ;
    bg:precedes bg:V130 ;
    bg:previousVerse bg:V128 ;
    bg:verseID "V129"^^xsd:string ;
    bg:verseNumber "3.19" ;
    bg:verseText "Therefore, without being attached to the fruits of activities, one should act as a matter of duty, for by working without attachment one attains the Supreme." .

bg:V130 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V129 ;
    bg:nextVerse bg:V131 ;
    bg:precedes bg:V131 ;
    bg:previousVerse bg:V129 ;
    bg:verseID "V130"^^xsd:string ;
    bg:verseNumber "3.20" ;
    bg:verseText "Kings such as Janaka attained perfection solely by performance of prescribed duties. Therefore, just for the sake of educating the people in general, you should perform your work." .

bg:V131 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V130 ;
    bg:nextVerse bg:V132 ;
    bg:precedes bg:V132 ;
    bg:previousVerse bg:V130 ;
    bg:verseID "V131"^^xsd:string ;
    bg:verseNumber "3.21" ;
    bg:verseText "Whatever action a great man performs, common men follow. And whatever standards he sets by exemplary acts, all the world pursues." .

bg:V132 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V131 ;
    bg:nextVerse bg:V133 ;
    bg:precedes bg:V133 ;
    bg:previousVerse bg:V131 ;
    bg:verseID "V132"^^xsd:string ;
    bg:verseNumber "3.22" ;
    bg:verseText "O son of Pṛthā, there is no work prescribed for Me within all the three planetary systems. Nor am I in want of anything, nor have I a need to obtain anything—and yet I am engaged in prescribed duties." .

bg:V133 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V132 ;
    bg:nextVerse bg:V134 ;
    bg:precedes bg:V134 ;
    bg:previousVerse bg:V132 ;
    bg:verseID "V133"^^xsd:string ;
    bg:verseNumber "3.23" ;
    bg:verseText "For if I ever failed to engage in carefully performing prescribed duties, O Pārtha, certainly all men would follow My path." .

bg:V134 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V133 ;
    bg:nextVerse bg:V135 ;
    bg:precedes bg:V135 ;
    bg:previousVerse bg:V133 ;
    bg:verseID "V134"^^xsd:string ;
    bg:verseNumber "3.24" ;
    bg:verseText "If I did not perform prescribed duties, all these worlds would be put to ruination. I would be the cause of creating unwanted population, and I would thereby destroy the peace of all living beings." .

bg:V135 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V134 ;
    bg:nextVerse bg:V136 ;
    bg:precedes bg:V136 ;
    bg:previousVerse bg:V134 ;
    bg:verseID "V135"^^xsd:string ;
    bg:verseNumber "3.25" ;
    bg:verseText "As the ignorant perform their duties with attachment to results, the learned may similarly act, but without attachment, for the sake of leading people on the right path." .

bg:V136 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V135 ;
    bg:nextVerse bg:V137 ;
    bg:precedes bg:V137 ;
    bg:previousVerse bg:V135 ;
    bg:verseID "V136"^^xsd:string ;
    bg:verseNumber "3.26" ;
    bg:verseText "So as not to disrupt the minds of ignorant men attached to the fruitive results of prescribed duties, a learned person should not induce them to stop work. Rather, by working in the spirit of devotion, he should engage them in all sorts of activities [for the gradual development of Kṛṣṇa consciousness]." .

bg:V137 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V136 ;
    bg:nextVerse bg:V138 ;
    bg:precedes bg:V138 ;
    bg:previousVerse bg:V136 ;
    bg:verseID "V137"^^xsd:string ;
    bg:verseNumber "3.27" ;
    bg:verseText "The spirit soul bewildered by the influence of false ego thinks himself the doer of activities that are in actuality carried out by the three modes of material nature." .

bg:V138 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V137 ;
    bg:nextVerse bg:V139 ;
    bg:precedes bg:V139 ;
    bg:previousVerse bg:V137 ;
    bg:verseID "V138"^^xsd:string ;
    bg:verseNumber "3.28" ;
    bg:verseText "One who is in knowledge of the Absolute Truth, O mighty-armed, does not engage himself in the senses and sense gratification, knowing well the differences between work in devotion and work for fruitive results." .

bg:V139 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V138 ;
    bg:nextVerse bg:V140 ;
    bg:precedes bg:V140 ;
    bg:previousVerse bg:V138 ;
    bg:verseID "V139"^^xsd:string ;
    bg:verseNumber "3.29" ;
    bg:verseText "Bewildered by the modes of material nature, the ignorant fully engage themselves in material activities and become attached. But the wise should not unsettle them, although these duties are inferior due to the performers’ lack of knowledge." .

bg:V140 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V139 ;
    bg:nextVerse bg:V141 ;
    bg:precedes bg:V141 ;
    bg:previousVerse bg:V139 ;
    bg:verseID "V140"^^xsd:string ;
    bg:verseNumber "3.30" ;
    bg:verseText "Therefore, O Arjuna, surrendering all your works unto Me, with full knowledge of Me, without desires for profit, with no claims to proprietorship, and free from lethargy, fight." .

bg:V141 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V140 ;
    bg:nextVerse bg:V142 ;
    bg:precedes bg:V142 ;
    bg:previousVerse bg:V140 ;
    bg:verseID "V141"^^xsd:string ;
    bg:verseNumber "3.31" ;
    bg:verseText "Those persons who execute their duties according to My injunctions and who follow this teaching faithfully, without envy, become free from the bondage of fruitive actions." .

bg:V142 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V141 ;
    bg:nextVerse bg:V143 ;
    bg:precedes bg:V143 ;
    bg:previousVerse bg:V141 ;
    bg:verseID "V142"^^xsd:string ;
    bg:verseNumber "3.32" ;
    bg:verseText "But those who, out of envy, disregard these teachings and do not follow them regularly are to be considered bereft of all knowledge, befooled, and ruined in their endeavors for perfection." .

bg:V143 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V142 ;
    bg:nextVerse bg:V144 ;
    bg:precedes bg:V144 ;
    bg:previousVerse bg:V142 ;
    bg:verseID "V143"^^xsd:string ;
    bg:verseNumber "3.33" ;
    bg:verseText "Even a man of knowledge acts according to his own nature, for everyone follows the nature he has acquired from the three modes. What can repression accomplish?" .

bg:V144 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V143 ;
    bg:nextVerse bg:V145 ;
    bg:precedes bg:V145 ;
    bg:previousVerse bg:V143 ;
    bg:verseID "V144"^^xsd:string ;
    bg:verseNumber "3.34" ;
    bg:verseText "There are principles to regulate attachment and aversion pertaining to the senses and their objects. One should not come under the control of such attachment and aversion, because they are stumbling blocks on the path of self-realization." .

bg:V145 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V144 ;
    bg:nextVerse bg:V146 ;
    bg:precedes bg:V146 ;
    bg:previousVerse bg:V144 ;
    bg:verseID "V145"^^xsd:string ;
    bg:verseNumber "3.35" ;
    bg:verseText "It is far better to discharge one’s prescribed duties, even though faultily, than another’s duties perfectly. Destruction in the course of performing one’s own duty is better than engaging in another’s duties, for to follow another’s path is dangerous." .

bg:V146 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V145 ;
    bg:nextVerse bg:V147 ;
    bg:precedes bg:V147 ;
    bg:previousVerse bg:V145 ;
    bg:verseID "V146"^^xsd:string ;
    bg:verseNumber "3.36" ;
    bg:verseText "Arjuna said: O descendant of Vṛṣṇi, by what is one impelled to sinful acts, even unwillingly, as if engaged by force?" .

bg:V147 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V146 ;
    bg:nextVerse bg:V148 ;
    bg:precedes bg:V148 ;
    bg:previousVerse bg:V146 ;
    bg:verseID "V147"^^xsd:string ;
    bg:verseNumber "3.37" ;
    bg:verseText "The Supreme Personality of Godhead said: It is lust only, Arjuna, which is born of contact with the material mode of passion and later transformed into wrath, and which is the all-devouring sinful enemy of this world." .

bg:V148 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V147 ;
    bg:nextVerse bg:V149 ;
    bg:precedes bg:V149 ;
    bg:previousVerse bg:V147 ;
    bg:verseID "V148"^^xsd:string ;
    bg:verseNumber "3.38" ;
    bg:verseText "As fire is covered by smoke, as a mirror is covered by dust, or as the embryo is covered by the womb, the living entity is similarly covered by different degrees of this lust." .

bg:V149 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V148 ;
    bg:nextVerse bg:V150 ;
    bg:precedes bg:V150 ;
    bg:previousVerse bg:V148 ;
    bg:verseID "V149"^^xsd:string ;
    bg:verseNumber "3.39" ;
    bg:verseText "Thus the wise living entity’s pure consciousness becomes covered by his eternal enemy in the form of lust, which is never satisfied and which burns like fire." .

bg:V150 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V149 ;
    bg:nextVerse bg:V151 ;
    bg:precedes bg:V151 ;
    bg:previousVerse bg:V149 ;
    bg:verseID "V150"^^xsd:string ;
    bg:verseNumber "3.40" ;
    bg:verseText "The senses, the mind and the intelligence are the sitting places of this lust. Through them lust covers the real knowledge of the living entity and bewilders him." .

bg:V151 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V150 ;
    bg:nextVerse bg:V152 ;
    bg:precedes bg:V152 ;
    bg:previousVerse bg:V150 ;
    bg:verseID "V151"^^xsd:string ;
    bg:verseNumber "3.41" ;
    bg:verseText "Therefore, O Arjuna, best of the Bhāratas, in the very beginning curb this great symbol of sin [lust] by regulating the senses, and slay this destroyer of knowledge and self-realization." .

bg:V152 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V151 ;
    bg:nextVerse bg:V153 ;
    bg:precedes bg:V153 ;
    bg:previousVerse bg:V151 ;
    bg:verseID "V152"^^xsd:string ;
    bg:verseNumber "3.42" ;
    bg:verseText "The working senses are superior to dull matter; mind is higher than the senses; intelligence is still higher than the mind; and he [the soul] is even higher than the intelligence." .

bg:V153 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH03 ;
    bg:follows bg:V152 ;
    bg:nextVerse bg:V154 ;
    bg:precedes bg:V154 ;
    bg:previousVerse bg:V152 ;
    bg:verseID "V153"^^xsd:string ;
    bg:verseNumber "3.43" ;
    bg:verseText "Thus knowing oneself to be transcendental to the material senses, mind and intelligence, O mighty-armed Arjuna, one should steady the mind by deliberate spiritual intelligence [Kṛṣṇa consciousness] and thus—by spiritual strength—conquer this insatiable enemy known as lust." .

bg:V154 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V153 ;
    bg:nextVerse bg:V155 ;
    bg:precedes bg:V155 ;
    bg:previousVerse bg:V153 ;
    bg:verseID "V154"^^xsd:string ;
    bg:verseNumber "4.1" ;
    bg:verseText "The Personality of Godhead, Lord Śrī Kṛṣṇa, said: I instructed this imperishable science of yoga to the sun-god, Vivasvān, and Vivasvān instructed it to Manu, the father of mankind, and Manu in turn instructed it to Ikṣvāku." .

bg:V155 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V154 ;
    bg:nextVerse bg:V156 ;
    bg:precedes bg:V156 ;
    bg:previousVerse bg:V154 ;
    bg:verseID "V155"^^xsd:string ;
    bg:verseNumber "4.2" ;
    bg:verseText "This supreme science was thus received through the chain of disciplic succession, and the saintly kings understood it in that way. But in course of time the succession was broken, and therefore the science as it is appears to be lost." .

bg:V156 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V155 ;
    bg:nextVerse bg:V157 ;
    bg:precedes bg:V157 ;
    bg:previousVerse bg:V155 ;
    bg:verseID "V156"^^xsd:string ;
    bg:verseNumber "4.3" ;
    bg:verseText "That very ancient science of the relationship with the Supreme is today told by Me to you because you are My devotee as well as My friend and can therefore understand the transcendental mystery of this science." .

bg:V157 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V156 ;
    bg:nextVerse bg:V158 ;
    bg:precedes bg:V158 ;
    bg:previousVerse bg:V156 ;
    bg:verseID "V157"^^xsd:string ;
    bg:verseNumber "4.4" ;
    bg:verseText "Arjuna said: The sun-god Vivasvān is senior by birth to You. How am I to understand that in the beginning You instructed this science to him?" .

bg:V158 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V157 ;
    bg:nextVerse bg:V159 ;
    bg:precedes bg:V159 ;
    bg:previousVerse bg:V157 ;
    bg:verseID "V158"^^xsd:string ;
    bg:verseNumber "4.5" ;
    bg:verseText "The Personality of Godhead said: Many, many births both you and I have passed. I can remember all of them, but you cannot, O subduer of the enemy!" .

bg:V159 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V158 ;
    bg:nextVerse bg:V160 ;
    bg:precedes bg:V160 ;
    bg:previousVerse bg:V158 ;
    bg:verseID "V159"^^xsd:string ;
    bg:verseNumber "4.6" ;
    bg:verseText "Although I am unborn and My transcendental body never deteriorates, and although I am the Lord of all living entities, I still appear in every millennium in My original transcendental form." .

bg:V160 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V159 ;
    bg:nextVerse bg:V161 ;
    bg:precedes bg:V161 ;
    bg:previousVerse bg:V159 ;
    bg:verseID "V160"^^xsd:string ;
    bg:verseNumber "4.7" ;
    bg:verseText "Whenever and wherever there is a decline in religious practice, O descendant of Bharata, and a predominant rise of irreligion—at that time I descend Myself." .

bg:V161 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V160 ;
    bg:nextVerse bg:V162 ;
    bg:precedes bg:V162 ;
    bg:previousVerse bg:V160 ;
    bg:verseID "V161"^^xsd:string ;
    bg:verseNumber "4.8" ;
    bg:verseText "To deliver the pious and to annihilate the miscreants, as well as to reestablish the principles of religion, I Myself appear, millennium after millennium." .

bg:V162 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V161 ;
    bg:nextVerse bg:V163 ;
    bg:precedes bg:V163 ;
    bg:previousVerse bg:V161 ;
    bg:verseID "V162"^^xsd:string ;
    bg:verseNumber "4.9" ;
    bg:verseText "One who knows the transcendental nature of My appearance and activities does not, upon leaving the body, take his birth again in this material world, but attains My eternal abode, O Arjuna." .

bg:V163 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V162 ;
    bg:nextVerse bg:V164 ;
    bg:precedes bg:V164 ;
    bg:previousVerse bg:V162 ;
    bg:verseID "V163"^^xsd:string ;
    bg:verseNumber "4.10" ;
    bg:verseText "Being freed from attachment, fear and anger, being fully absorbed in Me and taking refuge in Me, many, many persons in the past became purified by knowledge of Me—and thus they all attained transcendental love for Me." .

bg:V164 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V163 ;
    bg:nextVerse bg:V165 ;
    bg:precedes bg:V165 ;
    bg:previousVerse bg:V163 ;
    bg:verseID "V164"^^xsd:string ;
    bg:verseNumber "4.11" ;
    bg:verseText "As all surrender unto Me, I reward them accordingly. Everyone follows My path in all respects, O son of Pṛthā." .

bg:V165 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V164 ;
    bg:nextVerse bg:V166 ;
    bg:precedes bg:V166 ;
    bg:previousVerse bg:V164 ;
    bg:verseID "V165"^^xsd:string ;
    bg:verseNumber "4.12" ;
    bg:verseText "Men in this world desire success in fruitive activities, and therefore they worship the demigods. Quickly, of course, men get results from fruitive work in this world." .

bg:V166 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V165 ;
    bg:nextVerse bg:V167 ;
    bg:precedes bg:V167 ;
    bg:previousVerse bg:V165 ;
    bg:verseID "V166"^^xsd:string ;
    bg:verseNumber "4.13" ;
    bg:verseText "According to the three modes of material nature and the work associated with them, the four divisions of human society are created by Me. And although I am the creator of this system, you should know that I am yet the nondoer, being unchangeable." .

bg:V167 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V166 ;
    bg:nextVerse bg:V168 ;
    bg:precedes bg:V168 ;
    bg:previousVerse bg:V166 ;
    bg:verseID "V167"^^xsd:string ;
    bg:verseNumber "4.14" ;
    bg:verseText "There is no work that affects Me; nor do I aspire for the fruits of action. One who understands this truth about Me also does not become entangled in the fruitive reactions of work." .

bg:V168 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V167 ;
    bg:nextVerse bg:V169 ;
    bg:precedes bg:V169 ;
    bg:previousVerse bg:V167 ;
    bg:verseID "V168"^^xsd:string ;
    bg:verseNumber "4.15" ;
    bg:verseText "All the liberated souls in ancient times acted with this understanding of My transcendental nature. Therefore you should perform your duty, following in their footsteps." .

bg:V169 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V168 ;
    bg:nextVerse bg:V170 ;
    bg:precedes bg:V170 ;
    bg:previousVerse bg:V168 ;
    bg:verseID "V169"^^xsd:string ;
    bg:verseNumber "4.16" ;
    bg:verseText "Even the intelligent are bewildered in determining what is action and what is inaction. Now I shall explain to you what action is, knowing which you shall be liberated from all misfortune." .

bg:V170 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V169 ;
    bg:nextVerse bg:V171 ;
    bg:precedes bg:V171 ;
    bg:previousVerse bg:V169 ;
    bg:verseID "V170"^^xsd:string ;
    bg:verseNumber "4.17" ;
    bg:verseText "The intricacies of action are very hard to understand. Therefore one should know properly what action is, what forbidden action is and what inaction is." .

bg:V171 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V170 ;
    bg:nextVerse bg:V172 ;
    bg:precedes bg:V172 ;
    bg:previousVerse bg:V170 ;
    bg:verseID "V171"^^xsd:string ;
    bg:verseNumber "4.18" ;
    bg:verseText "One who sees inaction in action and action in inaction is intelligent among men, and he is in the transcendental position, although engaged in all sorts of activities." .

bg:V172 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V171 ;
    bg:nextVerse bg:V173 ;
    bg:precedes bg:V173 ;
    bg:previousVerse bg:V171 ;
    bg:verseID "V172"^^xsd:string ;
    bg:verseNumber "4.19" ;
    bg:verseText "One is understood to be in full knowledge whose every endeavor is devoid of desire for sense gratification. He is said by sages to be a worker for whom the reactions of work have been burned up by the fire of perfect knowledge." .

bg:V173 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V172 ;
    bg:nextVerse bg:V174 ;
    bg:precedes bg:V174 ;
    bg:previousVerse bg:V172 ;
    bg:verseID "V173"^^xsd:string ;
    bg:verseNumber "4.20" ;
    bg:verseText "Abandoning all attachment to the results of his activities, ever satisfied and independent, he performs no fruitive action, although engaged in all kinds of undertakings." .

bg:V174 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V173 ;
    bg:nextVerse bg:V175 ;
    bg:precedes bg:V175 ;
    bg:previousVerse bg:V173 ;
    bg:verseID "V174"^^xsd:string ;
    bg:verseNumber "4.21" ;
    bg:verseText "Such a man of understanding acts with mind and intelligence perfectly controlled, gives up all sense of proprietorship over his possessions and acts only for the bare necessities of life. Thus working, he is not affected by sinful reactions." .

bg:V175 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V174 ;
    bg:nextVerse bg:V176 ;
    bg:precedes bg:V176 ;
    bg:previousVerse bg:V174 ;
    bg:verseID "V175"^^xsd:string ;
    bg:verseNumber "4.22" ;
    bg:verseText "He who is satisfied with gain which comes of its own accord, who is free from duality and does not envy, who is steady in both success and failure, is never entangled, although performing actions." .

bg:V176 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V175 ;
    bg:nextVerse bg:V177 ;
    bg:precedes bg:V177 ;
    bg:previousVerse bg:V175 ;
    bg:verseID "V176"^^xsd:string ;
    bg:verseNumber "4.23" ;
    bg:verseText "The work of a man who is unattached to the modes of material nature and who is fully situated in transcendental knowledge merges entirely into transcendence." .

bg:V177 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V176 ;
    bg:nextVerse bg:V178 ;
    bg:precedes bg:V178 ;
    bg:previousVerse bg:V176 ;
    bg:verseID "V177"^^xsd:string ;
    bg:verseNumber "4.24" ;
    bg:verseText "A person who is fully absorbed in Kṛṣṇa consciousness is sure to attain the spiritual kingdom because of his full contribution to spiritual activities, in which the consummation is absolute and that which is offered is of the same spiritual nature." .

bg:V178 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V177 ;
    bg:nextVerse bg:V179 ;
    bg:precedes bg:V179 ;
    bg:previousVerse bg:V177 ;
    bg:verseID "V178"^^xsd:string ;
    bg:verseNumber "4.25" ;
    bg:verseText "Some yogīs perfectly worship the demigods by offering different sacrifices to them, and some offer sacrifices in the fire of the Supreme Brahman." .

bg:V179 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V178 ;
    bg:nextVerse bg:V180 ;
    bg:precedes bg:V180 ;
    bg:previousVerse bg:V178 ;
    bg:verseID "V179"^^xsd:string ;
    bg:verseNumber "4.26" ;
    bg:verseText "Some [the unadulterated brahmacārīs] sacrifice the hearing process and the senses in the fire of mental control, and others [the regulated householders] sacrifice the objects of the senses in the fire of the senses." .

bg:V180 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V179 ;
    bg:nextVerse bg:V181 ;
    bg:precedes bg:V181 ;
    bg:previousVerse bg:V179 ;
    bg:verseID "V180"^^xsd:string ;
    bg:verseNumber "4.27" ;
    bg:verseText "Others, who are interested in achieving self-realization through control of the mind and senses, offer the functions of all the senses, and of the life breath, as oblations into the fire of the controlled mind." .

bg:V181 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V180 ;
    bg:nextVerse bg:V182 ;
    bg:precedes bg:V182 ;
    bg:previousVerse bg:V180 ;
    bg:verseID "V181"^^xsd:string ;
    bg:verseNumber "4.28" ;
    bg:verseText "Having accepted strict vows, some become enlightened by sacrificing their possessions, and others by performing severe austerities, by practicing the yoga of eightfold mysticism, or by studying the Vedas to advance in transcendental knowledge." .

bg:V182 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V181 ;
    bg:nextVerse bg:V183 ;
    bg:precedes bg:V183 ;
    bg:previousVerse bg:V181 ;
    bg:verseID "V182"^^xsd:string ;
    bg:verseNumber "4.29" ;
    bg:verseText "Still others, who are inclined to the process of breath restraint to remain in trance, practice by offering the movement of the outgoing breath into the incoming, and the incoming breath into the outgoing, and thus at last remain in trance, stopping all breathing. Others, curtailing the eating process, offer the outgoing breath into itself as a sacrifice." .

bg:V183 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V182 ;
    bg:nextVerse bg:V184 ;
    bg:precedes bg:V184 ;
    bg:previousVerse bg:V182 ;
    bg:verseID "V183"^^xsd:string ;
    bg:verseNumber "4.30" ;
    bg:verseText "All these performers who know the meaning of sacrifice become cleansed of sinful reactions, and, having tasted the nectar of the results of sacrifices, they advance toward the supreme eternal atmosphere." .

bg:V184 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V183 ;
    bg:nextVerse bg:V185 ;
    bg:precedes bg:V185 ;
    bg:previousVerse bg:V183 ;
    bg:verseID "V184"^^xsd:string ;
    bg:verseNumber "4.31" ;
    bg:verseText "O best of the Kuru dynasty, without sacrifice one can never live happily on this planet or in this life: what then of the next?" .

bg:V185 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V184 ;
    bg:nextVerse bg:V186 ;
    bg:precedes bg:V186 ;
    bg:previousVerse bg:V184 ;
    bg:verseID "V185"^^xsd:string ;
    bg:verseNumber "4.32" ;
    bg:verseText "All these different types of sacrifice are approved by the Vedas, and all of them are born of different types of work. Knowing them as such, you will become liberated." .

bg:V186 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V185 ;
    bg:nextVerse bg:V187 ;
    bg:precedes bg:V187 ;
    bg:previousVerse bg:V185 ;
    bg:verseID "V186"^^xsd:string ;
    bg:verseNumber "4.33" ;
    bg:verseText "O chastiser of the enemy, the sacrifice performed in knowledge is better than the mere sacrifice of material possessions. After all, O son of Pṛthā, all sacrifices of work culminate in transcendental knowledge." .

bg:V187 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V186 ;
    bg:nextVerse bg:V188 ;
    bg:precedes bg:V188 ;
    bg:previousVerse bg:V186 ;
    bg:verseID "V187"^^xsd:string ;
    bg:verseNumber "4.34" ;
    bg:verseText "Just try to learn the truth by approaching a spiritual master. Inquire from him submissively and render service unto him. The self-realized souls can impart knowledge unto you because they have seen the truth." .

bg:V188 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V187 ;
    bg:nextVerse bg:V189 ;
    bg:precedes bg:V189 ;
    bg:previousVerse bg:V187 ;
    bg:verseID "V188"^^xsd:string ;
    bg:verseNumber "4.35" ;
    bg:verseText "Having obtained real knowledge from a self-realized soul, you will never fall again into such illusion, for by this knowledge you will see that all living beings are but part of the Supreme, or, in other words, that they are Mine." .

bg:V189 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V188 ;
    bg:nextVerse bg:V190 ;
    bg:precedes bg:V190 ;
    bg:previousVerse bg:V188 ;
    bg:verseID "V189"^^xsd:string ;
    bg:verseNumber "4.36" ;
    bg:verseText "Even if you are considered to be the most sinful of all sinners, when you are situated in the boat of transcendental knowledge you will be able to cross over the ocean of miseries." .

bg:V190 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V189 ;
    bg:nextVerse bg:V191 ;
    bg:precedes bg:V191 ;
    bg:previousVerse bg:V189 ;
    bg:verseID "V190"^^xsd:string ;
    bg:verseNumber "4.37" ;
    bg:verseText "As a blazing fire turns firewood to ashes, O Arjuna, so does the fire of knowledge burn to ashes all reactions to material activities." .

bg:V191 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V190 ;
    bg:nextVerse bg:V192 ;
    bg:precedes bg:V192 ;
    bg:previousVerse bg:V190 ;
    bg:verseID "V191"^^xsd:string ;
    bg:verseNumber "4.38" ;
    bg:verseText "In this world, there is nothing so sublime and pure as transcendental knowledge. Such knowledge is the mature fruit of all mysticism. And one who has become accomplished in the practice of devotional service enjoys this knowledge within himself in due course of time." .

bg:V192 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V191 ;
    bg:nextVerse bg:V193 ;
    bg:precedes bg:V193 ;
    bg:previousVerse bg:V191 ;
    bg:verseID "V192"^^xsd:string ;
    bg:verseNumber "4.39" ;
    bg:verseText "A faithful man who is dedicated to transcendental knowledge and who subdues his senses is eligible to achieve such knowledge, and having achieved it he quickly attains the supreme spiritual peace." .

bg:V193 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V192 ;
    bg:nextVerse bg:V194 ;
    bg:precedes bg:V194 ;
    bg:previousVerse bg:V192 ;
    bg:verseID "V193"^^xsd:string ;
    bg:verseNumber "4.40" ;
    bg:verseText "But ignorant and faithless persons who doubt the revealed scriptures do not attain God consciousness; they fall down. For the doubting soul there is happiness neither in this world nor in the next." .

bg:V194 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V193 ;
    bg:nextVerse bg:V195 ;
    bg:precedes bg:V195 ;
    bg:previousVerse bg:V193 ;
    bg:verseID "V194"^^xsd:string ;
    bg:verseNumber "4.41" ;
    bg:verseText "One who acts in devotional service, renouncing the fruits of his actions, and whose doubts have been destroyed by transcendental knowledge, is situated factually in the self. Thus he is not bound by the reactions of work, O conqueror of riches." .

bg:V195 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH04 ;
    bg:follows bg:V194 ;
    bg:nextVerse bg:V196 ;
    bg:precedes bg:V196 ;
    bg:previousVerse bg:V194 ;
    bg:verseID "V195"^^xsd:string ;
    bg:verseNumber "4.42" ;
    bg:verseText "Therefore the doubts which have arisen in your heart out of ignorance should be slashed by the weapon of knowledge. Armed with yoga, O Bhārata, stand and fight." .

bg:V196 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V195 ;
    bg:nextVerse bg:V197 ;
    bg:precedes bg:V197 ;
    bg:previousVerse bg:V195 ;
    bg:verseID "V196"^^xsd:string ;
    bg:verseNumber "5.1" ;
    bg:verseText "Arjuna said: O Kṛṣṇa, first of all You ask me to renounce work, and then again You recommend work with devotion. Now will You kindly tell me definitely which of the two is more beneficial?" .

bg:V197 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V196 ;
    bg:nextVerse bg:V198 ;
    bg:precedes bg:V198 ;
    bg:previousVerse bg:V196 ;
    bg:verseID "V197"^^xsd:string ;
    bg:verseNumber "5.2" ;
    bg:verseText "The Personality of Godhead replied: The renunciation of work and work in devotion are both good for liberation. But, of the two, work in devotional service is better than renunciation of work." .

bg:V198 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V197 ;
    bg:nextVerse bg:V199 ;
    bg:precedes bg:V199 ;
    bg:previousVerse bg:V197 ;
    bg:verseID "V198"^^xsd:string ;
    bg:verseNumber "5.3" ;
    bg:verseText "One who neither hates nor desires the fruits of his activities is known to be always renounced. Such a person, free from all dualities, easily overcomes material bondage and is completely liberated, O mighty-armed Arjuna." .

bg:V199 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V198 ;
    bg:nextVerse bg:V200 ;
    bg:precedes bg:V200 ;
    bg:previousVerse bg:V198 ;
    bg:verseID "V199"^^xsd:string ;
    bg:verseNumber "5.4" ;
    bg:verseText "Only the ignorant speak of devotional service [karma-yoga] as being different from the analytical study of the material world [Sāṅkhya]. Those who are actually learned say that he who applies himself well to one of these paths achieves the results of both." .

bg:V200 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V199 ;
    bg:nextVerse bg:V201 ;
    bg:precedes bg:V201 ;
    bg:previousVerse bg:V199 ;
    bg:verseID "V200"^^xsd:string ;
    bg:verseNumber "5.5" ;
    bg:verseText "One who knows that the position reached by means of analytical study can also be attained by devotional service, and who therefore sees analytical study and devotional service to be on the same level, sees things as they are." .

bg:V201 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V200 ;
    bg:nextVerse bg:V202 ;
    bg:precedes bg:V202 ;
    bg:previousVerse bg:V200 ;
    bg:verseID "V201"^^xsd:string ;
    bg:verseNumber "5.6" ;
    bg:verseText "Merely renouncing all activities yet not engaging in the devotional service of the Lord cannot make one happy. But a thoughtful person engaged in devotional service can achieve the Supreme without delay." .

bg:V202 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V201 ;
    bg:nextVerse bg:V203 ;
    bg:precedes bg:V203 ;
    bg:previousVerse bg:V201 ;
    bg:verseID "V202"^^xsd:string ;
    bg:verseNumber "5.7" ;
    bg:verseText "One who works in devotion, who is a pure soul, and who controls his mind and senses is dear to everyone, and everyone is dear to him. Though always working, such a man is never entangled." .

bg:V203 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V202 ;
    bg:nextVerse bg:V204 ;
    bg:precedes bg:V204 ;
    bg:previousVerse bg:V202 ;
    bg:verseID "V203"^^xsd:string ;
    bg:verseNumber "5.8–9" ;
    bg:verseText "A person in the divine consciousness, although engaged in seeing, hearing, touching, smelling, eating, moving about, sleeping and breathing, always knows within himself that he actually does nothing at all. Because while speaking, evacuating, receiving, or opening or closing his eyes, he always knows that only the material senses are engaged with their objects and that he is aloof from them." .

bg:V204 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V203 ;
    bg:nextVerse bg:V205 ;
    bg:precedes bg:V205 ;
    bg:previousVerse bg:V203 ;
    bg:verseID "V204"^^xsd:string ;
    bg:verseNumber "5.10" ;
    bg:verseText "One who performs his duty without attachment, surrendering the results unto the Supreme Lord, is unaffected by sinful action, as the lotus leaf is untouched by water." .

bg:V205 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V204 ;
    bg:nextVerse bg:V206 ;
    bg:precedes bg:V206 ;
    bg:previousVerse bg:V204 ;
    bg:verseID "V205"^^xsd:string ;
    bg:verseNumber "5.11" ;
    bg:verseText "The yogīs, abandoning attachment, act with body, mind, intelligence and even with the senses, only for the purpose of purification." .

bg:V206 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V205 ;
    bg:nextVerse bg:V207 ;
    bg:precedes bg:V207 ;
    bg:previousVerse bg:V205 ;
    bg:verseID "V206"^^xsd:string ;
    bg:verseNumber "5.12" ;
    bg:verseText "The steadily devoted soul attains unadulterated peace because he offers the result of all activities to Me; whereas a person who is not in union with the Divine, who is greedy for the fruits of his labor, becomes entangled." .

bg:V207 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V206 ;
    bg:nextVerse bg:V208 ;
    bg:precedes bg:V208 ;
    bg:previousVerse bg:V206 ;
    bg:verseID "V207"^^xsd:string ;
    bg:verseNumber "5.13" ;
    bg:verseText "When the embodied living being controls his nature and mentally renounces all actions, he resides happily in the city of nine gates [the material body], neither working nor causing work to be done." .

bg:V208 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V207 ;
    bg:nextVerse bg:V209 ;
    bg:precedes bg:V209 ;
    bg:previousVerse bg:V207 ;
    bg:verseID "V208"^^xsd:string ;
    bg:verseNumber "5.14" ;
    bg:verseText "The embodied spirit, master of the city of his body, does not create activities, nor does he induce people to act, nor does he create the fruits of action. All this is enacted by the modes of material nature." .

bg:V209 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V208 ;
    bg:nextVerse bg:V210 ;
    bg:precedes bg:V210 ;
    bg:previousVerse bg:V208 ;
    bg:verseID "V209"^^xsd:string ;
    bg:verseNumber "5.15" ;
    bg:verseText "Nor does the Supreme Lord assume anyone’s sinful or pious activities. Embodied beings, however, are bewildered because of the ignorance which covers their real knowledge." .

bg:V210 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V209 ;
    bg:nextVerse bg:V211 ;
    bg:precedes bg:V211 ;
    bg:previousVerse bg:V209 ;
    bg:verseID "V210"^^xsd:string ;
    bg:verseNumber "5.16" ;
    bg:verseText "When, however, one is enlightened with the knowledge by which nescience is destroyed, then his knowledge reveals everything, as the sun lights up everything in the daytime." .

bg:V211 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V210 ;
    bg:nextVerse bg:V212 ;
    bg:precedes bg:V212 ;
    bg:previousVerse bg:V210 ;
    bg:verseID "V211"^^xsd:string ;
    bg:verseNumber "5.17" ;
    bg:verseText "When one’s intelligence, mind, faith and refuge are all fixed in the Supreme, then one becomes fully cleansed of misgivings through complete knowledge and thus proceeds straight on the path of liberation." .

bg:V212 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V211 ;
    bg:nextVerse bg:V213 ;
    bg:precedes bg:V213 ;
    bg:previousVerse bg:V211 ;
    bg:verseID "V212"^^xsd:string ;
    bg:verseNumber "5.18" ;
    bg:verseText "The humble sages, by virtue of true knowledge, see with equal vision a learned and gentle brāhmaṇa, a cow, an elephant, a dog and a dog-eater [outcaste]." .

bg:V213 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V212 ;
    bg:nextVerse bg:V214 ;
    bg:precedes bg:V214 ;
    bg:previousVerse bg:V212 ;
    bg:verseID "V213"^^xsd:string ;
    bg:verseNumber "5.19" ;
    bg:verseText "Those whose minds are established in sameness and equanimity have already conquered the conditions of birth and death. They are flawless like Brahman, and thus they are already situated in Brahman." .

bg:V214 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V213 ;
    bg:nextVerse bg:V215 ;
    bg:precedes bg:V215 ;
    bg:previousVerse bg:V213 ;
    bg:verseID "V214"^^xsd:string ;
    bg:verseNumber "5.20" ;
    bg:verseText "A person who neither rejoices upon achieving something pleasant nor laments upon obtaining something unpleasant, who is self-intelligent, who is unbewildered, and who knows the science of God is already situated in transcendence." .

bg:V215 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V214 ;
    bg:nextVerse bg:V216 ;
    bg:precedes bg:V216 ;
    bg:previousVerse bg:V214 ;
    bg:verseID "V215"^^xsd:string ;
    bg:verseNumber "5.21" ;
    bg:verseText "Such a liberated person is not attracted to material sense pleasure but is always in trance, enjoying the pleasure within. In this way the self-realized person enjoys unlimited happiness, for he concentrates on the Supreme." .

bg:V216 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V215 ;
    bg:nextVerse bg:V217 ;
    bg:precedes bg:V217 ;
    bg:previousVerse bg:V215 ;
    bg:verseID "V216"^^xsd:string ;
    bg:verseNumber "5.22" ;
    bg:verseText "An intelligent person does not take part in the sources of misery, which are due to contact with the material senses. O son of Kuntī, such pleasures have a beginning and an end, and so the wise man does not delight in them." .

bg:V217 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V216 ;
    bg:nextVerse bg:V218 ;
    bg:precedes bg:V218 ;
    bg:previousVerse bg:V216 ;
    bg:verseID "V217"^^xsd:string ;
    bg:verseNumber "5.23" ;
    bg:verseText "Before giving up this present body, if one is able to tolerate the urges of the material senses and check the force of desire and anger, he is well situated and is happy in this world." .

bg:V218 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V217 ;
    bg:nextVerse bg:V219 ;
    bg:precedes bg:V219 ;
    bg:previousVerse bg:V217 ;
    bg:verseID "V218"^^xsd:string ;
    bg:verseNumber "5.24" ;
    bg:verseText "One whose happiness is within, who is active and rejoices within, and whose aim is inward is actually the perfect mystic. He is liberated in the Supreme, and ultimately he attains the Supreme." .

bg:V219 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V218 ;
    bg:nextVerse bg:V220 ;
    bg:precedes bg:V220 ;
    bg:previousVerse bg:V218 ;
    bg:verseID "V219"^^xsd:string ;
    bg:verseNumber "5.25" ;
    bg:verseText "Those who are beyond the dualities that arise from doubts, whose minds are engaged within, who are always busy working for the welfare of all living beings and who are free from all sins achieve liberation in the Supreme." .

bg:V220 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V219 ;
    bg:nextVerse bg:V221 ;
    bg:precedes bg:V221 ;
    bg:previousVerse bg:V219 ;
    bg:verseID "V220"^^xsd:string ;
    bg:verseNumber "5.26" ;
    bg:verseText "Those who are free from anger and all material desires, who are self-realized, self-disciplined and constantly endeavoring for perfection, are assured of liberation in the Supreme in the very near future." .

bg:V221 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V220 ;
    bg:nextVerse bg:V222 ;
    bg:precedes bg:V222 ;
    bg:previousVerse bg:V220 ;
    bg:verseID "V221"^^xsd:string ;
    bg:verseNumber "5.27–28" ;
    bg:verseText "Shutting out all external sense objects, keeping the eyes and vision concentrated between the two eyebrows, suspending the inward and outward breaths within the nostrils, and thus controlling the mind, senses and intelligence, the transcendentalist aiming at liberation becomes free from desire, fear and anger. One who is always in this state is certainly liberated." .

bg:V222 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH05 ;
    bg:follows bg:V221 ;
    bg:nextVerse bg:V223 ;
    bg:precedes bg:V223 ;
    bg:previousVerse bg:V221 ;
    bg:verseID "V222"^^xsd:string ;
    bg:verseNumber "5.29" ;
    bg:verseText "A person in full consciousness of Me, knowing Me to be the ultimate beneficiary of all sacrifices and austerities, the Supreme Lord of all planets and demigods, and the benefactor and well-wisher of all living entities, attains peace from the pangs of material miseries." .

bg:V223 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V222 ;
    bg:nextVerse bg:V224 ;
    bg:precedes bg:V224 ;
    bg:previousVerse bg:V222 ;
    bg:verseID "V223"^^xsd:string ;
    bg:verseNumber "6.1" ;
    bg:verseText "The Supreme Personality of Godhead said: One who is unattached to the fruits of his work and who works as he is obligated is in the renounced order of life, and he is the true mystic, not he who lights no fire and performs no work." .

bg:V224 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V223 ;
    bg:nextVerse bg:V225 ;
    bg:precedes bg:V225 ;
    bg:previousVerse bg:V223 ;
    bg:verseID "V224"^^xsd:string ;
    bg:verseNumber "6.2" ;
    bg:verseText "What is called renunciation is the same as yoga, or linking oneself with the Supreme, for no one can become a yogī unless he renounces the desire for sense gratification." .

bg:V225 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V224 ;
    bg:nextVerse bg:V226 ;
    bg:precedes bg:V226 ;
    bg:previousVerse bg:V224 ;
    bg:verseID "V225"^^xsd:string ;
    bg:verseNumber "6.3" ;
    bg:verseText "For one who is a neophyte in the eightfold yoga system, work is said to be the means; and for one who has already attained to yoga, cessation of all material activities is said to be the means." .

bg:V226 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V225 ;
    bg:nextVerse bg:V227 ;
    bg:precedes bg:V227 ;
    bg:previousVerse bg:V225 ;
    bg:verseID "V226"^^xsd:string ;
    bg:verseNumber "6.4" ;
    bg:verseText "A person is said to have attained yoga when, having renounced all material desires, he neither acts for sense gratification nor engages in fruitive activities." .

bg:V227 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V226 ;
    bg:nextVerse bg:V228 ;
    bg:precedes bg:V228 ;
    bg:previousVerse bg:V226 ;
    bg:verseID "V227"^^xsd:string ;
    bg:verseNumber "6.5–6" ;
    bg:verseText "One must deliver himself with the help of his mind, and not degrade himself. The mind is the friend of the conditioned soul, and his enemy as well. For him who has conquered the mind, the mind is the best of friends; but for one who has failed to do so, his very mind will be the greatest enemy." .

bg:V228 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V227 ;
    bg:nextVerse bg:V229 ;
    bg:precedes bg:V229 ;
    bg:previousVerse bg:V227 ;
    bg:verseID "V228"^^xsd:string ;
    bg:verseNumber "6.7" ;
    bg:verseText "For one who has conquered the mind, the Supersoul is already reached, for he has attained tranquility. To such a man happiness and distress, heat and cold, honor and dishonor are all the same." .

bg:V229 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V228 ;
    bg:nextVerse bg:V230 ;
    bg:precedes bg:V230 ;
    bg:previousVerse bg:V228 ;
    bg:verseID "V229"^^xsd:string ;
    bg:verseNumber "6.8" ;
    bg:verseText "A person is said to be established in self-realization and is called a yogī [or mystic] when he is fully satisfied by virtue of acquired knowledge and realization. Such a person is situated in transcendence and is self-controlled. He sees everything—whether it be pebbles, stones or gold—as the same." .

bg:V230 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V229 ;
    bg:nextVerse bg:V231 ;
    bg:precedes bg:V231 ;
    bg:previousVerse bg:V229 ;
    bg:verseID "V230"^^xsd:string ;
    bg:verseNumber "6.9" ;
    bg:verseText "A person is considered still further advanced when he regards honest well-wishers, affectionate benefactors, the neutral, mediators, the envious, friends and enemies, the pious and the sinners all with an equal mind." .

bg:V231 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V230 ;
    bg:nextVerse bg:V232 ;
    bg:precedes bg:V232 ;
    bg:previousVerse bg:V230 ;
    bg:verseID "V231"^^xsd:string ;
    bg:verseNumber "6.10" ;
    bg:verseText "A transcendentalist should always engage his body, mind and self in relationship with the Supreme; he should live alone in a secluded place and should always carefully control his mind. He should be free from desires and feelings of possessiveness." .

bg:V232 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V231 ;
    bg:nextVerse bg:V233 ;
    bg:precedes bg:V233 ;
    bg:previousVerse bg:V231 ;
    bg:verseID "V232"^^xsd:string ;
    bg:verseNumber "6.11" ;
    bg:verseText "To practice yoga, one should go to a secluded place and should lay kuśa grass on the ground and then cover it with a deerskin and a soft cloth. The seat should be neither too high nor too low and should be situated in a sacred place." .

bg:V233 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V232 ;
    bg:nextVerse bg:V234 ;
    bg:precedes bg:V234 ;
    bg:previousVerse bg:V232 ;
    bg:verseID "V233"^^xsd:string ;
    bg:verseNumber "6.12" ;
    bg:verseText "The yogī should then sit on it very firmly and practice yoga to purify the heart by controlling his mind, senses and activities and fixing the mind on one point." .

bg:V234 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V233 ;
    bg:nextVerse bg:V235 ;
    bg:precedes bg:V235 ;
    bg:previousVerse bg:V233 ;
    bg:verseID "V234"^^xsd:string ;
    bg:verseNumber "6.13" ;
    bg:verseText "One should hold one’s body, neck and head erect in a straight line and stare steadily at the tip of the nose. Thus, with an unagitated, subdued mind, devoid of fear, completely free from sex life, one should meditate upon Me within the heart and make Me the ultimate goal of life." .

bg:V235 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V234 ;
    bg:nextVerse bg:V236 ;
    bg:precedes bg:V236 ;
    bg:previousVerse bg:V234 ;
    bg:verseID "V235"^^xsd:string ;
    bg:verseNumber "6.14" ;
    bg:verseText "Thus practicing constant control of the body, mind and activities, the mystic transcendentalist, with his mind regulated, attains to the kingdom of God by cessation of material existence." .

bg:V236 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V235 ;
    bg:nextVerse bg:V237 ;
    bg:precedes bg:V237 ;
    bg:previousVerse bg:V235 ;
    bg:verseID "V236"^^xsd:string ;
    bg:verseNumber "6.15" ;
    bg:verseText "In this way the self-controlled mystic, constantly engaged in regulating the mind, becomes freed from material existence and attains the kingdom of God." .

bg:V237 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V236 ;
    bg:nextVerse bg:V238 ;
    bg:precedes bg:V238 ;
    bg:previousVerse bg:V236 ;
    bg:verseID "V237"^^xsd:string ;
    bg:verseNumber "6.16" ;
    bg:verseText "There is no possibility of one’s becoming a yogī, O Arjuna, if one eats too much or eats too little, sleeps too much or does not sleep enough." .

bg:V238 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V237 ;
    bg:nextVerse bg:V239 ;
    bg:precedes bg:V239 ;
    bg:previousVerse bg:V237 ;
    bg:verseID "V238"^^xsd:string ;
    bg:verseNumber "6.17" ;
    bg:verseText "He who is temperate in his habits of eating, sleeping, working and recreation can mitigate all material pains by practicing the yoga system." .

bg:V239 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V238 ;
    bg:nextVerse bg:V240 ;
    bg:precedes bg:V240 ;
    bg:previousVerse bg:V238 ;
    bg:verseID "V239"^^xsd:string ;
    bg:verseNumber "6.18" ;
    bg:verseText "When the yogī, by practice of yoga, disciplines his mental activities and becomes situated in transcendence—devoid of all material desires—he is said to be well established in yoga." .

bg:V240 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V239 ;
    bg:nextVerse bg:V241 ;
    bg:precedes bg:V241 ;
    bg:previousVerse bg:V239 ;
    bg:verseID "V240"^^xsd:string ;
    bg:verseNumber "6.19" ;
    bg:verseText "As a lamp in a windless place does not waver, so the transcendentalist, whose mind is controlled, remains always steady in his meditation on the transcendent self." .

bg:V241 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V240 ;
    bg:nextVerse bg:V242 ;
    bg:precedes bg:V242 ;
    bg:previousVerse bg:V240 ;
    bg:verseID "V241"^^xsd:string ;
    bg:verseNumber "6.20" ;
    bg:verseText "In the stage of perfection called trance, or samādhi, one’s mind is completely restrained from material mental activities by practice of yoga. This perfection is characterized by one’s ability to see the self by the pure mind and to relish and rejoice in the self." .

bg:V242 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V241 ;
    bg:nextVerse bg:V243 ;
    bg:precedes bg:V243 ;
    bg:previousVerse bg:V241 ;
    bg:verseID "V242"^^xsd:string ;
    bg:verseNumber "6.21" ;
    bg:verseText "In that joyous state, one is situated in boundless transcendental happiness and enjoys himself through transcendental senses. Established thus, one never departs from the truth, and upon gaining this he thinks there is no greater gain." .

bg:V243 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V242 ;
    bg:nextVerse bg:V244 ;
    bg:precedes bg:V244 ;
    bg:previousVerse bg:V242 ;
    bg:verseID "V243"^^xsd:string ;
    bg:verseNumber "6.22" ;
    bg:verseText "Being situated in such a position, one is never shaken, even in the midst of the greatest difficulty. Indeed, this is actual freedom from all miseries arising from material contact." .

bg:V244 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V243 ;
    bg:nextVerse bg:V245 ;
    bg:precedes bg:V245 ;
    bg:previousVerse bg:V243 ;
    bg:verseID "V244"^^xsd:string ;
    bg:verseNumber "6.23" ;
    bg:verseText "One should engage oneself with determination and faith in this practice of yoga, without deviation. One should abandon, without exception, all material desires born of false ego and thus control all the senses on all sides by the mind." .

bg:V245 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V244 ;
    bg:nextVerse bg:V246 ;
    bg:precedes bg:V246 ;
    bg:previousVerse bg:V244 ;
    bg:verseID "V245"^^xsd:string ;
    bg:verseNumber "6.24" ;
    bg:verseText "One should engage oneself with full conviction, gradually, step by step, and thus become situated in trance by means of intelligence sustained by full conviction. Thus the mind should be fixed on the self alone and should think of nothing else." .

bg:V246 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V245 ;
    bg:nextVerse bg:V247 ;
    bg:precedes bg:V247 ;
    bg:previousVerse bg:V245 ;
    bg:verseID "V246"^^xsd:string ;
    bg:verseNumber "6.25" ;
    bg:verseText "Gradually, step by step, with full conviction, one should become situated in trance by means of intelligence, and thus the mind should be fixed on the self alone and should think of nothing else." .

bg:V247 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V246 ;
    bg:nextVerse bg:V248 ;
    bg:precedes bg:V248 ;
    bg:previousVerse bg:V246 ;
    bg:verseID "V247"^^xsd:string ;
    bg:verseNumber "6.26" ;
    bg:verseText "From wherever the mind wanders due to its flickering and unsteady nature, one must certainly withdraw it and bring it back under the control of the self." .

bg:V248 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V247 ;
    bg:nextVerse bg:V249 ;
    bg:precedes bg:V249 ;
    bg:previousVerse bg:V247 ;
    bg:verseID "V248"^^xsd:string ;
    bg:verseNumber "6.27" ;
    bg:verseText "The yogī whose mind is fixed on Me verily attains the highest perfection of transcendental happiness. He is beyond the mode of passion, he realizes his qualitative identity with the Supreme, and thus he is freed from all reactions to past deeds." .

bg:V249 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V248 ;
    bg:nextVerse bg:V250 ;
    bg:precedes bg:V250 ;
    bg:previousVerse bg:V248 ;
    bg:verseID "V249"^^xsd:string ;
    bg:verseNumber "6.28" ;
    bg:verseText "Steady in the self, being freed from all material contamination, the yogī achieves the highest perfectional stage of happiness in touch with the Supreme Consciousness." .

bg:V250 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V249 ;
    bg:nextVerse bg:V251 ;
    bg:precedes bg:V251 ;
    bg:previousVerse bg:V249 ;
    bg:verseID "V250"^^xsd:string ;
    bg:verseNumber "6.29" ;
    bg:verseText "A true yogī observes Me in all beings, and also sees every being in Me. Indeed, the self-realized person sees Me, the same Supreme Lord, everywhere." .

bg:V251 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V250 ;
    bg:nextVerse bg:V252 ;
    bg:precedes bg:V252 ;
    bg:previousVerse bg:V250 ;
    bg:verseID "V251"^^xsd:string ;
    bg:verseNumber "6.30" ;
    bg:verseText "For one who sees Me everywhere and sees everything in Me, I am never lost, nor is he ever lost to Me." .

bg:V252 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V251 ;
    bg:nextVerse bg:V253 ;
    bg:precedes bg:V253 ;
    bg:previousVerse bg:V251 ;
    bg:verseID "V252"^^xsd:string ;
    bg:verseNumber "6.31" ;
    bg:verseText "Such a yogī, who engages in the worshipful service of the Supersoul, knowing that I and the Supersoul are one, remains always in Me in all circumstances." .

bg:V253 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V252 ;
    bg:nextVerse bg:V254 ;
    bg:precedes bg:V254 ;
    bg:previousVerse bg:V252 ;
    bg:verseID "V253"^^xsd:string ;
    bg:verseNumber "6.32" ;
    bg:verseText "He is a perfect yogī who, by comparison to his own self, sees the true equality of all beings, in both their happiness and their distress, O Arjuna." .

bg:V254 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V253 ;
    bg:nextVerse bg:V255 ;
    bg:precedes bg:V255 ;
    bg:previousVerse bg:V253 ;
    bg:verseID "V254"^^xsd:string ;
    bg:verseNumber "6.33" ;
    bg:verseText "Arjuna said: O Madhusūdana, the system of yoga which You have summarized appears impractical and unendurable to me, for the mind is restless and unsteady." .

bg:V255 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V254 ;
    bg:nextVerse bg:V256 ;
    bg:precedes bg:V256 ;
    bg:previousVerse bg:V254 ;
    bg:verseID "V255"^^xsd:string ;
    bg:verseNumber "6.34" ;
    bg:verseText "For the mind is restless, turbulent, obstinate and very strong, O Kṛṣṇa, and to subdue it, I think, is more difficult than controlling the wind." .

bg:V256 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V255 ;
    bg:nextVerse bg:V257 ;
    bg:precedes bg:V257 ;
    bg:previousVerse bg:V255 ;
    bg:verseID "V256"^^xsd:string ;
    bg:verseNumber "6.35" ;
    bg:verseText "Lord Śrī Kṛṣṇa said: O mighty-armed son of Kuntī, it is undoubtedly very difficult to curb the restless mind, but it is possible by suitable practice and by detachment." .

bg:V257 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V256 ;
    bg:nextVerse bg:V258 ;
    bg:precedes bg:V258 ;
    bg:previousVerse bg:V256 ;
    bg:verseID "V257"^^xsd:string ;
    bg:verseNumber "6.36" ;
    bg:verseText "For one whose mind is unbridled, self-realization is difficult work. But he whose mind is controlled and who strives by appropriate means is assured of success. That is My opinion." .

bg:V258 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V257 ;
    bg:nextVerse bg:V259 ;
    bg:precedes bg:V259 ;
    bg:previousVerse bg:V257 ;
    bg:verseID "V258"^^xsd:string ;
    bg:verseNumber "6.37" ;
    bg:verseText "Arjuna said: O Kṛṣṇa, what is the destination of the unsuccessful transcendentalist, who in the beginning takes to the process of self-realization with faith but who later desists due to worldly-mindedness and thus does not attain perfection in mysticism?" .

bg:V259 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V258 ;
    bg:nextVerse bg:V260 ;
    bg:precedes bg:V260 ;
    bg:previousVerse bg:V258 ;
    bg:verseID "V259"^^xsd:string ;
    bg:verseNumber "6.38" ;
    bg:verseText "O mighty-armed Kṛṣṇa, does not such a man, who is bewildered from the path of transcendence, fall away from both spiritual and material success and perish like a riven cloud, with no position in any sphere?" .

bg:V260 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V259 ;
    bg:nextVerse bg:V261 ;
    bg:precedes bg:V261 ;
    bg:previousVerse bg:V259 ;
    bg:verseID "V260"^^xsd:string ;
    bg:verseNumber "6.39" ;
    bg:verseText "This is my doubt, O Kṛṣṇa, and I ask You to dispel it completely. But for You, no one is to be found who can destroy this doubt." .

bg:V261 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V260 ;
    bg:nextVerse bg:V262 ;
    bg:precedes bg:V262 ;
    bg:previousVerse bg:V260 ;
    bg:verseID "V261"^^xsd:string ;
    bg:verseNumber "6.40" ;
    bg:verseText "The Supreme Personality of Godhead said: Son of Pṛthā, a transcendentalist engaged in auspicious activities does not meet with destruction either in this world or in the spiritual world. One who does good, My friend, is never overcome by evil." .

bg:V262 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V261 ;
    bg:nextVerse bg:V263 ;
    bg:precedes bg:V263 ;
    bg:previousVerse bg:V261 ;
    bg:verseID "V262"^^xsd:string ;
    bg:verseNumber "6.41" ;
    bg:verseText "The unsuccessful yogī, after many, many years of enjoyment on the planets of the pious living entities, is born into a family of righteous people, or into a family of rich aristocracy." .

bg:V263 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V262 ;
    bg:nextVerse bg:V264 ;
    bg:precedes bg:V264 ;
    bg:previousVerse bg:V262 ;
    bg:verseID "V263"^^xsd:string ;
    bg:verseNumber "6.42" ;
    bg:verseText "Or he takes birth in a family of transcendentalists who are surely great in wisdom. Certainly, such a birth is rare in this world." .

bg:V264 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V263 ;
    bg:nextVerse bg:V265 ;
    bg:precedes bg:V265 ;
    bg:previousVerse bg:V263 ;
    bg:verseID "V264"^^xsd:string ;
    bg:verseNumber "6.43" ;
    bg:verseText "On taking such a birth, he revives the divine consciousness of his previous life, and he again tries to make further progress in order to achieve complete success, O son of Kuru." .

bg:V265 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V264 ;
    bg:nextVerse bg:V266 ;
    bg:precedes bg:V266 ;
    bg:previousVerse bg:V264 ;
    bg:verseID "V265"^^xsd:string ;
    bg:verseNumber "6.44" ;
    bg:verseText "By virtue of the divine consciousness of his previous life, he automatically becomes attracted to the yogic principles—even without seeking them. Such an inquisitive transcendentalist stands always above the ritualistic principles of the scriptures." .

bg:V266 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V265 ;
    bg:nextVerse bg:V267 ;
    bg:precedes bg:V267 ;
    bg:previousVerse bg:V265 ;
    bg:verseID "V266"^^xsd:string ;
    bg:verseNumber "6.45" ;
    bg:verseText "And when the yogī engages himself with sincere endeavor in making further progress, being washed of all contaminations, then ultimately, after many, many births of practice, he attains the supreme goal." .

bg:V267 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V266 ;
    bg:nextVerse bg:V268 ;
    bg:precedes bg:V268 ;
    bg:previousVerse bg:V266 ;
    bg:verseID "V267"^^xsd:string ;
    bg:verseNumber "6.46" ;
    bg:verseText "A yogī is greater than the ascetic, greater than the empiricist and greater than the fruitive worker. Therefore, O Arjuna, in all circumstances, be a yogī." .

bg:V268 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH06 ;
    bg:follows bg:V267 ;
    bg:nextVerse bg:V269 ;
    bg:precedes bg:V269 ;
    bg:previousVerse bg:V267 ;
    bg:verseID "V268"^^xsd:string ;
    bg:verseNumber "6.47" ;
    bg:verseText "And of all yogīs, the one with great faith who always abides in Me, thinks of Me within himself, and renders transcendental loving service to Me—he is the most intimately united with Me in yoga and is the highest of all. That is My opinion." .

bg:V269 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V268 ;
    bg:nextVerse bg:V270 ;
    bg:precedes bg:V270 ;
    bg:previousVerse bg:V268 ;
    bg:verseID "V269"^^xsd:string ;
    bg:verseNumber "7.1" ;
    bg:verseText "The Supreme Personality of Godhead said: Now hear, O son of Pṛthā, how by practicing yoga in full consciousness of Me, with mind attached to Me, you can know Me in full, free from doubt." .

bg:V270 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V269 ;
    bg:nextVerse bg:V271 ;
    bg:precedes bg:V271 ;
    bg:previousVerse bg:V269 ;
    bg:verseID "V270"^^xsd:string ;
    bg:verseNumber "7.2" ;
    bg:verseText "I shall now declare unto you in full this knowledge, both phenomenal and numinous. This being known, nothing further shall remain for you to know." .

bg:V271 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V270 ;
    bg:nextVerse bg:V272 ;
    bg:precedes bg:V272 ;
    bg:previousVerse bg:V270 ;
    bg:verseID "V271"^^xsd:string ;
    bg:verseNumber "7.3" ;
    bg:verseText "Out of many thousands among men, one may endeavor for perfection, and of those who have achieved perfection, hardly one knows Me in truth." .

bg:V272 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V271 ;
    bg:nextVerse bg:V273 ;
    bg:precedes bg:V273 ;
    bg:previousVerse bg:V271 ;
    bg:verseID "V272"^^xsd:string ;
    bg:verseNumber "7.4" ;
    bg:verseText "Earth, water, fire, air, ether, mind, intelligence and false ego – all together these eight constitute My separated material energies." .

bg:V273 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V272 ;
    bg:nextVerse bg:V274 ;
    bg:precedes bg:V274 ;
    bg:previousVerse bg:V272 ;
    bg:verseID "V273"^^xsd:string ;
    bg:verseNumber "7.5" ;
    bg:verseText "Besides these, O mighty-armed Arjuna, there is another, superior energy of Mine, which comprises the living entities who are exploiting the resources of this material, inferior nature." .

bg:V274 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V273 ;
    bg:nextVerse bg:V275 ;
    bg:precedes bg:V275 ;
    bg:previousVerse bg:V273 ;
    bg:verseID "V274"^^xsd:string ;
    bg:verseNumber "7.6" ;
    bg:verseText "All created beings have their source in these two natures. Of all that is material and all that is spiritual in this world, know for certain that I am both the origin and the dissolution." .

bg:V275 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V274 ;
    bg:nextVerse bg:V276 ;
    bg:precedes bg:V276 ;
    bg:previousVerse bg:V274 ;
    bg:verseID "V275"^^xsd:string ;
    bg:verseNumber "7.7" ;
    bg:verseText "O conqueror of wealth, there is no truth superior to Me. Everything rests upon Me, as pearls are strung on a thread." .

bg:V276 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V275 ;
    bg:nextVerse bg:V277 ;
    bg:precedes bg:V277 ;
    bg:previousVerse bg:V275 ;
    bg:verseID "V276"^^xsd:string ;
    bg:verseNumber "7.8" ;
    bg:verseText "O son of Kuntī, I am the taste of water, the light of the sun and the moon, the syllable oṁ in the Vedic mantras; I am the sound in ether and ability in man." .

bg:V277 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V276 ;
    bg:nextVerse bg:V278 ;
    bg:precedes bg:V278 ;
    bg:previousVerse bg:V276 ;
    bg:verseID "V277"^^xsd:string ;
    bg:verseNumber "7.9" ;
    bg:verseText "I am the original fragrance of the earth, and I am the heat in fire. I am the life of all that lives, and I am the penances of all ascetics." .

bg:V278 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V277 ;
    bg:nextVerse bg:V279 ;
    bg:precedes bg:V279 ;
    bg:previousVerse bg:V277 ;
    bg:verseID "V278"^^xsd:string ;
    bg:verseNumber "7.10" ;
    bg:verseText "O son of Pṛthā, know that I am the original seed of all existences, the intelligence of the intelligent, and the prowess of all powerful men." .

bg:V279 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V278 ;
    bg:nextVerse bg:V280 ;
    bg:precedes bg:V280 ;
    bg:previousVerse bg:V278 ;
    bg:verseID "V279"^^xsd:string ;
    bg:verseNumber "7.11" ;
    bg:verseText "I am the strength of the strong, devoid of passion and desire. I am sex life which is not contrary to religious principles, O lord of the Bhāratas [Arjuna]." .

bg:V280 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V279 ;
    bg:nextVerse bg:V281 ;
    bg:precedes bg:V281 ;
    bg:previousVerse bg:V279 ;
    bg:verseID "V280"^^xsd:string ;
    bg:verseNumber "7.12" ;
    bg:verseText "Know that all states of being – be they of goodness, passion or ignorance – are manifested by My energy. I am, in one sense, everything, but I am independent. I am not under the modes of material nature, for they, on the contrary, are within Me." .

bg:V281 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V280 ;
    bg:nextVerse bg:V282 ;
    bg:precedes bg:V282 ;
    bg:previousVerse bg:V280 ;
    bg:verseID "V281"^^xsd:string ;
    bg:verseNumber "7.13" ;
    bg:verseText "Deluded by the three modes [goodness, passion and ignorance], the whole world does not know Me, who am above the modes and inexhaustible." .

bg:V282 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V281 ;
    bg:nextVerse bg:V283 ;
    bg:precedes bg:V283 ;
    bg:previousVerse bg:V281 ;
    bg:verseID "V282"^^xsd:string ;
    bg:verseNumber "7.14" ;
    bg:verseText "This divine energy of Mine, consisting of the three modes of material nature, is difficult to overcome. But those who have surrendered unto Me can easily cross beyond it." .

bg:V283 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V282 ;
    bg:nextVerse bg:V284 ;
    bg:precedes bg:V284 ;
    bg:previousVerse bg:V282 ;
    bg:verseID "V283"^^xsd:string ;
    bg:verseNumber "7.15" ;
    bg:verseText "Those miscreants who are grossly foolish, who are lowest among mankind, whose knowledge is stolen by illusion, and who partake of the atheistic nature of demons do not surrender unto Me." .

bg:V284 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V283 ;
    bg:nextVerse bg:V285 ;
    bg:precedes bg:V285 ;
    bg:previousVerse bg:V283 ;
    bg:verseID "V284"^^xsd:string ;
    bg:verseNumber "7.16" ;
    bg:verseText "O best among the Bhāratas, four kinds of pious men begin to render devotional service unto Me – the distressed, the desirer of wealth, the inquisitive, and he who is searching for knowledge of the Absolute." .

bg:V285 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V284 ;
    bg:nextVerse bg:V286 ;
    bg:precedes bg:V286 ;
    bg:previousVerse bg:V284 ;
    bg:verseID "V285"^^xsd:string ;
    bg:verseNumber "7.17" ;
    bg:verseText "Of these, the one who is in full knowledge and who is always engaged in pure devotional service is the best. For I am very dear to him, and he is dear to Me." .

bg:V286 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V285 ;
    bg:nextVerse bg:V287 ;
    bg:precedes bg:V287 ;
    bg:previousVerse bg:V285 ;
    bg:verseID "V286"^^xsd:string ;
    bg:verseNumber "7.18" ;
    bg:verseText "All these devotees are undoubtedly magnanimous souls, but he who is situated in knowledge of Me I consider to be just like My own self. Being engaged in My transcendental service, he is sure to attain Me, the highest and most perfect goal." .

bg:V287 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V286 ;
    bg:nextVerse bg:V288 ;
    bg:precedes bg:V288 ;
    bg:previousVerse bg:V286 ;
    bg:verseID "V287"^^xsd:string ;
    bg:verseNumber "7.19" ;
    bg:verseText "After many births and deaths, he who is actually in knowledge surrenders unto Me, knowing Me to be the cause of all causes and all that is. Such a great soul is very rare." .

bg:V288 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V287 ;
    bg:nextVerse bg:V289 ;
    bg:precedes bg:V289 ;
    bg:previousVerse bg:V287 ;
    bg:verseID "V288"^^xsd:string ;
    bg:verseNumber "7.20" ;
    bg:verseText "Those whose intelligence has been stolen by material desires surrender unto demigods and follow the particular rules and regulations of worship according to their own natures." .

bg:V289 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V288 ;
    bg:nextVerse bg:V290 ;
    bg:precedes bg:V290 ;
    bg:previousVerse bg:V288 ;
    bg:verseID "V289"^^xsd:string ;
    bg:verseNumber "7.21" ;
    bg:verseText "I am in everyone’s heart as the Supersoul. As soon as one desires to worship some demigod, I make his faith steady so that he can devote himself to that particular deity." .

bg:V290 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V289 ;
    bg:nextVerse bg:V291 ;
    bg:precedes bg:V291 ;
    bg:previousVerse bg:V289 ;
    bg:verseID "V290"^^xsd:string ;
    bg:verseNumber "7.22" ;
    bg:verseText "Endowed with such a faith, he endeavors to worship a particular demigod and obtains his desires. But in actuality these benefits are bestowed by Me alone." .

bg:V291 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V290 ;
    bg:nextVerse bg:V292 ;
    bg:precedes bg:V292 ;
    bg:previousVerse bg:V290 ;
    bg:verseID "V291"^^xsd:string ;
    bg:verseNumber "7.23" ;
    bg:verseText "Men of small intelligence worship the demigods, and their fruits are limited and temporary. Those who worship the demigods go to the planets of the demigods, but My devotees ultimately reach My supreme planet." .

bg:V292 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V291 ;
    bg:nextVerse bg:V293 ;
    bg:precedes bg:V293 ;
    bg:previousVerse bg:V291 ;
    bg:verseID "V292"^^xsd:string ;
    bg:verseNumber "7.24" ;
    bg:verseText "Unintelligent men, who do not know Me perfectly, think that I, the Supreme Personality of Godhead, Kṛṣṇa, was impersonal before and have now assumed this personality. Due to their small knowledge, they do not know My higher nature, which is imperishable and supreme." .

bg:V293 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V292 ;
    bg:nextVerse bg:V294 ;
    bg:precedes bg:V294 ;
    bg:previousVerse bg:V292 ;
    bg:verseID "V293"^^xsd:string ;
    bg:verseNumber "7.25" ;
    bg:verseText "I am never manifest to the foolish and unintelligent. For them I am covered by My internal potency, and therefore they do not know that I am unborn and infallible." .

bg:V294 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V293 ;
    bg:nextVerse bg:V295 ;
    bg:precedes bg:V295 ;
    bg:previousVerse bg:V293 ;
    bg:verseID "V294"^^xsd:string ;
    bg:verseNumber "7.26" ;
    bg:verseText "O Arjuna, as the Supreme Personality of Godhead, I know everything that has happened in the past, all that is happening in the present, and all things that are yet to come. I also know all living entities; but Me no one knows." .

bg:V295 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V294 ;
    bg:nextVerse bg:V296 ;
    bg:precedes bg:V296 ;
    bg:previousVerse bg:V294 ;
    bg:verseID "V295"^^xsd:string ;
    bg:verseNumber "7.27" ;
    bg:verseText "O scion of Bharata, O conqueror of the foe, all living entities are born into delusion, bewildered by dualities arisen from desire and hate." .

bg:V296 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V295 ;
    bg:nextVerse bg:V297 ;
    bg:precedes bg:V297 ;
    bg:previousVerse bg:V295 ;
    bg:verseID "V296"^^xsd:string ;
    bg:verseNumber "7.28" ;
    bg:verseText "Persons who have acted piously in previous lives and in this life and whose sinful actions are completely eradicated are freed from the dualities of delusion, and they engage themselves in My service with determination." .

bg:V297 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V296 ;
    bg:nextVerse bg:V298 ;
    bg:precedes bg:V298 ;
    bg:previousVerse bg:V296 ;
    bg:verseID "V297"^^xsd:string ;
    bg:verseNumber "7.29" ;
    bg:verseText "Intelligent persons who are endeavoring for liberation from old age and death take refuge in Me in devotional service. They are actually Brahman because they entirely know everything about transcendental activities." .

bg:V298 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH07 ;
    bg:follows bg:V297 ;
    bg:nextVerse bg:V299 ;
    bg:precedes bg:V299 ;
    bg:previousVerse bg:V297 ;
    bg:verseID "V298"^^xsd:string ;
    bg:verseNumber "7.30" ;
    bg:verseText "Those in full consciousness of Me, who know Me, the Supreme Lord, to be the governing principle of the material manifestation, of the demigods, and of all methods of sacrifice, can understand and know Me, the Supreme Personality of Godhead, even at the time of death." .

bg:V299 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V298 ;
    bg:nextVerse bg:V300 ;
    bg:precedes bg:V300 ;
    bg:previousVerse bg:V298 ;
    bg:verseID "V299"^^xsd:string ;
    bg:verseNumber "8.1" ;
    bg:verseText "Arjuna said: O my Lord, O Supreme Person, what is Brahman? What is the self? What are fruitive activities? What is this material manifestation? And what are the demigods? Please explain this to me." .

bg:V300 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V299 ;
    bg:nextVerse bg:V301 ;
    bg:precedes bg:V301 ;
    bg:previousVerse bg:V299 ;
    bg:verseID "V300"^^xsd:string ;
    bg:verseNumber "8.2" ;
    bg:verseText "Who is the Lord of sacrifice, and how does He live in the body, O Madhusūdana? And how can those engaged in devotional service know You at the time of death?" .

bg:V301 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V300 ;
    bg:nextVerse bg:V302 ;
    bg:precedes bg:V302 ;
    bg:previousVerse bg:V300 ;
    bg:verseID "V301"^^xsd:string ;
    bg:verseNumber "8.3" ;
    bg:verseText "The Supreme Personality of Godhead said: The indestructible, transcendental living entity is called Brahman, and his eternal nature is called adhyātma, the self. Action pertaining to the development of the material bodies of the living entities is called karma, or fruitive activities." .

bg:V302 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V301 ;
    bg:nextVerse bg:V303 ;
    bg:precedes bg:V303 ;
    bg:previousVerse bg:V301 ;
    bg:verseID "V302"^^xsd:string ;
    bg:verseNumber "8.4" ;
    bg:verseText "Physical nature is known to be endlessly mutable. The universe is the cosmic form of the Supreme Lord, and I am that Lord represented as the Supersoul, dwelling in the heart of every embodied being." .

bg:V303 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V302 ;
    bg:nextVerse bg:V304 ;
    bg:precedes bg:V304 ;
    bg:previousVerse bg:V302 ;
    bg:verseID "V303"^^xsd:string ;
    bg:verseNumber "8.5" ;
    bg:verseText "And whoever, at the end of his life, quits his body remembering Me alone at once attains My nature. Of this there is no doubt." .

bg:V304 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V303 ;
    bg:nextVerse bg:V305 ;
    bg:precedes bg:V305 ;
    bg:previousVerse bg:V303 ;
    bg:verseID "V304"^^xsd:string ;
    bg:verseNumber "8.6" ;
    bg:verseText "Whatever state of being one remembers when he quits his body, O son of Kuntī, that state he will attain without fail." .

bg:V305 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V304 ;
    bg:nextVerse bg:V306 ;
    bg:precedes bg:V306 ;
    bg:previousVerse bg:V304 ;
    bg:verseID "V305"^^xsd:string ;
    bg:verseNumber "8.7" ;
    bg:verseText "Therefore, Arjuna, you should always think of Me in the form of Kṛṣṇa and at the same time carry out your prescribed duty of fighting. With your activities dedicated to Me and your mind and intelligence fixed on Me, you will attain Me without doubt." .

bg:V306 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V305 ;
    bg:nextVerse bg:V307 ;
    bg:precedes bg:V307 ;
    bg:previousVerse bg:V305 ;
    bg:verseID "V306"^^xsd:string ;
    bg:verseNumber "8.8" ;
    bg:verseText "He who meditates on the Supreme Personality of Godhead, his mind constantly engaged in remembering Me, undeviated from the path, O Pārtha, is sure to reach Me." .

bg:V307 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V306 ;
    bg:nextVerse bg:V308 ;
    bg:precedes bg:V308 ;
    bg:previousVerse bg:V306 ;
    bg:verseID "V307"^^xsd:string ;
    bg:verseNumber "8.9" ;
    bg:verseText "One should meditate upon the Supreme Person as the one who knows everything, who is the oldest, who is the controller, who is smaller than the smallest, who is the maintainer of everything, who is beyond all material conception, who is inconceivable, and who is always a person. He is luminous like the sun and, being transcendental, is beyond this material nature." .

bg:V308 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V307 ;
    bg:nextVerse bg:V309 ;
    bg:precedes bg:V309 ;
    bg:previousVerse bg:V307 ;
    bg:verseID "V308"^^xsd:string ;
    bg:verseNumber "8.10" ;
    bg:verseText "One who, at the time of death, fixes his life air between the eyebrows and, by the strength of yoga, with an undeviating mind engages himself in remembering the Supreme Lord in full devotion, will certainly attain to the Supreme Personality of Godhead." .

bg:V309 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V308 ;
    bg:nextVerse bg:V310 ;
    bg:precedes bg:V310 ;
    bg:previousVerse bg:V308 ;
    bg:verseID "V309"^^xsd:string ;
    bg:verseNumber "8.11" ;
    bg:verseText "Persons who are learned in the Vedas, who utter the oṁkāra and who are great sages in the renounced order enter into Brahman. Desiring such perfection, one practices celibacy. I shall now briefly explain to you this process by which one may attain salvation." .

bg:V310 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V309 ;
    bg:nextVerse bg:V311 ;
    bg:precedes bg:V311 ;
    bg:previousVerse bg:V309 ;
    bg:verseID "V310"^^xsd:string ;
    bg:verseNumber "8.12" ;
    bg:verseText "The yogic situation is that of detachment from all sensual engagements. Closing all the doors of the senses and fixing the mind on the heart and the life air at the top of the head, one establishes himself in yoga." .

bg:V311 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V310 ;
    bg:nextVerse bg:V312 ;
    bg:precedes bg:V312 ;
    bg:previousVerse bg:V310 ;
    bg:verseID "V311"^^xsd:string ;
    bg:verseNumber "8.13" ;
    bg:verseText "After being situated in this yoga practice and vibrating the sacred syllable oṁ, the supreme combination of letters, if one thinks of the Supreme Personality of Godhead and quits his body, he will certainly reach the spiritual planets." .

bg:V312 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V311 ;
    bg:nextVerse bg:V313 ;
    bg:precedes bg:V313 ;
    bg:previousVerse bg:V311 ;
    bg:verseID "V312"^^xsd:string ;
    bg:verseNumber "8.14" ;
    bg:verseText "For one who always remembers Me without deviation, I am easy to obtain, O son of Pṛthā, because of his constant engagement in devotional service." .

bg:V313 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V312 ;
    bg:nextVerse bg:V314 ;
    bg:precedes bg:V314 ;
    bg:previousVerse bg:V312 ;
    bg:verseID "V313"^^xsd:string ;
    bg:verseNumber "8.15" ;
    bg:verseText "After attaining Me, the great souls, who are yogīs in devotion, never return to this temporary world, which is full of miseries, because they have attained the highest perfection." .

bg:V314 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V313 ;
    bg:nextVerse bg:V315 ;
    bg:precedes bg:V315 ;
    bg:previousVerse bg:V313 ;
    bg:verseID "V314"^^xsd:string ;
    bg:verseNumber "8.16" ;
    bg:verseText "From the highest planet in the material world down to the lowest, all are places of misery wherein repeated birth and death take place. But one who attains to My abode, O son of Kuntī, never takes birth again." .

bg:V315 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V314 ;
    bg:nextVerse bg:V316 ;
    bg:precedes bg:V316 ;
    bg:previousVerse bg:V314 ;
    bg:verseID "V315"^^xsd:string ;
    bg:verseNumber "8.17" ;
    bg:verseText "By human calculation, a thousand ages taken together form the duration of Brahmā's one day. And such also is the duration of his night." .

bg:V316 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V315 ;
    bg:nextVerse bg:V317 ;
    bg:precedes bg:V317 ;
    bg:previousVerse bg:V315 ;
    bg:verseID "V316"^^xsd:string ;
    bg:verseNumber "8.18" ;
    bg:verseText "At the beginning of Brahmā's day, all living entities become manifest from the unmanifest state, and thereafter, when the night falls, they are merged into the unmanifest." .

bg:V317 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V316 ;
    bg:nextVerse bg:V318 ;
    bg:precedes bg:V318 ;
    bg:previousVerse bg:V316 ;
    bg:verseID "V317"^^xsd:string ;
    bg:verseNumber "8.19" ;
    bg:verseText "Again and again, when Brahmā's day arrives, all living entities come into being, and with the arrival of Brahmā's night they are helplessly annihilated." .

bg:V318 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V317 ;
    bg:nextVerse bg:V319 ;
    bg:precedes bg:V319 ;
    bg:previousVerse bg:V317 ;
    bg:verseID "V318"^^xsd:string ;
    bg:verseNumber "8.20" ;
    bg:verseText "Yet there is another unmanifest nature, which is eternal and is transcendental to this manifested and unmanifested matter. It is supreme and is never annihilated. When all in this world is annihilated, that part remains as it is." .

bg:V319 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V318 ;
    bg:nextVerse bg:V320 ;
    bg:precedes bg:V320 ;
    bg:previousVerse bg:V318 ;
    bg:verseID "V319"^^xsd:string ;
    bg:verseNumber "8.21" ;
    bg:verseText "That which the Vedāntists describe as unmanifest and infallible, that which is known as the supreme destination, that place from which, having attained it, one never returns—that is My supreme abode." .

bg:V320 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V319 ;
    bg:nextVerse bg:V321 ;
    bg:precedes bg:V321 ;
    bg:previousVerse bg:V319 ;
    bg:verseID "V320"^^xsd:string ;
    bg:verseNumber "8.22" ;
    bg:verseText "The Supreme Personality of Godhead, who is greater than all, is attainable by unalloyed devotion. Although present in His abode, He is all-pervading, and everything is situated within Him." .

bg:V321 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V320 ;
    bg:nextVerse bg:V322 ;
    bg:precedes bg:V322 ;
    bg:previousVerse bg:V320 ;
    bg:verseID "V321"^^xsd:string ;
    bg:verseNumber "8.23" ;
    bg:verseText "O best of the Bhāratas, I shall now explain to you the different times at which, passing away from this world, the yogī does or does not come back." .

bg:V322 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V321 ;
    bg:nextVerse bg:V323 ;
    bg:precedes bg:V323 ;
    bg:previousVerse bg:V321 ;
    bg:verseID "V322"^^xsd:string ;
    bg:verseNumber "8.24" ;
    bg:verseText "Those who know the Supreme Brahman attain that Supreme by passing away from the world during the influence of the fiery god, in the light, at an auspicious moment of the day, during the fortnight of the waxing moon, or during the six months when the sun travels in the north." .

bg:V323 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V322 ;
    bg:nextVerse bg:V324 ;
    bg:precedes bg:V324 ;
    bg:previousVerse bg:V322 ;
    bg:verseID "V323"^^xsd:string ;
    bg:verseNumber "8.25" ;
    bg:verseText "The mystic who passes away from this world during the smoke, the night, the fortnight of the waning moon, or the six months when the sun passes to the south, reaches the moon planet but again comes back." .

bg:V324 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V323 ;
    bg:nextVerse bg:V325 ;
    bg:precedes bg:V325 ;
    bg:previousVerse bg:V323 ;
    bg:verseID "V324"^^xsd:string ;
    bg:verseNumber "8.26" ;
    bg:verseText "According to the Vedas, there are two ways of passing from this world—one in light and one in darkness. When one passes in light, he does not come back; but when one passes in darkness, he returns." .

bg:V325 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V324 ;
    bg:nextVerse bg:V326 ;
    bg:precedes bg:V326 ;
    bg:previousVerse bg:V324 ;
    bg:verseID "V325"^^xsd:string ;
    bg:verseNumber "8.27" ;
    bg:verseText "Although the devotees know these two paths, O Arjuna, they are never bewildered. Therefore be always fixed in devotion." .

bg:V326 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH08 ;
    bg:follows bg:V325 ;
    bg:nextVerse bg:V327 ;
    bg:precedes bg:V327 ;
    bg:previousVerse bg:V325 ;
    bg:verseID "V326"^^xsd:string ;
    bg:verseNumber "8.28" ;
    bg:verseText "A person who accepts the path of devotional service is not bereft of the results derived from studying the Vedas, performing austere sacrifices, giving charity or pursuing philosophical and fruitive activities. At the end he reaches the supreme abode." .

bg:V327 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V326 ;
    bg:nextVerse bg:V328 ;
    bg:precedes bg:V328 ;
    bg:previousVerse bg:V326 ;
    bg:verseID "V327"^^xsd:string ;
    bg:verseNumber "9.1" ;
    bg:verseText "The Supreme Personality of Godhead said: My dear Arjuna, because you are never envious of Me, I shall impart to you this most confidential knowledge and realization, knowing which you shall be relieved of the miseries of material existence." .

bg:V328 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V327 ;
    bg:nextVerse bg:V329 ;
    bg:precedes bg:V329 ;
    bg:previousVerse bg:V327 ;
    bg:verseID "V328"^^xsd:string ;
    bg:verseNumber "9.2" ;
    bg:verseText "This knowledge is the king of education, the most secret of all secrets. It is the purest knowledge, and because it gives direct perception of the self by realization, it is the perfection of religion. It is everlasting, and it is joyfully performed." .

bg:V329 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V328 ;
    bg:nextVerse bg:V330 ;
    bg:precedes bg:V330 ;
    bg:previousVerse bg:V328 ;
    bg:verseID "V329"^^xsd:string ;
    bg:verseNumber "9.3" ;
    bg:verseText "Those who are not faithful in this devotional service cannot attain Me, O conqueror of enemies. Therefore they return to the path of birth and death in this material world." .

bg:V330 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V329 ;
    bg:nextVerse bg:V331 ;
    bg:precedes bg:V331 ;
    bg:previousVerse bg:V329 ;
    bg:verseID "V330"^^xsd:string ;
    bg:verseNumber "9.4" ;
    bg:verseText "By Me, in My unmanifested form, this entire universe is pervaded. All beings are in Me, but I am not in them." .

bg:V331 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V330 ;
    bg:nextVerse bg:V332 ;
    bg:precedes bg:V332 ;
    bg:previousVerse bg:V330 ;
    bg:verseID "V331"^^xsd:string ;
    bg:verseNumber "9.5" ;
    bg:verseText "And yet everything that is created does not rest in Me. Behold My mystic opulence! Although I am the maintainer of all living entities and although I am everywhere, I am not a part of this cosmic manifestation, for My Self is the very source of creation." .

bg:V332 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V331 ;
    bg:nextVerse bg:V333 ;
    bg:precedes bg:V333 ;
    bg:previousVerse bg:V331 ;
    bg:verseID "V332"^^xsd:string ;
    bg:verseNumber "9.6" ;
    bg:verseText "Understand that as the mighty wind, blowing everywhere, rests always in the sky, all created beings rest in Me." .

bg:V333 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V332 ;
    bg:nextVerse bg:V334 ;
    bg:precedes bg:V334 ;
    bg:previousVerse bg:V332 ;
    bg:verseID "V333"^^xsd:string ;
    bg:verseNumber "9.7" ;
    bg:verseText "O son of Kuntī, at the end of the millennium all material manifestations enter into My nature, and at the beginning of another millennium, by My potency, I create them again." .

bg:V334 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V333 ;
    bg:nextVerse bg:V335 ;
    bg:precedes bg:V335 ;
    bg:previousVerse bg:V333 ;
    bg:verseID "V334"^^xsd:string ;
    bg:verseNumber "9.8" ;
    bg:verseText "The whole cosmic order is under Me. Under My will it is automatically manifested again and again, and under My will it is annihilated at the end." .

bg:V335 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V334 ;
    bg:nextVerse bg:V336 ;
    bg:precedes bg:V336 ;
    bg:previousVerse bg:V334 ;
    bg:verseID "V335"^^xsd:string ;
    bg:verseNumber "9.9" ;
    bg:verseText "O Dhanañjaya, all this work cannot bind Me. I am ever detached from all these material activities, seated as though neutral." .

bg:V336 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V335 ;
    bg:nextVerse bg:V337 ;
    bg:precedes bg:V337 ;
    bg:previousVerse bg:V335 ;
    bg:verseID "V336"^^xsd:string ;
    bg:verseNumber "9.10" ;
    bg:verseText "This material nature, which is one of My energies, is working under My direction, O son of Kuntī, producing all moving and nonmoving beings. Under its rule this manifestation is created and annihilated again and again." .

bg:V337 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V336 ;
    bg:nextVerse bg:V338 ;
    bg:precedes bg:V338 ;
    bg:previousVerse bg:V336 ;
    bg:verseID "V337"^^xsd:string ;
    bg:verseNumber "9.11" ;
    bg:verseText "Fools deride Me when I descend in the human form. They do not know My transcendental nature as the Supreme Lord of all that be." .

bg:V338 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V337 ;
    bg:nextVerse bg:V339 ;
    bg:precedes bg:V339 ;
    bg:previousVerse bg:V337 ;
    bg:verseID "V338"^^xsd:string ;
    bg:verseNumber "9.12" ;
    bg:verseText "Those who are thus bewildered are attracted by demonic and atheistic views. In that deluded condition, their hopes for liberation, their fruitive activities, and their culture of knowledge are all defeated." .

bg:V339 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V338 ;
    bg:nextVerse bg:V340 ;
    bg:precedes bg:V340 ;
    bg:previousVerse bg:V338 ;
    bg:verseID "V339"^^xsd:string ;
    bg:verseNumber "9.13" ;
    bg:verseText "O son of Pṛthā, those who are not deluded, the great souls, are under the protection of the divine nature. They are fully engaged in devotional service because they know Me as the Supreme Personality of Godhead, original and inexhaustible." .

bg:V340 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V339 ;
    bg:nextVerse bg:V341 ;
    bg:precedes bg:V341 ;
    bg:previousVerse bg:V339 ;
    bg:verseID "V340"^^xsd:string ;
    bg:verseNumber "9.14" ;
    bg:verseText "Always chanting My glories, endeavoring with great determination, bowing down before Me, these great souls perpetually worship Me with devotion." .

bg:V341 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V340 ;
    bg:nextVerse bg:V342 ;
    bg:precedes bg:V342 ;
    bg:previousVerse bg:V340 ;
    bg:verseID "V341"^^xsd:string ;
    bg:verseNumber "9.15" ;
    bg:verseText "Others, who engage in sacrifice by the cultivation of knowledge, worship the Supreme Lord as the one without a second, as diverse in many, and in the universal form." .

bg:V342 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V341 ;
    bg:nextVerse bg:V343 ;
    bg:precedes bg:V343 ;
    bg:previousVerse bg:V341 ;
    bg:verseID "V342"^^xsd:string ;
    bg:verseNumber "9.16" ;
    bg:verseText "But it is I who am the ritual, I the sacrifice, the offering to the ancestors, the healing herb, the transcendental chant. I am the butter and the fire and the offering." .

bg:V343 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V342 ;
    bg:nextVerse bg:V344 ;
    bg:precedes bg:V344 ;
    bg:previousVerse bg:V342 ;
    bg:verseID "V343"^^xsd:string ;
    bg:verseNumber "9.17" ;
    bg:verseText "I am the father of this universe, the mother, the support and the grandsire. I am the object of knowledge, the purifier and the syllable oṁ. I am also the Ṛg, the Sāma and the Yajur Vedas." .

bg:V344 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V343 ;
    bg:nextVerse bg:V345 ;
    bg:precedes bg:V345 ;
    bg:previousVerse bg:V343 ;
    bg:verseID "V344"^^xsd:string ;
    bg:verseNumber "9.18" ;
    bg:verseText "I am the goal, the sustainer, the master, the witness, the abode, the refuge and the most dear friend. I am the creation and the annihilation, the basis of everything, the resting place and the eternal seed." .

bg:V345 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V344 ;
    bg:nextVerse bg:V346 ;
    bg:precedes bg:V346 ;
    bg:previousVerse bg:V344 ;
    bg:verseID "V345"^^xsd:string ;
    bg:verseNumber "9.19" ;
    bg:verseText "O Arjuna, I give heat, and I withhold and send forth the rain. I am immortality, and I am also death personified. Both spirit and matter are in Me." .

bg:V346 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V345 ;
    bg:nextVerse bg:V347 ;
    bg:precedes bg:V347 ;
    bg:previousVerse bg:V345 ;
    bg:verseID "V346"^^xsd:string ;
    bg:verseNumber "9.20" ;
    bg:verseText "Those who study the Vedas and drink the soma juice, seeking the heavenly planets, worship Me indirectly. Purified of sinful reactions, they take birth on the pious, heavenly planet of Indra, where they enjoy godly delights." .

bg:V347 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V346 ;
    bg:nextVerse bg:V348 ;
    bg:precedes bg:V348 ;
    bg:previousVerse bg:V346 ;
    bg:verseID "V347"^^xsd:string ;
    bg:verseNumber "9.21" ;
    bg:verseText "When they have thus enjoyed vast heavenly sense pleasure and the results of their pious activities are exhausted, they return to this mortal planet again. Thus those who seek sense enjoyment by adhering to the principles of the three Vedas achieve only repeated birth and death." .

bg:V348 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V347 ;
    bg:nextVerse bg:V349 ;
    bg:precedes bg:V349 ;
    bg:previousVerse bg:V347 ;
    bg:verseID "V348"^^xsd:string ;
    bg:verseNumber "9.22" ;
    bg:verseText "But those who always worship Me with exclusive devotion, meditating on My transcendental form—to them I carry what they lack, and I preserve what they have." .

bg:V349 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V348 ;
    bg:nextVerse bg:V350 ;
    bg:precedes bg:V350 ;
    bg:previousVerse bg:V348 ;
    bg:verseID "V349"^^xsd:string ;
    bg:verseNumber "9.23" ;
    bg:verseText "Those who are devotees of other gods and who worship them with faith actually worship only Me, O son of Kuntī, but they do so in a wrong way." .

bg:V350 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V349 ;
    bg:nextVerse bg:V351 ;
    bg:precedes bg:V351 ;
    bg:previousVerse bg:V349 ;
    bg:verseID "V350"^^xsd:string ;
    bg:verseNumber "9.24" ;
    bg:verseText "I am the only enjoyer and master of all sacrifices. Therefore, those who do not recognize My true transcendental nature fall down." .

bg:V351 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V350 ;
    bg:nextVerse bg:V352 ;
    bg:precedes bg:V352 ;
    bg:previousVerse bg:V350 ;
    bg:verseID "V351"^^xsd:string ;
    bg:verseNumber "9.25" ;
    bg:verseText "Those who worship the demigods will take birth among the demigods; those who worship the ancestors go to the ancestors; those who worship ghosts and spirits will take birth among such beings; and those who worship Me will live with Me." .

bg:V352 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V351 ;
    bg:nextVerse bg:V353 ;
    bg:precedes bg:V353 ;
    bg:previousVerse bg:V351 ;
    bg:verseID "V352"^^xsd:string ;
    bg:verseNumber "9.26" ;
    bg:verseText "If one offers Me with love and devotion a leaf, a flower, a fruit or water, I will accept it." .

bg:V353 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V352 ;
    bg:nextVerse bg:V354 ;
    bg:precedes bg:V354 ;
    bg:previousVerse bg:V352 ;
    bg:verseID "V353"^^xsd:string ;
    bg:verseNumber "9.27" ;
    bg:verseText "Whatever you do, whatever you eat, whatever you offer or give away, and whatever austerities you perform—do that, O son of Kuntī, as an offering to Me." .

bg:V354 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V353 ;
    bg:nextVerse bg:V355 ;
    bg:precedes bg:V355 ;
    bg:previousVerse bg:V353 ;
    bg:verseID "V354"^^xsd:string ;
    bg:verseNumber "9.28" ;
    bg:verseText "In this way you will be freed from bondage to work and its auspicious and inauspicious results. With your mind fixed on Me in this principle of renunciation, you will be liberated and come to Me." .

bg:V355 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V354 ;
    bg:nextVerse bg:V356 ;
    bg:precedes bg:V356 ;
    bg:previousVerse bg:V354 ;
    bg:verseID "V355"^^xsd:string ;
    bg:verseNumber "9.29" ;
    bg:verseText "I envy no one, nor am I partial to anyone. I am equal to all. But whoever renders service unto Me in devotion is a friend, is in Me, and I am also a friend to him." .

bg:V356 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V355 ;
    bg:nextVerse bg:V357 ;
    bg:precedes bg:V357 ;
    bg:previousVerse bg:V355 ;
    bg:verseID "V356"^^xsd:string ;
    bg:verseNumber "9.30" ;
    bg:verseText "Even if one commits the most abominable action, if he is engaged in devotional service he is to be considered saintly because he is properly situated in his determination." .

bg:V357 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V356 ;
    bg:nextVerse bg:V358 ;
    bg:precedes bg:V358 ;
    bg:previousVerse bg:V356 ;
    bg:verseID "V357"^^xsd:string ;
    bg:verseNumber "9.31" ;
    bg:verseText "He quickly becomes righteous and attains lasting peace. O son of Kuntī, declare it boldly that My devotee never perishes." .

bg:V358 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V357 ;
    bg:nextVerse bg:V359 ;
    bg:precedes bg:V359 ;
    bg:previousVerse bg:V357 ;
    bg:verseID "V358"^^xsd:string ;
    bg:verseNumber "9.32" ;
    bg:verseText "O son of Pṛthā, those who take shelter in Me, though they be of lower birth—women, vaiśyas [merchants] and śūdras [workers]—can attain the supreme destination." .

bg:V359 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V358 ;
    bg:nextVerse bg:V360 ;
    bg:precedes bg:V360 ;
    bg:previousVerse bg:V358 ;
    bg:verseID "V359"^^xsd:string ;
    bg:verseNumber "9.33" ;
    bg:verseText "How much more this is so of the righteous brāhmaṇas, the devotees and the saintly kings. Therefore, having come to this temporary, miserable world, engage in loving service unto Me." .

bg:V360 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH09 ;
    bg:follows bg:V359 ;
    bg:nextVerse bg:V361 ;
    bg:precedes bg:V361 ;
    bg:previousVerse bg:V359 ;
    bg:verseID "V360"^^xsd:string ;
    bg:verseNumber "9.34" ;
    bg:verseText "Engage your mind always in thinking of Me, become My devotee, offer obeisances to Me and worship Me. Being completely absorbed in Me, surely you will come to Me." .

bg:V361 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V360 ;
    bg:nextVerse bg:V362 ;
    bg:precedes bg:V362 ;
    bg:previousVerse bg:V360 ;
    bg:verseID "V361"^^xsd:string ;
    bg:verseNumber "10.1" ;
    bg:verseText "The Supreme Personality of Godhead said: Again hear, O mighty-armed Arjuna. Because you are My dear friend, for your benefit I shall speak to you further, giving knowledge that is better than what I have already explained." .

bg:V362 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V361 ;
    bg:nextVerse bg:V363 ;
    bg:precedes bg:V363 ;
    bg:previousVerse bg:V361 ;
    bg:verseID "V362"^^xsd:string ;
    bg:verseNumber "10.2" ;
    bg:verseText "Neither the hosts of demigods nor the great sages know My origin or opulences, for, in every respect, I am the source of the demigods and sages." .

bg:V363 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V362 ;
    bg:nextVerse bg:V364 ;
    bg:precedes bg:V364 ;
    bg:previousVerse bg:V362 ;
    bg:verseID "V363"^^xsd:string ;
    bg:verseNumber "10.3" ;
    bg:verseText "He who knows Me as the unborn, as the beginningless, as the Supreme Lord of all the worlds—he only, undeluded among men, is freed from all sins." .

bg:V364 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V363 ;
    bg:nextVerse bg:V365 ;
    bg:precedes bg:V365 ;
    bg:previousVerse bg:V363 ;
    bg:verseID "V364"^^xsd:string ;
    bg:verseNumber "10.4" ;
    bg:verseText "Intelligence, knowledge, freedom from doubt and delusion, forgiveness, truthfulness, control of the senses, control of the mind, happiness and distress, birth, death, fear, fearlessness." .

bg:V365 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V364 ;
    bg:nextVerse bg:V366 ;
    bg:precedes bg:V366 ;
    bg:previousVerse bg:V364 ;
    bg:verseID "V365"^^xsd:string ;
    bg:verseNumber "10.5" ;
    bg:verseText "Nonviolence, equanimity, satisfaction, austerity, charity, fame and infamy—all these various qualities of living beings are created by Me alone." .

bg:V366 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V365 ;
    bg:nextVerse bg:V367 ;
    bg:precedes bg:V367 ;
    bg:previousVerse bg:V365 ;
    bg:verseID "V366"^^xsd:string ;
    bg:verseNumber "10.6" ;
    bg:verseText "The seven great sages and before them the four other great sages and the Manus come from Me, born from My mind, and all the living beings populating the various planets descend from them." .

bg:V367 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V366 ;
    bg:nextVerse bg:V368 ;
    bg:precedes bg:V368 ;
    bg:previousVerse bg:V366 ;
    bg:verseID "V367"^^xsd:string ;
    bg:verseNumber "10.7" ;
    bg:verseText "One who is factually convinced of this opulence and mystic power of Mine engages in unalloyed devotional service; of this there is no doubt." .

bg:V368 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V367 ;
    bg:nextVerse bg:V369 ;
    bg:precedes bg:V369 ;
    bg:previousVerse bg:V367 ;
    bg:verseID "V368"^^xsd:string ;
    bg:verseNumber "10.8" ;
    bg:verseText "I am the source of all spiritual and material worlds. Everything emanates from Me. The wise who perfectly know this engage in My devotional service and worship Me with all their hearts." .

bg:V369 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V368 ;
    bg:nextVerse bg:V370 ;
    bg:precedes bg:V370 ;
    bg:previousVerse bg:V368 ;
    bg:verseID "V369"^^xsd:string ;
    bg:verseNumber "10.9" ;
    bg:verseText "The thoughts of My pure devotees dwell in Me, their lives are fully devoted to My service, and they derive great satisfaction and bliss from always enlightening one another and conversing about Me." .

bg:V370 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V369 ;
    bg:nextVerse bg:V371 ;
    bg:precedes bg:V371 ;
    bg:previousVerse bg:V369 ;
    bg:verseID "V370"^^xsd:string ;
    bg:verseNumber "10.10" ;
    bg:verseText "To those who are constantly devoted to serving Me with love, I give the understanding by which they can come to Me." .

bg:V371 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V370 ;
    bg:nextVerse bg:V372 ;
    bg:precedes bg:V372 ;
    bg:previousVerse bg:V370 ;
    bg:verseID "V371"^^xsd:string ;
    bg:verseNumber "10.11" ;
    bg:verseText "To show them special mercy, I, dwelling in their hearts, destroy with the shining lamp of knowledge the darkness born of ignorance." .

bg:V372 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V371 ;
    bg:nextVerse bg:V373 ;
    bg:precedes bg:V373 ;
    bg:previousVerse bg:V371 ;
    bg:verseID "V372"^^xsd:string ;
    bg:verseNumber "10.12" ;
    bg:verseText "Arjuna said: You are the Supreme Personality of Godhead, the ultimate abode, the purest, the Absolute Truth. You are the eternal, transcendental, original person, the unborn, the greatest." .

bg:V373 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V372 ;
    bg:nextVerse bg:V374 ;
    bg:precedes bg:V374 ;
    bg:previousVerse bg:V372 ;
    bg:verseID "V373"^^xsd:string ;
    bg:verseNumber "10.13" ;
    bg:verseText "All the great sages—Nārada, Asita, Devala and Vyāsa—confirm this truth about You. And now You Yourself are declaring it to me." .

bg:V374 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V373 ;
    bg:nextVerse bg:V375 ;
    bg:precedes bg:V375 ;
    bg:previousVerse bg:V373 ;
    bg:verseID "V374"^^xsd:string ;
    bg:verseNumber "10.14" ;
    bg:verseText "O Kṛṣṇa, I totally accept as truth all that You have told me. Neither the demigods nor the demons, O Lord, can understand Your personality." .

bg:V375 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V374 ;
    bg:nextVerse bg:V376 ;
    bg:precedes bg:V376 ;
    bg:previousVerse bg:V374 ;
    bg:verseID "V375"^^xsd:string ;
    bg:verseNumber "10.15" ;
    bg:verseText "Indeed, You alone know Yourself by Your own internal potency, O Supreme Person, origin of all, Lord of all beings, God of gods, Lord of the universe." .

bg:V376 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V375 ;
    bg:nextVerse bg:V377 ;
    bg:precedes bg:V377 ;
    bg:previousVerse bg:V375 ;
    bg:verseID "V376"^^xsd:string ;
    bg:verseNumber "10.16" ;
    bg:verseText "Please tell me in detail of Your divine opulences by which You pervade all these worlds and abide in them." .

bg:V377 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V376 ;
    bg:nextVerse bg:V378 ;
    bg:precedes bg:V378 ;
    bg:previousVerse bg:V376 ;
    bg:verseID "V377"^^xsd:string ;
    bg:verseNumber "10.17" ;
    bg:verseText "O Kṛṣṇa, O supreme mystic, how shall I constantly think of You, and how shall I know You? In what various forms are You to be remembered, O Supreme Personality of Godhead?" .

bg:V378 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V377 ;
    bg:nextVerse bg:V379 ;
    bg:precedes bg:V379 ;
    bg:previousVerse bg:V377 ;
    bg:verseID "V378"^^xsd:string ;
    bg:verseNumber "10.18" ;
    bg:verseText "O Janārdana, again please describe in detail the mystic power of Your opulences. I am never satiated in hearing about You, for the more I hear the more I want to taste the nectar of Your words." .

bg:V379 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V378 ;
    bg:nextVerse bg:V380 ;
    bg:precedes bg:V380 ;
    bg:previousVerse bg:V378 ;
    bg:verseID "V379"^^xsd:string ;
    bg:verseNumber "10.19" ;
    bg:verseText "The Supreme Personality of Godhead said: Yes, I will tell you of My splendorous manifestations, but only of those which are prominent, O Arjuna, for My opulence is limitless." .

bg:V380 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V379 ;
    bg:nextVerse bg:V381 ;
    bg:precedes bg:V381 ;
    bg:previousVerse bg:V379 ;
    bg:verseID "V380"^^xsd:string ;
    bg:verseNumber "10.20" ;
    bg:verseText "I am the Supersoul, O Arjuna, seated in the hearts of all living entities. I am the beginning, the middle and the end of all beings." .

bg:V381 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V380 ;
    bg:nextVerse bg:V382 ;
    bg:precedes bg:V382 ;
    bg:previousVerse bg:V380 ;
    bg:verseID "V381"^^xsd:string ;
    bg:verseNumber "10.21" ;
    bg:verseText "Of the Ādityas I am Viṣṇu, of lights I am the radiant sun, of the Maruts I am Marīci, and among the stars I am the moon." .

bg:V382 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V381 ;
    bg:nextVerse bg:V383 ;
    bg:precedes bg:V383 ;
    bg:previousVerse bg:V381 ;
    bg:verseID "V382"^^xsd:string ;
    bg:verseNumber "10.22" ;
    bg:verseText "Of the Vedas I am the Sāma Veda; of the demigods I am Indra, the king of heaven; of the senses I am the mind; and in living beings I am the living force [consciousness]." .

bg:V383 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V382 ;
    bg:nextVerse bg:V384 ;
    bg:precedes bg:V384 ;
    bg:previousVerse bg:V382 ;
    bg:verseID "V383"^^xsd:string ;
    bg:verseNumber "10.23" ;
    bg:verseText "Of all the Rudras I am Lord Śiva; of the Yakṣas and Rākṣasas I am the Lord of wealth (Kuvera); of the Vasus I am fire (Agni); and of mountains I am Meru." .

bg:V384 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V383 ;
    bg:nextVerse bg:V385 ;
    bg:precedes bg:V385 ;
    bg:previousVerse bg:V383 ;
    bg:verseID "V384"^^xsd:string ;
    bg:verseNumber "10.24" ;
    bg:verseText "Of priests, O Arjuna, know Me to be the chief, Bṛhaspati. Of generals I am Kārttikeya, and of bodies of water I am the ocean." .

bg:V385 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V384 ;
    bg:nextVerse bg:V386 ;
    bg:precedes bg:V386 ;
    bg:previousVerse bg:V384 ;
    bg:verseID "V385"^^xsd:string ;
    bg:verseNumber "10.25" ;
    bg:verseText "Of the great sages I am Bhṛgu; of vibrations I am the transcendental oṁ; of sacrifices I am the chanting of the holy names [japa]; and of immovable things I am the Himālayas." .

bg:V386 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V385 ;
    bg:nextVerse bg:V387 ;
    bg:precedes bg:V387 ;
    bg:previousVerse bg:V385 ;
    bg:verseID "V386"^^xsd:string ;
    bg:verseNumber "10.26" ;
    bg:verseText "Of all trees I am the banyan tree, and of the sages among the demigods I am Nārada. Of the Gandharvas I am Citraratha, and among perfected beings I am the sage Kapila." .

bg:V387 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V386 ;
    bg:nextVerse bg:V388 ;
    bg:precedes bg:V388 ;
    bg:previousVerse bg:V386 ;
    bg:verseID "V387"^^xsd:string ;
    bg:verseNumber "10.27" ;
    bg:verseText "Of horses know Me to be Uccaiḥśravā, produced during the churning of the ocean for nectar. Of lordly elephants I am Airāvata, and among men I am the monarch." .

bg:V388 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V387 ;
    bg:nextVerse bg:V389 ;
    bg:precedes bg:V389 ;
    bg:previousVerse bg:V387 ;
    bg:verseID "V388"^^xsd:string ;
    bg:verseNumber "10.28" ;
    bg:verseText "Of weapons I am the thunderbolt; among cows I am the surabhi. Of causes for procreation I am Kandarpa, the god of love, and of serpents I am Vāsuki." .

bg:V389 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V388 ;
    bg:nextVerse bg:V390 ;
    bg:precedes bg:V390 ;
    bg:previousVerse bg:V388 ;
    bg:verseID "V389"^^xsd:string ;
    bg:verseNumber "10.29" ;
    bg:verseText "Of the many-hooded Nāgas I am Ananta; among the aquatics I am the demigod Varuṇa. Of departed ancestors I am Aryamā, and among the dispensers of law I am Yama, lord of death." .

bg:V390 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V389 ;
    bg:nextVerse bg:V391 ;
    bg:precedes bg:V391 ;
    bg:previousVerse bg:V389 ;
    bg:verseID "V390"^^xsd:string ;
    bg:verseNumber "10.30" ;
    bg:verseText "Among the Daitya demons I am the devoted Prahlāda. Among subduers I am time; among beasts I am the lion; and among birds I am Garuḍa." .

bg:V391 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V390 ;
    bg:nextVerse bg:V392 ;
    bg:precedes bg:V392 ;
    bg:previousVerse bg:V390 ;
    bg:verseID "V391"^^xsd:string ;
    bg:verseNumber "10.31" ;
    bg:verseText "Of purifiers I am the wind; of the wielders of weapons I am Rāma; of fishes I am the shark; and of flowing rivers I am the Ganges." .

bg:V392 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V391 ;
    bg:nextVerse bg:V393 ;
    bg:precedes bg:V393 ;
    bg:previousVerse bg:V391 ;
    bg:verseID "V392"^^xsd:string ;
    bg:verseNumber "10.32" ;
    bg:verseText "Of all creations I am the beginning and the end and also the middle, O Arjuna. Of all sciences I am the spiritual science of the self, and among logicians I am the conclusive truth." .

bg:V393 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V392 ;
    bg:nextVerse bg:V394 ;
    bg:precedes bg:V394 ;
    bg:previousVerse bg:V392 ;
    bg:verseID "V393"^^xsd:string ;
    bg:verseNumber "10.33" ;
    bg:verseText "Of letters I am the letter A, and among compound words I am the dual compound. I am also inexhaustible time, and of creators I am Brahmā." .

bg:V394 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V393 ;
    bg:nextVerse bg:V395 ;
    bg:precedes bg:V395 ;
    bg:previousVerse bg:V393 ;
    bg:verseID "V394"^^xsd:string ;
    bg:verseNumber "10.34" ;
    bg:verseText "I am all-devouring death, and I am the generating principle of all that is yet to be. Among women I am fame, fortune, fine speech, memory, intelligence, steadfastness and patience." .

bg:V395 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V394 ;
    bg:nextVerse bg:V396 ;
    bg:precedes bg:V396 ;
    bg:previousVerse bg:V394 ;
    bg:verseID "V395"^^xsd:string ;
    bg:verseNumber "10.35" ;
    bg:verseText "Of the hymns in the Sāma Veda I am the Bṛhat-sāma. Of poetry I am the Gāyatrī. Of months I am Mārgaśīrṣa [November-December], and of seasons I am flower-bearing spring." .

bg:V396 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V395 ;
    bg:nextVerse bg:V397 ;
    bg:precedes bg:V397 ;
    bg:previousVerse bg:V395 ;
    bg:verseID "V396"^^xsd:string ;
    bg:verseNumber "10.36" ;
    bg:verseText "I am also the gambling of cheats, and of the splendid I am the splendor. I am victory, I am adventure, and I am the strength of the strong." .

bg:V397 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V396 ;
    bg:nextVerse bg:V398 ;
    bg:precedes bg:V398 ;
    bg:previousVerse bg:V396 ;
    bg:verseID "V397"^^xsd:string ;
    bg:verseNumber "10.37" ;
    bg:verseText "Of the descendants of Vṛṣṇi I am Vāsudeva, and of the Pāṇḍavas I am Arjuna. Of the sages I am Vyāsa, and among great thinkers I am Uśanā." .

bg:V398 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V397 ;
    bg:nextVerse bg:V399 ;
    bg:precedes bg:V399 ;
    bg:previousVerse bg:V397 ;
    bg:verseID "V398"^^xsd:string ;
    bg:verseNumber "10.38" ;
    bg:verseText "Among all means of suppressing lawlessness I am punishment, and of those who seek victory I am morality. Of secret things I am silence, and of the wise I am wisdom." .

bg:V399 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V398 ;
    bg:nextVerse bg:V400 ;
    bg:precedes bg:V400 ;
    bg:previousVerse bg:V398 ;
    bg:verseID "V399"^^xsd:string ;
    bg:verseNumber "10.39" ;
    bg:verseText "Furthermore, O Arjuna, I am the generating seed of all existences. There is no being—moving or nonmoving—that can exist without Me." .

bg:V400 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V399 ;
    bg:nextVerse bg:V401 ;
    bg:precedes bg:V401 ;
    bg:previousVerse bg:V399 ;
    bg:verseID "V400"^^xsd:string ;
    bg:verseNumber "10.40" ;
    bg:verseText "O mighty conqueror of enemies, there is no end to My divine manifestations. What I have spoken to you is but a mere indication of My infinite opulences." .

bg:V401 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V400 ;
    bg:nextVerse bg:V402 ;
    bg:precedes bg:V402 ;
    bg:previousVerse bg:V400 ;
    bg:verseID "V401"^^xsd:string ;
    bg:verseNumber "10.41" ;
    bg:verseText "Know that all opulent, beautiful and glorious creations spring from but a spark of My splendor." .

bg:V402 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH10 ;
    bg:follows bg:V401 ;
    bg:nextVerse bg:V403 ;
    bg:precedes bg:V403 ;
    bg:previousVerse bg:V401 ;
    bg:verseID "V402"^^xsd:string ;
    bg:verseNumber "10.42" ;
    bg:verseText "But what need is there, Arjuna, for all this detailed knowledge? With a single fragment of Myself I pervade and support this entire universe." .

bg:V403 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V402 ;
    bg:nextVerse bg:V404 ;
    bg:precedes bg:V404 ;
    bg:previousVerse bg:V402 ;
    bg:verseID "V403"^^xsd:string ;
    bg:verseNumber "11.1" ;
    bg:verseText "Arjuna said: By my hearing the instructions You have kindly given me about these most confidential spiritual subjects, my illusion has now been dispelled." .

bg:V404 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V403 ;
    bg:nextVerse bg:V405 ;
    bg:precedes bg:V405 ;
    bg:previousVerse bg:V403 ;
    bg:verseID "V404"^^xsd:string ;
    bg:verseNumber "11.2" ;
    bg:verseText "O lotus-eyed one, I have heard from You in detail about the appearance and disappearance of every living entity and have realized Your inexhaustible glories." .

bg:V405 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V404 ;
    bg:nextVerse bg:V406 ;
    bg:precedes bg:V406 ;
    bg:previousVerse bg:V404 ;
    bg:verseID "V405"^^xsd:string ;
    bg:verseNumber "11.3" ;
    bg:verseText "O greatest of all personalities, O supreme form, though I see You here before me in Your actual position, as You have described Yourself, I wish to see how You have entered into this cosmic manifestation. I want to see that form of Yours." .

bg:V406 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V405 ;
    bg:nextVerse bg:V407 ;
    bg:precedes bg:V407 ;
    bg:previousVerse bg:V405 ;
    bg:verseID "V406"^^xsd:string ;
    bg:verseNumber "11.4" ;
    bg:verseText "If You think that I am able to behold Your cosmic form, O my Lord, O master of all mystic power, then kindly show me that unlimited universal Self." .

bg:V407 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V406 ;
    bg:nextVerse bg:V408 ;
    bg:precedes bg:V408 ;
    bg:previousVerse bg:V406 ;
    bg:verseID "V407"^^xsd:string ;
    bg:verseNumber "11.5" ;
    bg:verseText "The Supreme Personality of Godhead said: My dear Arjuna, O son of Pṛthā, see now My opulences, hundreds of thousands of varied divine and multicolored forms." .

bg:V408 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V407 ;
    bg:nextVerse bg:V409 ;
    bg:precedes bg:V409 ;
    bg:previousVerse bg:V407 ;
    bg:verseID "V408"^^xsd:string ;
    bg:verseNumber "11.6" ;
    bg:verseText "O best of the Bhāratas, see here the different manifestations of Ādityas, Vasus, Rudras, Aśvinī-kumāras and all the other demigods. Behold the many wonderful things which no one has ever seen or heard of before." .

bg:V409 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V408 ;
    bg:nextVerse bg:V410 ;
    bg:precedes bg:V410 ;
    bg:previousVerse bg:V408 ;
    bg:verseID "V409"^^xsd:string ;
    bg:verseNumber "11.7" ;
    bg:verseText "O Arjuna, whatever you wish to see, behold at once in this body of Mine! This universal form can show you whatever you now desire to see and whatever you may want to see in the future. Everything—moving and nonmoving—is here completely, in one place." .

bg:V410 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V409 ;
    bg:nextVerse bg:V411 ;
    bg:precedes bg:V411 ;
    bg:previousVerse bg:V409 ;
    bg:verseID "V410"^^xsd:string ;
    bg:verseNumber "11.8" ;
    bg:verseText "But you cannot see Me with your present eyes. Therefore I give you divine eyes. Behold My mystic opulence!" .

bg:V411 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V410 ;
    bg:nextVerse bg:V412 ;
    bg:precedes bg:V412 ;
    bg:previousVerse bg:V410 ;
    bg:verseID "V411"^^xsd:string ;
    bg:verseNumber "11.9" ;
    bg:verseText "Sañjaya said: O King, having spoken thus, the Supreme Lord of all mystic power, the Personality of Godhead, displayed His universal form to Arjuna." .

bg:V412 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V411 ;
    bg:nextVerse bg:V413 ;
    bg:precedes bg:V413 ;
    bg:previousVerse bg:V411 ;
    bg:verseID "V412"^^xsd:string ;
    bg:verseNumber "11.10–11" ;
    bg:verseText "Arjuna saw in that universal form unlimited mouths, unlimited eyes, unlimited wonderful visions. The form was decorated with many celestial ornaments and bore many divine upraised weapons. He wore celestial garlands and garments, and many divine scents were smeared over His body. All was wondrous, brilliant, unlimited, all-expanding." .

bg:V413 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V412 ;
    bg:nextVerse bg:V414 ;
    bg:precedes bg:V414 ;
    bg:previousVerse bg:V412 ;
    bg:verseID "V413"^^xsd:string ;
    bg:verseNumber "11.12" ;
    bg:verseText "If hundreds of thousands of suns were to rise at once into the sky, their radiance might resemble the effulgence of the Supreme Person in that universal form." .

bg:V414 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V413 ;
    bg:nextVerse bg:V415 ;
    bg:precedes bg:V415 ;
    bg:previousVerse bg:V413 ;
    bg:verseID "V414"^^xsd:string ;
    bg:verseNumber "11.13" ;
    bg:verseText "At that time Arjuna could see in the universal form of the Lord the unlimited expansions of the universe situated in one place although divided into many, many thousands." .

bg:V415 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V414 ;
    bg:nextVerse bg:V416 ;
    bg:precedes bg:V416 ;
    bg:previousVerse bg:V414 ;
    bg:verseID "V415"^^xsd:string ;
    bg:verseNumber "11.14" ;
    bg:verseText "Then, bewildered and astonished, his hair standing on end, Arjuna bowed his head to offer obeisances and with folded hands began to pray to the Supreme Lord." .

bg:V416 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V415 ;
    bg:nextVerse bg:V417 ;
    bg:precedes bg:V417 ;
    bg:previousVerse bg:V415 ;
    bg:verseID "V416"^^xsd:string ;
    bg:verseNumber "11.15" ;
    bg:verseText "Arjuna said: My dear Lord Kṛṣṇa, I see assembled in Your body all the demigods and various other living entities. I see Brahmā sitting on the lotus flower, as well as Lord Śiva and all the sages and divine serpents." .

bg:V417 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V416 ;
    bg:nextVerse bg:V418 ;
    bg:precedes bg:V418 ;
    bg:previousVerse bg:V416 ;
    bg:verseID "V417"^^xsd:string ;
    bg:verseNumber "11.16" ;
    bg:verseText "O Lord of the universe, O universal form, I see in Your body many, many arms, bellies, mouths and eyes, expanded everywhere, without limit. I see in You no end, no middle and no beginning." .

bg:V418 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V417 ;
    bg:nextVerse bg:V419 ;
    bg:precedes bg:V419 ;
    bg:previousVerse bg:V417 ;
    bg:verseID "V418"^^xsd:string ;
    bg:verseNumber "11.17" ;
    bg:verseText "Your form is difficult to see because of its glaring effulgence, spreading on all sides, like blazing fire or the immeasurable radiance of the sun. Yet I see this glowing form everywhere, adorned with various crowns, clubs and discs." .

bg:V419 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V418 ;
    bg:nextVerse bg:V420 ;
    bg:precedes bg:V420 ;
    bg:previousVerse bg:V418 ;
    bg:verseID "V419"^^xsd:string ;
    bg:verseNumber "11.18" ;
    bg:verseText "You are the supreme primal objective. You are the ultimate resting place of all this universe. You are inexhaustible, and You are the oldest. You are the maintainer of the eternal religion, the Personality of Godhead. This is my opinion." .

bg:V420 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V419 ;
    bg:nextVerse bg:V421 ;
    bg:precedes bg:V421 ;
    bg:previousVerse bg:V419 ;
    bg:verseID "V420"^^xsd:string ;
    bg:verseNumber "11.19" ;
    bg:verseText "You are without origin, middle or end. Your glory is unlimited. You have numberless arms, and the sun and moon are Your eyes. I see You with blazing fire coming forth from Your mouth, burning this entire universe by Your own radiance." .

bg:V421 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V420 ;
    bg:nextVerse bg:V422 ;
    bg:precedes bg:V422 ;
    bg:previousVerse bg:V420 ;
    bg:verseID "V421"^^xsd:string ;
    bg:verseNumber "11.20" ;
    bg:verseText "Although You are one, You spread throughout the sky and the planets and all space between. O great one, seeing this wondrous and terrible form, all the planetary systems are perturbed." .

bg:V422 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V421 ;
    bg:nextVerse bg:V423 ;
    bg:precedes bg:V423 ;
    bg:previousVerse bg:V421 ;
    bg:verseID "V422"^^xsd:string ;
    bg:verseNumber "11.21" ;
    bg:verseText "All the hosts of demigods are surrendering before You and entering into You. Some of them, very much afraid, are offering prayers with folded hands. Hosts of great sages and perfected beings, crying \"All peace!\" are praying to You by singing the Vedic hymns." .

bg:V423 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V422 ;
    bg:nextVerse bg:V424 ;
    bg:precedes bg:V424 ;
    bg:previousVerse bg:V422 ;
    bg:verseID "V423"^^xsd:string ;
    bg:verseNumber "11.22" ;
    bg:verseText "All the various manifestations of Lord Śiva, the Ādityas, the Vasus, the Sādhyas, the Viśvedevas, the two Aśvīs, the Maruts, the forefathers, the Gandharvas, the Yakṣas, the Asuras and the perfected demigods are beholding You in wonder." .

bg:V424 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V423 ;
    bg:nextVerse bg:V425 ;
    bg:precedes bg:V425 ;
    bg:previousVerse bg:V423 ;
    bg:verseID "V424"^^xsd:string ;
    bg:verseNumber "11.23" ;
    bg:verseText "O mighty-armed one, all the planets with their demigods are disturbed at seeing Your great form, with its many faces, eyes, arms, thighs, legs and bellies and Your many terrible teeth; and as they are disturbed, so am I." .

bg:V425 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V424 ;
    bg:nextVerse bg:V426 ;
    bg:precedes bg:V426 ;
    bg:previousVerse bg:V424 ;
    bg:verseID "V425"^^xsd:string ;
    bg:verseNumber "11.24" ;
    bg:verseText "O all-pervading Viṣṇu, seeing You with Your many radiant colors touching the sky, Your gaping mouths, and Your great glowing eyes, my mind is perturbed by fear. I can no longer maintain my steadiness or equilibrium of mind." .

bg:V426 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V425 ;
    bg:nextVerse bg:V427 ;
    bg:precedes bg:V427 ;
    bg:previousVerse bg:V425 ;
    bg:verseID "V426"^^xsd:string ;
    bg:verseNumber "11.25" ;
    bg:verseText "O Lord of lords, O refuge of the worlds, please be gracious to me. I cannot keep my balance seeing thus Your blazing deathlike faces and awful teeth. In all directions I am bewildered." .

bg:V427 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V426 ;
    bg:nextVerse bg:V428 ;
    bg:precedes bg:V428 ;
    bg:previousVerse bg:V426 ;
    bg:verseID "V427"^^xsd:string ;
    bg:verseNumber "11.26–27" ;
    bg:verseText "All the sons of Dhṛtarāṣṭra, along with their allied kings, and Bhīṣma, Droṇa, Karṇa—and our chief soldiers also—are rushing into Your fearful mouths. And some I see trapped with heads smashed between Your teeth." .

bg:V428 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V427 ;
    bg:nextVerse bg:V429 ;
    bg:precedes bg:V429 ;
    bg:previousVerse bg:V427 ;
    bg:verseID "V428"^^xsd:string ;
    bg:verseNumber "11.28" ;
    bg:verseText "As the many waves of the rivers flow into the ocean, so do all these great warriors enter blazing into Your mouths." .

bg:V429 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V428 ;
    bg:nextVerse bg:V430 ;
    bg:precedes bg:V430 ;
    bg:previousVerse bg:V428 ;
    bg:verseID "V429"^^xsd:string ;
    bg:verseNumber "11.29" ;
    bg:verseText "I see all people rushing full speed into Your mouths, as moths dash to destruction in a blazing fire." .

bg:V430 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V429 ;
    bg:nextVerse bg:V431 ;
    bg:precedes bg:V431 ;
    bg:previousVerse bg:V429 ;
    bg:verseID "V430"^^xsd:string ;
    bg:verseNumber "11.30" ;
    bg:verseText "O Viṣṇu, I see You devouring all people from all sides with Your flaming mouths. Covering all the universe with Your effulgence, You are manifest with terrible, scorching rays." .

bg:V431 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V430 ;
    bg:nextVerse bg:V432 ;
    bg:precedes bg:V432 ;
    bg:previousVerse bg:V430 ;
    bg:verseID "V431"^^xsd:string ;
    bg:verseNumber "11.31" ;
    bg:verseText "O Lord of lords, so fierce of form, please tell me who You are. I offer my obeisances unto You; please be gracious to me. You are the primal Lord. I want to know about You, for I do not know what Your mission is." .

bg:V432 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V431 ;
    bg:nextVerse bg:V433 ;
    bg:precedes bg:V433 ;
    bg:previousVerse bg:V431 ;
    bg:verseID "V432"^^xsd:string ;
    bg:verseNumber "11.32" ;
    bg:verseText "The Supreme Personality of Godhead said: Time I am, the great destroyer of the worlds, and I have come here to destroy all people. With the exception of you [the Pāṇḍavas], all the soldiers here on both sides will be slain." .

bg:V433 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V432 ;
    bg:nextVerse bg:V434 ;
    bg:precedes bg:V434 ;
    bg:previousVerse bg:V432 ;
    bg:verseID "V433"^^xsd:string ;
    bg:verseNumber "11.33" ;
    bg:verseText "Therefore get up. Prepare to fight and win glory. Conquer your enemies and enjoy a flourishing kingdom. They are already put to death by My arrangement, and you, O Savyasācī, can be but an instrument in the fight." .

bg:V434 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V433 ;
    bg:nextVerse bg:V435 ;
    bg:precedes bg:V435 ;
    bg:previousVerse bg:V433 ;
    bg:verseID "V434"^^xsd:string ;
    bg:verseNumber "11.34" ;
    bg:verseText "Droṇa, Bhīṣma, Jayadratha, Karṇa and the other great warriors have already been destroyed by Me. Therefore, kill them and do not be disturbed. Simply fight, and you will vanquish your enemies in battle." .

bg:V435 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V434 ;
    bg:nextVerse bg:V436 ;
    bg:precedes bg:V436 ;
    bg:previousVerse bg:V434 ;
    bg:verseID "V435"^^xsd:string ;
    bg:verseNumber "11.35" ;
    bg:verseText "Sañjaya said to Dhṛtarāṣṭra: O King, after hearing these words from the Supreme Personality of Godhead, the trembling Arjuna offered obeisances with folded hands again and again. He fearfully spoke to Lord Kṛṣṇa in a faltering voice, as follows." .

bg:V436 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V435 ;
    bg:nextVerse bg:V437 ;
    bg:precedes bg:V437 ;
    bg:previousVerse bg:V435 ;
    bg:verseID "V436"^^xsd:string ;
    bg:verseNumber "11.36" ;
    bg:verseText "Arjuna said: O master of the senses, the world becomes joyful upon hearing Your name, and thus everyone becomes attached to You. Although the perfected beings offer You their respectful homage, the demons are afraid, and they flee here and there. All this is rightly done." .

bg:V437 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V436 ;
    bg:nextVerse bg:V438 ;
    bg:precedes bg:V438 ;
    bg:previousVerse bg:V436 ;
    bg:verseID "V437"^^xsd:string ;
    bg:verseNumber "11.37" ;
    bg:verseText "O great one, greater even than Brahmā, You are the original creator. Why then should they not offer their respectful obeisances unto You? O limitless one, God of gods, refuge of the universe! You are the invincible source, the cause of all causes, transcendental to this material manifestation." .

bg:V438 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V437 ;
    bg:nextVerse bg:V439 ;
    bg:precedes bg:V439 ;
    bg:previousVerse bg:V437 ;
    bg:verseID "V438"^^xsd:string ;
    bg:verseNumber "11.38" ;
    bg:verseText "You are the original Personality of Godhead, the oldest, the ultimate sanctuary of this manifested cosmic world. You are the knower of everything, and You are all that is knowable. You are the supreme refuge, above the material modes. O limitless form! This whole cosmic manifestation is pervaded by You!" .

bg:V439 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V438 ;
    bg:nextVerse bg:V440 ;
    bg:precedes bg:V440 ;
    bg:previousVerse bg:V438 ;
    bg:verseID "V439"^^xsd:string ;
    bg:verseNumber "11.39" ;
    bg:verseText "You are air, and You are the supreme controller! You are fire, You are water, and You are the moon! You are Brahmā, the first living creature, and You are the great-grandfather. I therefore offer my respectful obeisances unto You a thousand times, and again and yet again!" .

bg:V440 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V439 ;
    bg:nextVerse bg:V441 ;
    bg:precedes bg:V441 ;
    bg:previousVerse bg:V439 ;
    bg:verseID "V440"^^xsd:string ;
    bg:verseNumber "11.40" ;
    bg:verseText "Obeisances to You from the front, from behind and from all sides! O unbounded power, You are the master of limitless might! You are all-pervading, and thus You are everything!" .

bg:V441 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V440 ;
    bg:nextVerse bg:V442 ;
    bg:precedes bg:V442 ;
    bg:previousVerse bg:V440 ;
    bg:verseID "V441"^^xsd:string ;
    bg:verseNumber "11.41–42" ;
    bg:verseText "Thinking of You as my friend, I have rashly addressed You \"O Kṛṣṇa,\" \"O Yādava,\" \"O my friend,\" not knowing Your glories. Please forgive whatever I may have done in madness or in love. I have dishonored You many times, jesting as we relaxed, lay on the same bed, or sat or ate together, sometimes alone and sometimes in front of many friends. O infallible one, please excuse me for all those offenses." .

bg:V442 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V441 ;
    bg:nextVerse bg:V443 ;
    bg:precedes bg:V443 ;
    bg:previousVerse bg:V441 ;
    bg:verseID "V442"^^xsd:string ;
    bg:verseNumber "11.43" ;
    bg:verseText "You are the father of this complete cosmic manifestation, of the moving and the nonmoving. You are its worshipable chief, the supreme spiritual master. No one is greater than You, nor can anyone be one with You. How then could there be anyone greater than You within the three worlds, O Lord of immeasurable power?" .

bg:V443 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V442 ;
    bg:nextVerse bg:V444 ;
    bg:precedes bg:V444 ;
    bg:previousVerse bg:V442 ;
    bg:verseID "V443"^^xsd:string ;
    bg:verseNumber "11.44" ;
    bg:verseText "You are the Supreme Lord, to be worshiped by every living being. Thus I fall down to offer You my respectful obeisances and ask Your mercy. As a father tolerates the impudence of his son, a friend the impertinence of a friend, or a husband the familiarity of his wife, please tolerate the wrongs I may have done You." .

bg:V444 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V443 ;
    bg:nextVerse bg:V445 ;
    bg:precedes bg:V445 ;
    bg:previousVerse bg:V443 ;
    bg:verseID "V444"^^xsd:string ;
    bg:verseNumber "11.45" ;
    bg:verseText "After seeing this universal form, which I have never seen before, I am gladdened, but at the same time my mind is disturbed with fear. Therefore please bestow Your grace upon me and reveal again Your form as the Personality of Godhead, O Lord of lords, O abode of the universe." .

bg:V445 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V444 ;
    bg:nextVerse bg:V446 ;
    bg:precedes bg:V446 ;
    bg:previousVerse bg:V444 ;
    bg:verseID "V445"^^xsd:string ;
    bg:verseNumber "11.46" ;
    bg:verseText "O universal form, O thousand-armed Lord, I wish to see You in Your four-armed form, with helmeted head and with club, wheel, conch and lotus flower in Your hands. I long to see You in that form." .

bg:V446 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V445 ;
    bg:nextVerse bg:V447 ;
    bg:precedes bg:V447 ;
    bg:previousVerse bg:V445 ;
    bg:verseID "V446"^^xsd:string ;
    bg:verseNumber "11.47" ;
    bg:verseText "The Supreme Personality of Godhead said: My dear Arjuna, happily have I shown you, by My internal potency, this supreme universal form within the material world. No one before you has ever seen this primal form, unlimited and full of glaring effulgence." .

bg:V447 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V446 ;
    bg:nextVerse bg:V448 ;
    bg:precedes bg:V448 ;
    bg:previousVerse bg:V446 ;
    bg:verseID "V447"^^xsd:string ;
    bg:verseNumber "11.48" ;
    bg:verseText "O best of the Kuru warriors, no one before you has ever seen this universal form of Mine, for neither by studying the Vedas, nor by performing sacrifices, nor by charity, nor by pious activities, nor by severe penances can I be seen in this form in the material world." .

bg:V448 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V447 ;
    bg:nextVerse bg:V449 ;
    bg:precedes bg:V449 ;
    bg:previousVerse bg:V447 ;
    bg:verseID "V448"^^xsd:string ;
    bg:verseNumber "11.49" ;
    bg:verseText "You have been perturbed and bewildered by seeing this horrible feature of Mine. Now let it be finished. My devotee, be free again from all disturbances. With a peaceful mind you can now see the form you desire." .

bg:V449 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V448 ;
    bg:nextVerse bg:V450 ;
    bg:precedes bg:V450 ;
    bg:previousVerse bg:V448 ;
    bg:verseID "V449"^^xsd:string ;
    bg:verseNumber "11.50" ;
    bg:verseText "Sañjaya said to Dhṛtarāṣṭra: The Supreme Personality of Godhead, Kṛṣṇa, having spoken thus to Arjuna, displayed His real four-armed form and at last showed His two-armed form, thus encouraging the fearful Arjuna." .

bg:V450 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V449 ;
    bg:nextVerse bg:V451 ;
    bg:precedes bg:V451 ;
    bg:previousVerse bg:V449 ;
    bg:verseID "V450"^^xsd:string ;
    bg:verseNumber "11.51" ;
    bg:verseText "When Arjuna thus saw Kṛṣṇa in His original form, he said: O Janārdana, seeing this humanlike form, so very beautiful, I am now composed in mind, and I am restored to my original nature." .

bg:V451 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V450 ;
    bg:nextVerse bg:V452 ;
    bg:precedes bg:V452 ;
    bg:previousVerse bg:V450 ;
    bg:verseID "V451"^^xsd:string ;
    bg:verseNumber "11.52" ;
    bg:verseText "The Supreme Personality of Godhead said: My dear Arjuna, this form of Mine you are now seeing is very difficult to behold. Even the demigods are ever seeking the opportunity to see this form, which is so dear." .

bg:V452 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V451 ;
    bg:nextVerse bg:V453 ;
    bg:precedes bg:V453 ;
    bg:previousVerse bg:V451 ;
    bg:verseID "V452"^^xsd:string ;
    bg:verseNumber "11.53" ;
    bg:verseText "The form you are seeing with your transcendental eyes cannot be understood simply by studying the Vedas, nor by undergoing serious penances, nor by charity, nor by worship. It is not by these means that one can see Me as I am." .

bg:V453 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V452 ;
    bg:nextVerse bg:V454 ;
    bg:precedes bg:V454 ;
    bg:previousVerse bg:V452 ;
    bg:verseID "V453"^^xsd:string ;
    bg:verseNumber "11.54" ;
    bg:verseText "My dear Arjuna, only by undivided devotional service can I be understood as I am, standing before you, and can thus be seen directly. Only in this way can you enter into the mysteries of My understanding." .

bg:V454 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH11 ;
    bg:follows bg:V453 ;
    bg:nextVerse bg:V455 ;
    bg:precedes bg:V455 ;
    bg:previousVerse bg:V453 ;
    bg:verseID "V454"^^xsd:string ;
    bg:verseNumber "11.55" ;
    bg:verseText "My dear Arjuna, he who engages in My pure devotional service, free from the contaminations of fruitive activities and mental speculation, he who works for Me, who makes Me the supreme goal of his life, and who is friendly to every living being—he certainly comes to Me." .

bg:V455 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V454 ;
    bg:nextVerse bg:V456 ;
    bg:precedes bg:V456 ;
    bg:previousVerse bg:V454 ;
    bg:verseID "V455"^^xsd:string ;
    bg:verseNumber "12.1" ;
    bg:verseText "Arjuna inquired: Which are considered to be more perfect, those who are always properly engaged in Your devotional service or those who worship the impersonal Brahman, the unmanifested?" .

bg:V456 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V455 ;
    bg:nextVerse bg:V457 ;
    bg:precedes bg:V457 ;
    bg:previousVerse bg:V455 ;
    bg:verseID "V456"^^xsd:string ;
    bg:verseNumber "12.2" ;
    bg:verseText "The Supreme Personality of Godhead said: Those who fix their minds on My personal form and are always engaged in worshiping Me with great and transcendental faith are considered by Me to be most perfect." .

bg:V457 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V456 ;
    bg:nextVerse bg:V458 ;
    bg:precedes bg:V458 ;
    bg:previousVerse bg:V456 ;
    bg:verseID "V457"^^xsd:string ;
    bg:verseNumber "12.3–4" ;
    bg:verseText "But those who fully worship the unmanifested, that which lies beyond the perception of the senses, the all-pervading, inconceivable, unchanging, fixed and immovable—the impersonal conception of the Absolute Truth—by controlling the various senses and being equally disposed to everyone, such persons, engaged in the welfare of all, at last achieve Me." .

bg:V458 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V457 ;
    bg:nextVerse bg:V459 ;
    bg:precedes bg:V459 ;
    bg:previousVerse bg:V457 ;
    bg:verseID "V458"^^xsd:string ;
    bg:verseNumber "12.5" ;
    bg:verseText "For those whose minds are attached to the unmanifested, impersonal feature of the Supreme, advancement is very troublesome. To make progress in that discipline is always difficult for those who are embodied." .

bg:V459 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V458 ;
    bg:nextVerse bg:V460 ;
    bg:precedes bg:V460 ;
    bg:previousVerse bg:V458 ;
    bg:verseID "V459"^^xsd:string ;
    bg:verseNumber "12.6–7" ;
    bg:verseText "But those who worship Me, giving up all their activities unto Me and being devoted to Me without deviation, engaged in devotional service and always meditating upon Me, having fixed their minds upon Me, O son of Pṛthā—for them I am the swift deliverer from the ocean of birth and death." .

bg:V460 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V459 ;
    bg:nextVerse bg:V461 ;
    bg:precedes bg:V461 ;
    bg:previousVerse bg:V459 ;
    bg:verseID "V460"^^xsd:string ;
    bg:verseNumber "12.8" ;
    bg:verseText "Just fix your mind upon Me, the Supreme Personality of Godhead, and engage all your intelligence in Me. Thus you will live in Me always, without a doubt." .

bg:V461 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V460 ;
    bg:nextVerse bg:V462 ;
    bg:precedes bg:V462 ;
    bg:previousVerse bg:V460 ;
    bg:verseID "V461"^^xsd:string ;
    bg:verseNumber "12.9" ;
    bg:verseText "My dear Arjuna, O winner of wealth, if you cannot fix your mind upon Me without deviation, then follow the regulative principles of bhakti-yoga. In this way develop a desire to attain Me." .

bg:V462 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V461 ;
    bg:nextVerse bg:V463 ;
    bg:precedes bg:V463 ;
    bg:previousVerse bg:V461 ;
    bg:verseID "V462"^^xsd:string ;
    bg:verseNumber "12.10" ;
    bg:verseText "If you cannot practice the regulations of bhakti-yoga, then just try to work for Me, because by working for Me you will come to the perfect stage." .

bg:V463 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V462 ;
    bg:nextVerse bg:V464 ;
    bg:precedes bg:V464 ;
    bg:previousVerse bg:V462 ;
    bg:verseID "V463"^^xsd:string ;
    bg:verseNumber "12.11" ;
    bg:verseText "If, however, you are unable to work in this consciousness of Me, then try to act giving up all results of your work and try to be self-situated." .

bg:V464 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V463 ;
    bg:nextVerse bg:V465 ;
    bg:precedes bg:V465 ;
    bg:previousVerse bg:V463 ;
    bg:verseID "V464"^^xsd:string ;
    bg:verseNumber "12.12" ;
    bg:verseText "If you cannot take to this practice, then engage yourself in the cultivation of knowledge. Better than knowledge, however, is meditation, and better than meditation is renunciation of the fruits of action, for by such renunciation one can attain peace of mind." .

bg:V465 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V464 ;
    bg:nextVerse bg:V466 ;
    bg:precedes bg:V466 ;
    bg:previousVerse bg:V464 ;
    bg:verseID "V465"^^xsd:string ;
    bg:verseNumber "12.13–14" ;
    bg:verseText "One who is not envious but is a kind friend to all living entities, who does not think himself a proprietor and is free from false ego, who is equal in both happiness and distress, who is tolerant, always satisfied, self-controlled, and engaged in devotional service with determination, his mind and intelligence fixed on Me—such a devotee of Mine is very dear to Me." .

bg:V466 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V465 ;
    bg:nextVerse bg:V467 ;
    bg:precedes bg:V467 ;
    bg:previousVerse bg:V465 ;
    bg:verseID "V466"^^xsd:string ;
    bg:verseNumber "12.15" ;
    bg:verseText "He by whom no one is put into difficulty and who is not disturbed by anyone, who is equipoised in happiness and distress, fear and anxiety, is very dear to Me." .

bg:V467 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V466 ;
    bg:nextVerse bg:V468 ;
    bg:precedes bg:V468 ;
    bg:previousVerse bg:V466 ;
    bg:verseID "V467"^^xsd:string ;
    bg:verseNumber "12.16" ;
    bg:verseText "My devotee who is not dependent on the ordinary course of activities, who is pure, expert, without cares, free from all pains, and not striving for some result, is very dear to Me." .

bg:V468 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V467 ;
    bg:nextVerse bg:V469 ;
    bg:precedes bg:V469 ;
    bg:previousVerse bg:V467 ;
    bg:verseID "V468"^^xsd:string ;
    bg:verseNumber "12.17" ;
    bg:verseText "One who neither rejoices nor grieves, who neither laments nor desires, and who renounces both auspicious and inauspicious things—such a devotee is very dear to Me." .

bg:V469 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V468 ;
    bg:nextVerse bg:V470 ;
    bg:precedes bg:V470 ;
    bg:previousVerse bg:V468 ;
    bg:verseID "V469"^^xsd:string ;
    bg:verseNumber "12.18–19" ;
    bg:verseText "One who is equal to friends and enemies, who is equipoised in honor and dishonor, heat and cold, happiness and distress, fame and infamy, who is always free from contaminating association, always silent and satisfied with anything, who doesn't care for any residence, who is fixed in knowledge and who is engaged in devotional service—such a person is very dear to Me." .

bg:V470 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH12 ;
    bg:follows bg:V469 ;
    bg:nextVerse bg:V471 ;
    bg:precedes bg:V471 ;
    bg:previousVerse bg:V469 ;
    bg:verseID "V470"^^xsd:string ;
    bg:verseNumber "12.20" ;
    bg:verseText "Those who follow this imperishable path of devotional service and who completely engage themselves with faith, making Me the supreme goal, are very, very dear to Me." .

bg:V471 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V470 ;
    bg:nextVerse bg:V472 ;
    bg:precedes bg:V472 ;
    bg:previousVerse bg:V470 ;
    bg:verseID "V471"^^xsd:string ;
    bg:verseNumber "13.1–2" ;
    bg:verseText "Arjuna said: O my dear Kṛṣṇa, I wish to know about prakṛti [nature], puruṣa [the enjoyer], and the field and the knower of the field, and of knowledge and the object of knowledge. The Supreme Personality of Godhead said: This body, O son of Kuntī, is called the field, and one who knows this body is called the knower of the field." .

bg:V472 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V471 ;
    bg:nextVerse bg:V473 ;
    bg:precedes bg:V473 ;
    bg:previousVerse bg:V471 ;
    bg:verseID "V472"^^xsd:string ;
    bg:verseNumber "13.3" ;
    bg:verseText "O scion of Bharata, you should understand that I am also the knower in all bodies, and to understand this body and its knower is called knowledge. That is My opinion." .

bg:V473 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V472 ;
    bg:nextVerse bg:V474 ;
    bg:precedes bg:V474 ;
    bg:previousVerse bg:V472 ;
    bg:verseID "V473"^^xsd:string ;
    bg:verseNumber "13.4" ;
    bg:verseText "Now please hear My brief description of this field of activity and how it is constituted, what its changes are, whence it is produced, who that knower of the field of activities is, and what his influences are." .

bg:V474 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V473 ;
    bg:nextVerse bg:V475 ;
    bg:precedes bg:V475 ;
    bg:previousVerse bg:V473 ;
    bg:verseID "V474"^^xsd:string ;
    bg:verseNumber "13.5" ;
    bg:verseText "That knowledge of the field of activities and of the knower of activities is described by various sages in various Vedic writings. It is especially presented in Vedānta-sūtra with all reasoning as to cause and effect." .

bg:V475 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V474 ;
    bg:nextVerse bg:V476 ;
    bg:precedes bg:V476 ;
    bg:previousVerse bg:V474 ;
    bg:verseID "V475"^^xsd:string ;
    bg:verseNumber "13.6–7" ;
    bg:verseText "The five great elements, false ego, intelligence, the unmanifested, the ten senses and the mind, the five sense objects, desire, hatred, happiness, distress, the aggregate, the life symptoms, and convictions—all these are considered, in summary, to be the field of activities and its interactions." .

bg:V476 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V475 ;
    bg:nextVerse bg:V477 ;
    bg:precedes bg:V477 ;
    bg:previousVerse bg:V475 ;
    bg:verseID "V476"^^xsd:string ;
    bg:verseNumber "13.8–12" ;
    bg:verseText "Humility; pridelessness; nonviolence; tolerance; simplicity; approaching a bona fide spiritual master; cleanliness; steadiness; self-control; renunciation of the objects of sense gratification; absence of false ego; the perception of the evil of birth, death, old age and disease; detachment; freedom from entanglement with children, wife, home and the rest; even-mindedness amid pleasant and unpleasant events; constant and unalloyed devotion to Me; aspiring to live in a solitary place; detachment from the general mass of people; accepting the importance of self-realization; and philosophical search for the Absolute Truth—all these I declare to be knowledge, and besides this whatever there may be is ignorance." .

bg:V477 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V476 ;
    bg:nextVerse bg:V478 ;
    bg:precedes bg:V478 ;
    bg:previousVerse bg:V476 ;
    bg:verseID "V477"^^xsd:string ;
    bg:verseNumber "13.13" ;
    bg:verseText "I shall now explain the knowable, knowing which you will taste the eternal. Brahman, the spirit, beginningless and subordinate to Me, lies beyond the cause and effect of this material world." .

bg:V478 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V477 ;
    bg:nextVerse bg:V479 ;
    bg:precedes bg:V479 ;
    bg:previousVerse bg:V477 ;
    bg:verseID "V478"^^xsd:string ;
    bg:verseNumber "13.14" ;
    bg:verseText "Everywhere are His hands and legs, His eyes, heads and faces, and He has ears everywhere. In this way the Supersoul exists, pervading everything." .

bg:V479 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V478 ;
    bg:nextVerse bg:V480 ;
    bg:precedes bg:V480 ;
    bg:previousVerse bg:V478 ;
    bg:verseID "V479"^^xsd:string ;
    bg:verseNumber "13.15" ;
    bg:verseText "The Supersoul is the original source of all senses, yet He is without senses. He is unattached, although He is the maintainer of all living beings. He transcends the modes of nature, and at the same time He is the master of all the modes of material nature." .

bg:V480 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V479 ;
    bg:nextVerse bg:V481 ;
    bg:precedes bg:V481 ;
    bg:previousVerse bg:V479 ;
    bg:verseID "V480"^^xsd:string ;
    bg:verseNumber "13.16" ;
    bg:verseText "The Supreme Truth exists outside and inside of all living beings, the moving and the nonmoving. Because He is subtle, He is beyond the power of the material senses to see or to know. Although far, far away, He is also near to all." .

bg:V481 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V480 ;
    bg:nextVerse bg:V482 ;
    bg:precedes bg:V482 ;
    bg:previousVerse bg:V480 ;
    bg:verseID "V481"^^xsd:string ;
    bg:verseNumber "13.17" ;
    bg:verseText "Although the Supersoul appears to be divided among all beings, He is never divided. He is situated as one. Although He is the maintainer of every living entity, it is to be understood that He devours and develops all." .

bg:V482 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V481 ;
    bg:nextVerse bg:V483 ;
    bg:precedes bg:V483 ;
    bg:previousVerse bg:V481 ;
    bg:verseID "V482"^^xsd:string ;
    bg:verseNumber "13.18" ;
    bg:verseText "He is the source of light in all luminous objects. He is beyond the darkness of matter and is unmanifested. He is knowledge, He is the object of knowledge, and He is the goal of knowledge. He is situated in everyone's heart." .

bg:V483 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V482 ;
    bg:nextVerse bg:V484 ;
    bg:precedes bg:V484 ;
    bg:previousVerse bg:V482 ;
    bg:verseID "V483"^^xsd:string ;
    bg:verseNumber "13.19" ;
    bg:verseText "Thus the field of activities [the body], knowledge and the knowable have been summarily described by Me. Only My devotees can understand this thoroughly and thus attain to My nature." .

bg:V484 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V483 ;
    bg:nextVerse bg:V485 ;
    bg:precedes bg:V485 ;
    bg:previousVerse bg:V483 ;
    bg:verseID "V484"^^xsd:string ;
    bg:verseNumber "13.20" ;
    bg:verseText "Material nature and the living entities should be understood to be beginningless. Their transformations and the modes of matter are products of material nature." .

bg:V485 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V484 ;
    bg:nextVerse bg:V486 ;
    bg:precedes bg:V486 ;
    bg:previousVerse bg:V484 ;
    bg:verseID "V485"^^xsd:string ;
    bg:verseNumber "13.21" ;
    bg:verseText "Nature is said to be the cause of all material causes and effects, whereas the living entity is the cause of the various sufferings and enjoyments in this world." .

bg:V486 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V485 ;
    bg:nextVerse bg:V487 ;
    bg:precedes bg:V487 ;
    bg:previousVerse bg:V485 ;
    bg:verseID "V486"^^xsd:string ;
    bg:verseNumber "13.22" ;
    bg:verseText "The living entity in material nature thus follows the ways of life, enjoying the three modes of nature. This is due to his association with that material nature. Thus he meets with good and evil among various species." .

bg:V487 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V486 ;
    bg:nextVerse bg:V488 ;
    bg:precedes bg:V488 ;
    bg:previousVerse bg:V486 ;
    bg:verseID "V487"^^xsd:string ;
    bg:verseNumber "13.23" ;
    bg:verseText "Yet in this body there is another, a transcendental enjoyer, who is the Lord, the supreme proprietor, who exists as the overseer and permitter, and who is known as the Supersoul." .

bg:V488 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V487 ;
    bg:nextVerse bg:V489 ;
    bg:precedes bg:V489 ;
    bg:previousVerse bg:V487 ;
    bg:verseID "V488"^^xsd:string ;
    bg:verseNumber "13.24" ;
    bg:verseText "One who understands this philosophy concerning material nature, the living entity and the interaction of the modes of nature is sure to attain liberation. He will not take birth here again, regardless of his present position." .

bg:V489 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V488 ;
    bg:nextVerse bg:V490 ;
    bg:precedes bg:V490 ;
    bg:previousVerse bg:V488 ;
    bg:verseID "V489"^^xsd:string ;
    bg:verseNumber "13.25" ;
    bg:verseText "Some perceive the Supersoul within themselves through meditation, others through the cultivation of knowledge, and still others through working without fruitive desires." .

bg:V490 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V489 ;
    bg:nextVerse bg:V491 ;
    bg:precedes bg:V491 ;
    bg:previousVerse bg:V489 ;
    bg:verseID "V490"^^xsd:string ;
    bg:verseNumber "13.26" ;
    bg:verseText "Again there are those who, although not conversant in spiritual knowledge, begin to worship the Supreme Person upon hearing about Him from others. Because of their tendency to hear from authorities, they also transcend the path of birth and death." .

bg:V491 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V490 ;
    bg:nextVerse bg:V492 ;
    bg:precedes bg:V492 ;
    bg:previousVerse bg:V490 ;
    bg:verseID "V491"^^xsd:string ;
    bg:verseNumber "13.27" ;
    bg:verseText "O chief of the Bhāratas, know that whatever you see in existence, both the moving and the nonmoving, is only a combination of the field of activities and the knower of the field." .

bg:V492 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V491 ;
    bg:nextVerse bg:V493 ;
    bg:precedes bg:V493 ;
    bg:previousVerse bg:V491 ;
    bg:verseID "V492"^^xsd:string ;
    bg:verseNumber "13.28" ;
    bg:verseText "One who sees the Supersoul accompanying the individual soul in all bodies, and who understands that neither the soul nor the Supersoul within the destructible body is ever destroyed, actually sees." .

bg:V493 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V492 ;
    bg:nextVerse bg:V494 ;
    bg:precedes bg:V494 ;
    bg:previousVerse bg:V492 ;
    bg:verseID "V493"^^xsd:string ;
    bg:verseNumber "13.29" ;
    bg:verseText "One who sees the Supersoul equally present everywhere, in every living being, does not degrade himself by his mind. Thus he approaches the transcendental destination." .

bg:V494 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V493 ;
    bg:nextVerse bg:V495 ;
    bg:precedes bg:V495 ;
    bg:previousVerse bg:V493 ;
    bg:verseID "V494"^^xsd:string ;
    bg:verseNumber "13.30" ;
    bg:verseText "One who can see that all activities are performed by the body, which is created of material nature, and sees that the self does nothing, actually sees." .

bg:V495 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V494 ;
    bg:nextVerse bg:V496 ;
    bg:precedes bg:V496 ;
    bg:previousVerse bg:V494 ;
    bg:verseID "V495"^^xsd:string ;
    bg:verseNumber "13.31" ;
    bg:verseText "When a sensible man ceases to see different identities due to different material bodies and he sees how beings are expanded everywhere, he attains to the Brahman conception." .

bg:V496 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V495 ;
    bg:nextVerse bg:V497 ;
    bg:precedes bg:V497 ;
    bg:previousVerse bg:V495 ;
    bg:verseID "V496"^^xsd:string ;
    bg:verseNumber "13.32" ;
    bg:verseText "Those with the vision of eternity can see that the imperishable soul is transcendental, eternal, and beyond the modes of nature. Despite contact with the material body, O Arjuna, the soul neither does anything nor is entangled." .

bg:V497 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V496 ;
    bg:nextVerse bg:V498 ;
    bg:precedes bg:V498 ;
    bg:previousVerse bg:V496 ;
    bg:verseID "V497"^^xsd:string ;
    bg:verseNumber "13.33" ;
    bg:verseText "The sky, due to its subtle nature, does not mix with anything, although it is all-pervading. Similarly, the soul situated in Brahman vision does not mix with the body, though situated in that body." .

bg:V498 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V497 ;
    bg:nextVerse bg:V499 ;
    bg:precedes bg:V499 ;
    bg:previousVerse bg:V497 ;
    bg:verseID "V498"^^xsd:string ;
    bg:verseNumber "13.34" ;
    bg:verseText "O son of Bharata, as the sun alone illuminates all this universe, so does the living entity, one within the body, illuminate the entire body by consciousness." .

bg:V499 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH13 ;
    bg:follows bg:V498 ;
    bg:nextVerse bg:V500 ;
    bg:precedes bg:V500 ;
    bg:previousVerse bg:V498 ;
    bg:verseID "V499"^^xsd:string ;
    bg:verseNumber "13.35" ;
    bg:verseText "Those who see with eyes of knowledge the difference between the body and the knower of the body, and can also understand the process of liberation from bondage in material nature, attain to the supreme goal." .

bg:V500 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V499 ;
    bg:nextVerse bg:V501 ;
    bg:precedes bg:V501 ;
    bg:previousVerse bg:V499 ;
    bg:verseID "V500"^^xsd:string ;
    bg:verseNumber "14.1" ;
    bg:verseText "The Supreme Personality of Godhead said: Again I shall declare to you this supreme wisdom, the best of all knowledge, knowing which all the sages have attained the supreme perfection." .

bg:V501 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V500 ;
    bg:nextVerse bg:V502 ;
    bg:precedes bg:V502 ;
    bg:previousVerse bg:V500 ;
    bg:verseID "V501"^^xsd:string ;
    bg:verseNumber "14.2" ;
    bg:verseText "By becoming fixed in this knowledge, one can attain to the transcendental nature like My own. Thus established, one is not born at the time of creation or disturbed at the time of dissolution." .

bg:V502 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V501 ;
    bg:nextVerse bg:V503 ;
    bg:precedes bg:V503 ;
    bg:previousVerse bg:V501 ;
    bg:verseID "V502"^^xsd:string ;
    bg:verseNumber "14.3" ;
    bg:verseText "The total material substance, called Brahman, is the source of birth, and it is that Brahman that I impregnate, making possible the births of all living beings, O son of Bharata." .

bg:V503 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V502 ;
    bg:nextVerse bg:V504 ;
    bg:precedes bg:V504 ;
    bg:previousVerse bg:V502 ;
    bg:verseID "V503"^^xsd:string ;
    bg:verseNumber "14.4" ;
    bg:verseText "It should be understood that all species of life, O son of Kuntī, are made possible by birth in this material nature, and that I am the seed-giving father." .

bg:V504 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V503 ;
    bg:nextVerse bg:V505 ;
    bg:precedes bg:V505 ;
    bg:previousVerse bg:V503 ;
    bg:verseID "V504"^^xsd:string ;
    bg:verseNumber "14.5" ;
    bg:verseText "Material nature consists of three modes—goodness, passion and ignorance. When the eternal living entity comes in contact with nature, O mighty-armed Arjuna, he becomes conditioned by these modes." .

bg:V505 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V504 ;
    bg:nextVerse bg:V506 ;
    bg:precedes bg:V506 ;
    bg:previousVerse bg:V504 ;
    bg:verseID "V505"^^xsd:string ;
    bg:verseNumber "14.6" ;
    bg:verseText "O sinless one, the mode of goodness, being purer than the others, is illuminating, and it frees one from all sinful reactions. Those situated in that mode become conditioned by a sense of happiness and knowledge." .

bg:V506 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V505 ;
    bg:nextVerse bg:V507 ;
    bg:precedes bg:V507 ;
    bg:previousVerse bg:V505 ;
    bg:verseID "V506"^^xsd:string ;
    bg:verseNumber "14.7" ;
    bg:verseText "The mode of passion is born of unlimited desires and longings, O son of Kuntī, and because of this the embodied living entity is bound to material fruitive actions." .

bg:V507 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V506 ;
    bg:nextVerse bg:V508 ;
    bg:precedes bg:V508 ;
    bg:previousVerse bg:V506 ;
    bg:verseID "V507"^^xsd:string ;
    bg:verseNumber "14.8" ;
    bg:verseText "O son of Bharata, know that the mode of darkness, born of ignorance, is the delusion of all embodied living entities. The results of this mode are madness, indolence and sleep, which bind the conditioned soul." .

bg:V508 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V507 ;
    bg:nextVerse bg:V509 ;
    bg:precedes bg:V509 ;
    bg:previousVerse bg:V507 ;
    bg:verseID "V508"^^xsd:string ;
    bg:verseNumber "14.9" ;
    bg:verseText "O son of Bharata, the mode of goodness conditions one to happiness; passion conditions one to fruitive action; and ignorance, covering one's knowledge, binds one to madness." .

bg:V509 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V508 ;
    bg:nextVerse bg:V510 ;
    bg:precedes bg:V510 ;
    bg:previousVerse bg:V508 ;
    bg:verseID "V509"^^xsd:string ;
    bg:verseNumber "14.10" ;
    bg:verseText "Sometimes the mode of goodness becomes prominent, defeating the modes of passion and ignorance, O son of Bharata. Sometimes the mode of passion defeats goodness and ignorance, and at other times ignorance defeats goodness and passion. In this way there is always competition for supremacy." .

bg:V510 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V509 ;
    bg:nextVerse bg:V511 ;
    bg:precedes bg:V511 ;
    bg:previousVerse bg:V509 ;
    bg:verseID "V510"^^xsd:string ;
    bg:verseNumber "14.11" ;
    bg:verseText "The manifestation of the mode of goodness can be experienced when all the gates of the body are illuminated by knowledge." .

bg:V511 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V510 ;
    bg:nextVerse bg:V512 ;
    bg:precedes bg:V512 ;
    bg:previousVerse bg:V510 ;
    bg:verseID "V511"^^xsd:string ;
    bg:verseNumber "14.12" ;
    bg:verseText "O chief of the Bhāratas, when there is an increase in the mode of passion the symptoms of great attachment, fruitive activity, intense endeavor, and uncontrollable desire and hankering develop." .

bg:V512 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V511 ;
    bg:nextVerse bg:V513 ;
    bg:precedes bg:V513 ;
    bg:previousVerse bg:V511 ;
    bg:verseID "V512"^^xsd:string ;
    bg:verseNumber "14.13" ;
    bg:verseText "When there is an increase in the mode of ignorance, O son of Kuru, darkness, inertia, madness and illusion are manifested." .

bg:V513 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V512 ;
    bg:nextVerse bg:V514 ;
    bg:precedes bg:V514 ;
    bg:previousVerse bg:V512 ;
    bg:verseID "V513"^^xsd:string ;
    bg:verseNumber "14.14" ;
    bg:verseText "When one dies in the mode of goodness, he attains to the pure higher planets of the great sages." .

bg:V514 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V513 ;
    bg:nextVerse bg:V515 ;
    bg:precedes bg:V515 ;
    bg:previousVerse bg:V513 ;
    bg:verseID "V514"^^xsd:string ;
    bg:verseNumber "14.15" ;
    bg:verseText "When one dies in the mode of passion, he takes birth among those engaged in fruitive activities; and when one dies in the mode of ignorance, he takes birth in the animal kingdom." .

bg:V515 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V514 ;
    bg:nextVerse bg:V516 ;
    bg:precedes bg:V516 ;
    bg:previousVerse bg:V514 ;
    bg:verseID "V515"^^xsd:string ;
    bg:verseNumber "14.16" ;
    bg:verseText "The result of pious action is pure and is said to be in the mode of goodness. But action done in the mode of passion results in misery, and action performed in the mode of ignorance results in foolishness." .

bg:V516 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V515 ;
    bg:nextVerse bg:V517 ;
    bg:precedes bg:V517 ;
    bg:previousVerse bg:V515 ;
    bg:verseID "V516"^^xsd:string ;
    bg:verseNumber "14.17" ;
    bg:verseText "From the mode of goodness, real knowledge develops; from the mode of passion, greed develops; and from the mode of ignorance develop foolishness, madness and illusion." .

bg:V517 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V516 ;
    bg:nextVerse bg:V518 ;
    bg:precedes bg:V518 ;
    bg:previousVerse bg:V516 ;
    bg:verseID "V517"^^xsd:string ;
    bg:verseNumber "14.18" ;
    bg:verseText "Those situated in the mode of goodness gradually go upward to the higher planets; those in the mode of passion live on the earthly planets; and those in the abominable mode of ignorance go down to the hellish worlds." .

bg:V518 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V517 ;
    bg:nextVerse bg:V519 ;
    bg:precedes bg:V519 ;
    bg:previousVerse bg:V517 ;
    bg:verseID "V518"^^xsd:string ;
    bg:verseNumber "14.19" ;
    bg:verseText "When one properly sees that in all activities no other performer is at work than these modes of nature and he knows the Supreme Lord, who is transcendental to all these modes, he attains My spiritual nature." .

bg:V519 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V518 ;
    bg:nextVerse bg:V520 ;
    bg:precedes bg:V520 ;
    bg:previousVerse bg:V518 ;
    bg:verseID "V519"^^xsd:string ;
    bg:verseNumber "14.20" ;
    bg:verseText "When the embodied being is able to transcend these three modes associated with the material body, he can become free from birth, death, old age and their distresses and can enjoy nectar even in this life." .

bg:V520 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V519 ;
    bg:nextVerse bg:V521 ;
    bg:precedes bg:V521 ;
    bg:previousVerse bg:V519 ;
    bg:verseID "V520"^^xsd:string ;
    bg:verseNumber "14.21" ;
    bg:verseText "Arjuna inquired: O my dear Lord, by which symptoms is one known who is transcendental to these three modes? What is his behavior? And how does he transcend the modes of nature?" .

bg:V521 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V520 ;
    bg:nextVerse bg:V522 ;
    bg:precedes bg:V522 ;
    bg:previousVerse bg:V520 ;
    bg:verseID "V521"^^xsd:string ;
    bg:verseNumber "14.22–25" ;
    bg:verseText "The Supreme Personality of Godhead said: O son of Pāṇḍu, he who does not hate illumination, attachment and delusion when they are present or long for them when they disappear; who is unwavering and undisturbed through all these reactions of the material qualities, remaining neutral and transcendental, knowing that the modes alone are active; who is situated in the self and regards alike happiness and distress; who looks upon a lump of earth, a stone and a piece of gold with an equal eye; who is equal toward the desirable and the undesirable; who is steady, situated equally well in praise and blame, honor and dishonor; who treats alike both friend and enemy; and who has renounced all material activities—such a person is said to have transcended the modes of nature." .

bg:V522 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V521 ;
    bg:nextVerse bg:V523 ;
    bg:precedes bg:V523 ;
    bg:previousVerse bg:V521 ;
    bg:verseID "V522"^^xsd:string ;
    bg:verseNumber "14.26" ;
    bg:verseText "One who engages in full devotional service, unfailing in all circumstances, at once transcends the modes of material nature and thus comes to the level of Brahman." .

bg:V523 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH14 ;
    bg:follows bg:V522 ;
    bg:nextVerse bg:V524 ;
    bg:precedes bg:V524 ;
    bg:previousVerse bg:V522 ;
    bg:verseID "V523"^^xsd:string ;
    bg:verseNumber "14.27" ;
    bg:verseText "And I am the basis of the impersonal Brahman, which is immortal, imperishable and eternal and is the constitutional position of ultimate happiness." .

bg:V524 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V523 ;
    bg:nextVerse bg:V525 ;
    bg:precedes bg:V525 ;
    bg:previousVerse bg:V523 ;
    bg:verseID "V524"^^xsd:string ;
    bg:verseNumber "15.1" ;
    bg:verseText "The Supreme Personality of Godhead said: It is said that there is an imperishable banyan tree that has its roots upward and its branches down and whose leaves are the Vedic hymns. One who knows this tree is the knower of the Vedas." .

bg:V525 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V524 ;
    bg:nextVerse bg:V526 ;
    bg:precedes bg:V526 ;
    bg:previousVerse bg:V524 ;
    bg:verseID "V525"^^xsd:string ;
    bg:verseNumber "15.2" ;
    bg:verseText "The branches of this tree extend downward and upward, nourished by the three modes of material nature. The twigs are the objects of the senses. This tree also has roots going down, and these are bound to the fruitive actions of human society." .

bg:V526 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V525 ;
    bg:nextVerse bg:V527 ;
    bg:precedes bg:V527 ;
    bg:previousVerse bg:V525 ;
    bg:verseID "V526"^^xsd:string ;
    bg:verseNumber "15.3–4" ;
    bg:verseText "The real form of this tree cannot be perceived in this world. No one can understand where it ends, where it begins, or where its foundation is. But with determination one must cut down this strongly rooted tree with the weapon of detachment. Thereafter, one must seek that place from which, having gone, one never returns, and there surrender to that Supreme Personality of Godhead from whom everything began and from whom everything has extended since time immemorial." .

bg:V527 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V526 ;
    bg:nextVerse bg:V528 ;
    bg:precedes bg:V528 ;
    bg:previousVerse bg:V526 ;
    bg:verseID "V527"^^xsd:string ;
    bg:verseNumber "15.5" ;
    bg:verseText "Those who are free from false prestige, illusion and false association, who understand the eternal, who are done with material lust, who are freed from the dualities of happiness and distress, and who, unbewildered, know how to surrender unto the Supreme Person attain to that eternal kingdom." .

bg:V528 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V527 ;
    bg:nextVerse bg:V529 ;
    bg:precedes bg:V529 ;
    bg:previousVerse bg:V527 ;
    bg:verseID "V528"^^xsd:string ;
    bg:verseNumber "15.6" ;
    bg:verseText "That supreme abode of Mine is not illumined by the sun or moon, nor by fire or electricity. Those who reach it never return to this material world." .

bg:V529 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V528 ;
    bg:nextVerse bg:V530 ;
    bg:precedes bg:V530 ;
    bg:previousVerse bg:V528 ;
    bg:verseID "V529"^^xsd:string ;
    bg:verseNumber "15.7" ;
    bg:verseText "The living entities in this conditioned world are My eternal fragmental parts. Due to conditioned life, they are struggling very hard with the six senses, which include the mind." .

bg:V530 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V529 ;
    bg:nextVerse bg:V531 ;
    bg:precedes bg:V531 ;
    bg:previousVerse bg:V529 ;
    bg:verseID "V530"^^xsd:string ;
    bg:verseNumber "15.8" ;
    bg:verseText "The living entity in the material world carries his different conceptions of life from one body to another, as the air carries aromas. Thus he takes one kind of body and again quits it to take another." .

bg:V531 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V530 ;
    bg:nextVerse bg:V532 ;
    bg:precedes bg:V532 ;
    bg:previousVerse bg:V530 ;
    bg:verseID "V531"^^xsd:string ;
    bg:verseNumber "15.9" ;
    bg:verseText "The living entity, thus taking another gross body, obtains a certain type of ear, eye, tongue, nose and sense of touch, which are grouped about the mind. He thus enjoys a particular set of sense objects." .

bg:V532 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V531 ;
    bg:nextVerse bg:V533 ;
    bg:precedes bg:V533 ;
    bg:previousVerse bg:V531 ;
    bg:verseID "V532"^^xsd:string ;
    bg:verseNumber "15.10" ;
    bg:verseText "The foolish cannot understand how a living entity can quit his body, nor can they understand what sort of body he enjoys under the spell of the modes of nature. But one whose eyes are trained in knowledge can see all this." .

bg:V533 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V532 ;
    bg:nextVerse bg:V534 ;
    bg:precedes bg:V534 ;
    bg:previousVerse bg:V532 ;
    bg:verseID "V533"^^xsd:string ;
    bg:verseNumber "15.11" ;
    bg:verseText "The endeavoring transcendentalists who are situated in self-realization can see all this clearly. But those whose minds are not developed and who are not situated in self-realization cannot see what is taking place, though they may try." .

bg:V534 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V533 ;
    bg:nextVerse bg:V535 ;
    bg:precedes bg:V535 ;
    bg:previousVerse bg:V533 ;
    bg:verseID "V534"^^xsd:string ;
    bg:verseNumber "15.12" ;
    bg:verseText "The splendor of the sun, which dissipates the darkness of this whole world, comes from Me. And the splendor of the moon and the splendor of fire are also from Me." .

bg:V535 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V534 ;
    bg:nextVerse bg:V536 ;
    bg:precedes bg:V536 ;
    bg:previousVerse bg:V534 ;
    bg:verseID "V535"^^xsd:string ;
    bg:verseNumber "15.13" ;
    bg:verseText "I enter into each planet, and by My energy they stay in orbit. I become the moon and thereby supply the juice of life to all vegetables." .

bg:V536 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V535 ;
    bg:nextVerse bg:V537 ;
    bg:precedes bg:V537 ;
    bg:previousVerse bg:V535 ;
    bg:verseID "V536"^^xsd:string ;
    bg:verseNumber "15.14" ;
    bg:verseText "I am the fire of digestion in the bodies of all living entities, and I join with the air of life, outgoing and incoming, to digest the four kinds of foodstuff." .

bg:V537 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V536 ;
    bg:nextVerse bg:V538 ;
    bg:precedes bg:V538 ;
    bg:previousVerse bg:V536 ;
    bg:verseID "V537"^^xsd:string ;
    bg:verseNumber "15.15" ;
    bg:verseText "I am seated in everyone’s heart, and from Me come remembrance, knowledge and forgetfulness. By all the Vedas, I am to be known. Indeed, I am the compiler of Vedānta, and I am the knower of the Vedas." .

bg:V538 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V537 ;
    bg:nextVerse bg:V539 ;
    bg:precedes bg:V539 ;
    bg:previousVerse bg:V537 ;
    bg:verseID "V538"^^xsd:string ;
    bg:verseNumber "15.16" ;
    bg:verseText "There are two classes of beings, the fallible and the infallible. In the material world every living entity is fallible, and in the spiritual world every living entity is called infallible." .

bg:V539 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V538 ;
    bg:nextVerse bg:V540 ;
    bg:precedes bg:V540 ;
    bg:previousVerse bg:V538 ;
    bg:verseID "V539"^^xsd:string ;
    bg:verseNumber "15.17" ;
    bg:verseText "Besides these two, there is the greatest living personality, the Supreme Soul, the imperishable Lord Himself, who has entered the three worlds and is maintaining them." .

bg:V540 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V539 ;
    bg:nextVerse bg:V541 ;
    bg:precedes bg:V541 ;
    bg:previousVerse bg:V539 ;
    bg:verseID "V540"^^xsd:string ;
    bg:verseNumber "15.18" ;
    bg:verseText "Because I am transcendental, beyond both the fallible and the infallible, and because I am the greatest, I am celebrated both in the world and in the Vedas as that Supreme Person." .

bg:V541 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V540 ;
    bg:nextVerse bg:V542 ;
    bg:precedes bg:V542 ;
    bg:previousVerse bg:V540 ;
    bg:verseID "V541"^^xsd:string ;
    bg:verseNumber "15.19" ;
    bg:verseText "Whoever knows Me as the Supreme Personality of Godhead, without doubting, is the knower of everything. He therefore engages himself in full devotional service to Me, O son of Bharata." .

bg:V542 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH15 ;
    bg:follows bg:V541 ;
    bg:nextVerse bg:V543 ;
    bg:precedes bg:V543 ;
    bg:previousVerse bg:V541 ;
    bg:verseID "V542"^^xsd:string ;
    bg:verseNumber "15.20" ;
    bg:verseText "This is the most confidential part of the Vedic scriptures, O sinless one, and it is disclosed now by Me. Whoever understands this will become wise, and his endeavors will know perfection." .

bg:V543 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V542 ;
    bg:nextVerse bg:V544 ;
    bg:precedes bg:V544 ;
    bg:previousVerse bg:V542 ;
    bg:verseID "V543"^^xsd:string ;
    bg:verseNumber "16.1–3" ;
    bg:verseText "The Supreme Personality of Godhead said: Fearlessness; purification of one’s existence; cultivation of spiritual knowledge; charity; self-control; performance of sacrifice; study of the Vedas; austerity; simplicity; nonviolence; truthfulness; freedom from anger; renunciation; tranquillity; aversion to faultfinding; compassion for all living entities; freedom from covetousness; gentleness; modesty; steady determination; vigor; forgiveness; fortitude; cleanliness; and freedom from envy and from the passion for honor—these transcendental qualities, O son of Bharata, belong to godly men endowed with divine nature." .

bg:V544 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V543 ;
    bg:nextVerse bg:V545 ;
    bg:precedes bg:V545 ;
    bg:previousVerse bg:V543 ;
    bg:verseID "V544"^^xsd:string ;
    bg:verseNumber "16.4" ;
    bg:verseText "Pride, arrogance, conceit, anger, harshness and ignorance—these qualities belong to those of demoniac nature, O son of Pṛthā." .

bg:V545 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V544 ;
    bg:nextVerse bg:V546 ;
    bg:precedes bg:V546 ;
    bg:previousVerse bg:V544 ;
    bg:verseID "V545"^^xsd:string ;
    bg:verseNumber "16.5" ;
    bg:verseText "The transcendental qualities are conducive to liberation, whereas the demoniac qualities make for bondage. Do not worry, O son of Pāṇḍu, for you are born with the divine qualities." .

bg:V546 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V545 ;
    bg:nextVerse bg:V547 ;
    bg:precedes bg:V547 ;
    bg:previousVerse bg:V545 ;
    bg:verseID "V546"^^xsd:string ;
    bg:verseNumber "16.6" ;
    bg:verseText "O son of Pṛthā, in this world there are two kinds of created beings. One is called divine and the other demoniac. I have already explained to you at length the divine qualities. Now hear from Me of the demoniac." .

bg:V547 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V546 ;
    bg:nextVerse bg:V548 ;
    bg:precedes bg:V548 ;
    bg:previousVerse bg:V546 ;
    bg:verseID "V547"^^xsd:string ;
    bg:verseNumber "16.7" ;
    bg:verseText "Those who are demoniac do not know what is to be done and what is not to be done. Neither cleanliness nor proper behavior nor truth is found in them." .

bg:V548 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V547 ;
    bg:nextVerse bg:V549 ;
    bg:precedes bg:V549 ;
    bg:previousVerse bg:V547 ;
    bg:verseID "V548"^^xsd:string ;
    bg:verseNumber "16.8" ;
    bg:verseText "They say that this world is unreal, with no foundation, no God in control. They say it is produced of sex desire and has no cause other than lust." .

bg:V549 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V548 ;
    bg:nextVerse bg:V550 ;
    bg:precedes bg:V550 ;
    bg:previousVerse bg:V548 ;
    bg:verseID "V549"^^xsd:string ;
    bg:verseNumber "16.9" ;
    bg:verseText "Following such conclusions, the demoniac, who are lost to themselves and who have no intelligence, engage in unbeneficial, horrible works meant to destroy the world." .

bg:V550 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V549 ;
    bg:nextVerse bg:V551 ;
    bg:precedes bg:V551 ;
    bg:previousVerse bg:V549 ;
    bg:verseID "V550"^^xsd:string ;
    bg:verseNumber "16.10" ;
    bg:verseText "Taking shelter of insatiable lust and absorbed in the conceit of pride and false prestige, the demoniac, thus illusioned, are always sworn to unclean work, attracted by the impermanent." .

bg:V551 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V550 ;
    bg:nextVerse bg:V552 ;
    bg:precedes bg:V552 ;
    bg:previousVerse bg:V550 ;
    bg:verseID "V551"^^xsd:string ;
    bg:verseNumber "16.11–12" ;
    bg:verseText "They believe that to gratify the senses is the prime necessity of human civilization. Thus until the end of life their anxiety is immeasurable. Bound by a network of hundreds of thousands of desires and absorbed in lust and anger, they secure money by illegal means for sense gratification." .

bg:V552 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V551 ;
    bg:nextVerse bg:V553 ;
    bg:precedes bg:V553 ;
    bg:previousVerse bg:V551 ;
    bg:verseID "V552"^^xsd:string ;
    bg:verseNumber "16.13–15" ;
    bg:verseText "The demoniac person thinks: “So much wealth do I have today, and I will gain more according to my schemes. So much is mine now, and it will increase in the future, more and more. He is my enemy, and I have killed him, and my other enemies will also be killed. I am the lord of everything. I am the enjoyer. I am perfect, powerful and happy. I am the richest man, surrounded by aristocratic relatives. There is none so powerful and happy as I am. I shall perform sacrifices, I shall give some charity, and thus I shall rejoice.” In this way, such persons are deluded by ignorance." .

bg:V553 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V552 ;
    bg:nextVerse bg:V554 ;
    bg:precedes bg:V554 ;
    bg:previousVerse bg:V552 ;
    bg:verseID "V553"^^xsd:string ;
    bg:verseNumber "16.16" ;
    bg:verseText "Thus perplexed by various anxieties and bound by a network of illusions, they become too strongly attached to sense enjoyment and fall down into hell." .

bg:V554 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V553 ;
    bg:nextVerse bg:V555 ;
    bg:precedes bg:V555 ;
    bg:previousVerse bg:V553 ;
    bg:verseID "V554"^^xsd:string ;
    bg:verseNumber "16.17" ;
    bg:verseText "Self-complacent and always impudent, deluded by wealth and false prestige, they sometimes proudly perform sacrifices in name only, without following any rules or regulations." .

bg:V555 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V554 ;
    bg:nextVerse bg:V556 ;
    bg:precedes bg:V556 ;
    bg:previousVerse bg:V554 ;
    bg:verseID "V555"^^xsd:string ;
    bg:verseNumber "16.18" ;
    bg:verseText "Bewildered by false ego, strength, pride, lust and anger, the demons become envious of the Supreme Personality of Godhead, who is situated in their own bodies and in the bodies of others, and blaspheme against the real religion." .

bg:V556 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V555 ;
    bg:nextVerse bg:V557 ;
    bg:precedes bg:V557 ;
    bg:previousVerse bg:V555 ;
    bg:verseID "V556"^^xsd:string ;
    bg:verseNumber "16.19" ;
    bg:verseText "Those who are envious and mischievous, who are the lowest among men, I perpetually cast into the ocean of material existence, into various demoniac species of life." .

bg:V557 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V556 ;
    bg:nextVerse bg:V558 ;
    bg:precedes bg:V558 ;
    bg:previousVerse bg:V556 ;
    bg:verseID "V557"^^xsd:string ;
    bg:verseNumber "16.20" ;
    bg:verseText "Attaining repeated birth amongst the species of demoniac life, O son of Kuntī, such persons can never approach Me. Gradually they sink down to the most abominable type of existence." .

bg:V558 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V557 ;
    bg:nextVerse bg:V559 ;
    bg:precedes bg:V559 ;
    bg:previousVerse bg:V557 ;
    bg:verseID "V558"^^xsd:string ;
    bg:verseNumber "16.21" ;
    bg:verseText "There are three gates leading to this hell—lust, anger and greed. Every sane man should give these up, for they lead to the degradation of the soul." .

bg:V559 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V558 ;
    bg:nextVerse bg:V560 ;
    bg:precedes bg:V560 ;
    bg:previousVerse bg:V558 ;
    bg:verseID "V559"^^xsd:string ;
    bg:verseNumber "16.22" ;
    bg:verseText "The man who has escaped these three gates of hell, O son of Kuntī, performs acts conducive to self-realization and thus gradually attains the supreme destination." .

bg:V560 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V559 ;
    bg:nextVerse bg:V561 ;
    bg:precedes bg:V561 ;
    bg:previousVerse bg:V559 ;
    bg:verseID "V560"^^xsd:string ;
    bg:verseNumber "16.23" ;
    bg:verseText "He who discards scriptural injunctions and acts according to his own whims attains neither perfection, nor happiness, nor the supreme destination." .

bg:V561 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH16 ;
    bg:follows bg:V560 ;
    bg:nextVerse bg:V562 ;
    bg:precedes bg:V562 ;
    bg:previousVerse bg:V560 ;
    bg:verseID "V561"^^xsd:string ;
    bg:verseNumber "16.24" ;
    bg:verseText "One should therefore understand what is duty and what is not duty by the regulations of the scriptures. Knowing such rules and regulations, one should act so that he may gradually be elevated." .

bg:V562 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V561 ;
    bg:nextVerse bg:V563 ;
    bg:precedes bg:V563 ;
    bg:previousVerse bg:V561 ;
    bg:verseID "V562"^^xsd:string ;
    bg:verseNumber "17.1" ;
    bg:verseText "Arjuna inquired: O Kṛṣṇa, what is the situation of those who do not follow the principles of scripture but worship according to their own imagination? Are they in goodness, in passion or in ignorance?" .

bg:V563 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V562 ;
    bg:nextVerse bg:V564 ;
    bg:precedes bg:V564 ;
    bg:previousVerse bg:V562 ;
    bg:verseID "V563"^^xsd:string ;
    bg:verseNumber "17.2" ;
    bg:verseText "The Supreme Personality of Godhead said: According to the modes of nature acquired by the embodied soul, one’s faith can be of three kinds—in goodness, in passion or in ignorance. Now hear about this." .

bg:V564 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V563 ;
    bg:nextVerse bg:V565 ;
    bg:precedes bg:V565 ;
    bg:previousVerse bg:V563 ;
    bg:verseID "V564"^^xsd:string ;
    bg:verseNumber "17.3" ;
    bg:verseText "O son of Bharata, according to one’s existence under the various modes of nature, one evolves a particular kind of faith. The living being is said to be of a particular faith according to the modes he has acquired." .

bg:V565 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V564 ;
    bg:nextVerse bg:V566 ;
    bg:precedes bg:V566 ;
    bg:previousVerse bg:V564 ;
    bg:verseID "V565"^^xsd:string ;
    bg:verseNumber "17.4" ;
    bg:verseText "Men in the mode of goodness worship the demigods; those in the mode of passion worship the demons; and those in the mode of ignorance worship ghosts and spirits." .

bg:V566 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V565 ;
    bg:nextVerse bg:V567 ;
    bg:precedes bg:V567 ;
    bg:previousVerse bg:V565 ;
    bg:verseID "V566"^^xsd:string ;
    bg:verseNumber "17.5–6" ;
    bg:verseText "Those who undergo severe austerities and penances not recommended in the scriptures, performing them out of pride and egoism, who are impelled by lust and attachment, who are foolish and who torture the material elements of the body as well as the Supersoul dwelling within, are to be known as demons." .

bg:V567 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V566 ;
    bg:nextVerse bg:V568 ;
    bg:precedes bg:V568 ;
    bg:previousVerse bg:V566 ;
    bg:verseID "V567"^^xsd:string ;
    bg:verseNumber "17.7" ;
    bg:verseText "Even the food each person prefers is of three kinds, according to the three modes of material nature. The same is true of sacrifices, austerities and charity. Now hear of the distinctions between them." .

bg:V568 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V567 ;
    bg:nextVerse bg:V569 ;
    bg:precedes bg:V569 ;
    bg:previousVerse bg:V567 ;
    bg:verseID "V568"^^xsd:string ;
    bg:verseNumber "17.8" ;
    bg:verseText "Foods dear to those in the mode of goodness increase the duration of life, purify one’s existence and give strength, health, happiness and satisfaction. Such foods are juicy, fatty, wholesome, and pleasing to the heart." .

bg:V569 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V568 ;
    bg:nextVerse bg:V570 ;
    bg:precedes bg:V570 ;
    bg:previousVerse bg:V568 ;
    bg:verseID "V569"^^xsd:string ;
    bg:verseNumber "17.9" ;
    bg:verseText "Foods that are too bitter, too sour, salty, hot, pungent, dry and burning are dear to those in the mode of passion. Such foods cause distress, misery and disease." .

bg:V570 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V569 ;
    bg:nextVerse bg:V571 ;
    bg:precedes bg:V571 ;
    bg:previousVerse bg:V569 ;
    bg:verseID "V570"^^xsd:string ;
    bg:verseNumber "17.10" ;
    bg:verseText "Food prepared more than three hours before being eaten, food that is tasteless, decomposed and putrid, and food consisting of remnants and untouchable things is dear to those in the mode of darkness." .

bg:V571 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V570 ;
    bg:nextVerse bg:V572 ;
    bg:precedes bg:V572 ;
    bg:previousVerse bg:V570 ;
    bg:verseID "V571"^^xsd:string ;
    bg:verseNumber "17.11" ;
    bg:verseText "Of sacrifices, the sacrifice performed according to the directions of scripture, as a matter of duty, by those who desire no reward, is of the nature of goodness." .

bg:V572 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V571 ;
    bg:nextVerse bg:V573 ;
    bg:precedes bg:V573 ;
    bg:previousVerse bg:V571 ;
    bg:verseID "V572"^^xsd:string ;
    bg:verseNumber "17.12" ;
    bg:verseText "But the sacrifice performed for some material benefit, or for the sake of pride, O chief of the Bhāratas, you should know to be in the mode of passion." .

bg:V573 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V572 ;
    bg:nextVerse bg:V574 ;
    bg:precedes bg:V574 ;
    bg:previousVerse bg:V572 ;
    bg:verseID "V573"^^xsd:string ;
    bg:verseNumber "17.13" ;
    bg:verseText "Any sacrifice performed without regard for the directions of scripture, without distribution of prasādam (spiritual food), without chanting of Vedic hymns and remunerations to the priests, and without faith is considered to be in the mode of ignorance." .

bg:V574 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V573 ;
    bg:nextVerse bg:V575 ;
    bg:precedes bg:V575 ;
    bg:previousVerse bg:V573 ;
    bg:verseID "V574"^^xsd:string ;
    bg:verseNumber "17.14" ;
    bg:verseText "Austerity of the body consists in worship of the Supreme Lord, the brāhmaṇas, the spiritual master, and superiors like the father and mother, and in cleanliness, simplicity, celibacy and nonviolence." .

bg:V575 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V574 ;
    bg:nextVerse bg:V576 ;
    bg:precedes bg:V576 ;
    bg:previousVerse bg:V574 ;
    bg:verseID "V575"^^xsd:string ;
    bg:verseNumber "17.15" ;
    bg:verseText "Austerity of speech consists in speaking words that are truthful, pleasing, beneficial, and not agitating to others, and also in regularly reciting Vedic literature." .

bg:V576 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V575 ;
    bg:nextVerse bg:V577 ;
    bg:precedes bg:V577 ;
    bg:previousVerse bg:V575 ;
    bg:verseID "V576"^^xsd:string ;
    bg:verseNumber "17.16" ;
    bg:verseText "And satisfaction, simplicity, gravity, self-control and purification of one’s existence are the austerities of the mind." .

bg:V577 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V576 ;
    bg:nextVerse bg:V578 ;
    bg:precedes bg:V578 ;
    bg:previousVerse bg:V576 ;
    bg:verseID "V577"^^xsd:string ;
    bg:verseNumber "17.17" ;
    bg:verseText "This threefold austerity, performed with transcendental faith by men not expecting material benefits but engaged only for the sake of the Supreme, is called austerity in goodness." .

bg:V578 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V577 ;
    bg:nextVerse bg:V579 ;
    bg:precedes bg:V579 ;
    bg:previousVerse bg:V577 ;
    bg:verseID "V578"^^xsd:string ;
    bg:verseNumber "17.18" ;
    bg:verseText "Penance performed out of pride and for the sake of gaining respect, honor and worship is said to be in the mode of passion. It is neither stable nor permanent." .

bg:V579 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V578 ;
    bg:nextVerse bg:V580 ;
    bg:precedes bg:V580 ;
    bg:previousVerse bg:V578 ;
    bg:verseID "V579"^^xsd:string ;
    bg:verseNumber "17.19" ;
    bg:verseText "Penance performed out of foolishness, with self-torture or to destroy or injure others, is said to be in the mode of ignorance." .

bg:V580 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V579 ;
    bg:nextVerse bg:V581 ;
    bg:precedes bg:V581 ;
    bg:previousVerse bg:V579 ;
    bg:verseID "V580"^^xsd:string ;
    bg:verseNumber "17.20" ;
    bg:verseText "Charity given out of duty, without expectation of return, at the proper time and place, and to a worthy person is considered to be in the mode of goodness." .

bg:V581 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V580 ;
    bg:nextVerse bg:V582 ;
    bg:precedes bg:V582 ;
    bg:previousVerse bg:V580 ;
    bg:verseID "V581"^^xsd:string ;
    bg:verseNumber "17.21" ;
    bg:verseText "But charity performed with the expectation of some return, or with a desire for fruitive results, or in a grudging mood is said to be charity in the mode of passion." .

bg:V582 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V581 ;
    bg:nextVerse bg:V583 ;
    bg:precedes bg:V583 ;
    bg:previousVerse bg:V581 ;
    bg:verseID "V582"^^xsd:string ;
    bg:verseNumber "17.22" ;
    bg:verseText "And charity performed at an impure place, at an improper time, to unworthy persons, or without proper attention and respect is said to be in the mode of ignorance." .

bg:V583 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V582 ;
    bg:nextVerse bg:V584 ;
    bg:precedes bg:V584 ;
    bg:previousVerse bg:V582 ;
    bg:verseID "V583"^^xsd:string ;
    bg:verseNumber "17.23" ;
    bg:verseText "From the beginning of creation, the three words oṁ tat sat were used to indicate the Supreme Absolute Truth. These three symbolic representations were used by brāhmaṇas while chanting the hymns of the Vedas and during sacrifices for the satisfaction of the Supreme." .

bg:V584 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V583 ;
    bg:nextVerse bg:V585 ;
    bg:precedes bg:V585 ;
    bg:previousVerse bg:V583 ;
    bg:verseID "V584"^^xsd:string ;
    bg:verseNumber "17.24" ;
    bg:verseText "Therefore, transcendentalists undertaking performances of sacrifice, charity and penance in accordance with scriptural regulations begin always with oṁ, to attain the Supreme." .

bg:V585 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V584 ;
    bg:nextVerse bg:V586 ;
    bg:precedes bg:V586 ;
    bg:previousVerse bg:V584 ;
    bg:verseID "V585"^^xsd:string ;
    bg:verseNumber "17.25" ;
    bg:verseText "Without desiring fruitive results, one should perform various kinds of sacrifice, penance and charity with the word tat. The purpose of such transcendental activities is to get free from material entanglement." .

bg:V586 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V585 ;
    bg:nextVerse bg:V587 ;
    bg:precedes bg:V587 ;
    bg:previousVerse bg:V585 ;
    bg:verseID "V586"^^xsd:string ;
    bg:verseNumber "17.26–27" ;
    bg:verseText "The Absolute Truth is the objective of devotional sacrifice, and it is indicated by the word sat. The performer of such sacrifice is also called sat, as are all works of sacrifice, penance and charity which, true to the absolute nature, are performed to please the Supreme Person, O son of Pṛthā." .

bg:V587 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH17 ;
    bg:follows bg:V586 ;
    bg:nextVerse bg:V588 ;
    bg:precedes bg:V588 ;
    bg:previousVerse bg:V586 ;
    bg:verseID "V587"^^xsd:string ;
    bg:verseNumber "17.28" ;
    bg:verseText "Anything done as sacrifice, charity or penance without faith in the Supreme, O son of Pṛthā, is impermanent. It is called asat and is useless both in this life and the next." .

bg:V588 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V587 ;
    bg:nextVerse bg:V589 ;
    bg:precedes bg:V589 ;
    bg:previousVerse bg:V587 ;
    bg:verseID "V588"^^xsd:string ;
    bg:verseNumber "18.1" ;
    bg:verseText "Arjuna said: O mighty-armed one, I wish to understand the purpose of renunciation [tyāga] and of the renounced order of life [sannyāsa], O killer of the Keśī demon, master of the senses." .

bg:V589 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V588 ;
    bg:nextVerse bg:V590 ;
    bg:precedes bg:V590 ;
    bg:previousVerse bg:V588 ;
    bg:verseID "V589"^^xsd:string ;
    bg:verseNumber "18.2" ;
    bg:verseText "The Supreme Personality of Godhead said: The giving up of activities that are based on material desire is what great learned men call the renounced order of life [sannyāsa]. And giving up the results of all activities is what the wise call renunciation [tyāga]." .

bg:V590 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V589 ;
    bg:nextVerse bg:V591 ;
    bg:precedes bg:V591 ;
    bg:previousVerse bg:V589 ;
    bg:verseID "V590"^^xsd:string ;
    bg:verseNumber "18.3" ;
    bg:verseText "Some learned men declare that all kinds of fruitive activities should be given up as faulty, yet other sages maintain that acts of sacrifice, charity and penance should never be abandoned." .

bg:V591 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V590 ;
    bg:nextVerse bg:V592 ;
    bg:precedes bg:V592 ;
    bg:previousVerse bg:V590 ;
    bg:verseID "V591"^^xsd:string ;
    bg:verseNumber "18.4" ;
    bg:verseText "O best of the Bhāratas, now hear My judgment about renunciation. O tiger among men, renunciation is declared in the scriptures to be of three kinds." .

bg:V592 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V591 ;
    bg:nextVerse bg:V593 ;
    bg:precedes bg:V593 ;
    bg:previousVerse bg:V591 ;
    bg:verseID "V592"^^xsd:string ;
    bg:verseNumber "18.5" ;
    bg:verseText "Acts of sacrifice, charity and penance are not to be given up; they must be performed. Indeed, sacrifice, charity and penance purify even the great souls." .

bg:V593 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V592 ;
    bg:nextVerse bg:V594 ;
    bg:precedes bg:V594 ;
    bg:previousVerse bg:V592 ;
    bg:verseID "V593"^^xsd:string ;
    bg:verseNumber "18.6" ;
    bg:verseText "All these activities should be performed without attachment or any expectation of result. They should be performed as a matter of duty, O son of Pṛthā. That is My final opinion." .

bg:V594 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V593 ;
    bg:nextVerse bg:V595 ;
    bg:precedes bg:V595 ;
    bg:previousVerse bg:V593 ;
    bg:verseID "V594"^^xsd:string ;
    bg:verseNumber "18.7" ;
    bg:verseText "Prescribed duties should never be renounced. If one gives up his prescribed duties because of illusion, such renunciation is said to be in the mode of ignorance." .

bg:V595 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V594 ;
    bg:nextVerse bg:V596 ;
    bg:precedes bg:V596 ;
    bg:previousVerse bg:V594 ;
    bg:verseID "V595"^^xsd:string ;
    bg:verseNumber "18.8" ;
    bg:verseText "Anyone who gives up prescribed duties as troublesome or out of fear of bodily discomfort is said to have renounced in the mode of passion. Such action never leads to the elevation of renunciation." .

bg:V596 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V595 ;
    bg:nextVerse bg:V597 ;
    bg:precedes bg:V597 ;
    bg:previousVerse bg:V595 ;
    bg:verseID "V596"^^xsd:string ;
    bg:verseNumber "18.9" ;
    bg:verseText "O Arjuna, when one performs his prescribed duty only because it ought to be done, and renounces all material association and all attachment to the fruit, his renunciation is said to be in the mode of goodness." .

bg:V597 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V596 ;
    bg:nextVerse bg:V598 ;
    bg:precedes bg:V598 ;
    bg:previousVerse bg:V596 ;
    bg:verseID "V597"^^xsd:string ;
    bg:verseNumber "18.10" ;
    bg:verseText "The intelligent renouncer situated in the mode of goodness, neither hateful of inauspicious work nor attached to auspicious work, has no doubts about work." .

bg:V598 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V597 ;
    bg:nextVerse bg:V599 ;
    bg:precedes bg:V599 ;
    bg:previousVerse bg:V597 ;
    bg:verseID "V598"^^xsd:string ;
    bg:verseNumber "18.11" ;
    bg:verseText "It is indeed impossible for an embodied being to give up all activities. But he who renounces the fruits of action is called one who has truly renounced." .

bg:V599 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V598 ;
    bg:nextVerse bg:V600 ;
    bg:precedes bg:V600 ;
    bg:previousVerse bg:V598 ;
    bg:verseID "V599"^^xsd:string ;
    bg:verseNumber "18.12" ;
    bg:verseText "For one who is not renounced, the threefold fruits of action—desirable, undesirable and mixed—accrue after death. But those who are in the renounced order of life have no such result to suffer or enjoy." .

bg:V600 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V599 ;
    bg:nextVerse bg:V601 ;
    bg:precedes bg:V601 ;
    bg:previousVerse bg:V599 ;
    bg:verseID "V600"^^xsd:string ;
    bg:verseNumber "18.13" ;
    bg:verseText "O mighty-armed Arjuna, according to the Vedānta there are five causes for the accomplishment of all action. Now learn of these from Me." .

bg:V601 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V600 ;
    bg:nextVerse bg:V602 ;
    bg:precedes bg:V602 ;
    bg:previousVerse bg:V600 ;
    bg:verseID "V601"^^xsd:string ;
    bg:verseNumber "18.14" ;
    bg:verseText "The place of action [the body], the performer, the various senses, the many different kinds of endeavor, and ultimately the Supersoul—these are the five factors of action." .

bg:V602 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V601 ;
    bg:nextVerse bg:V603 ;
    bg:precedes bg:V603 ;
    bg:previousVerse bg:V601 ;
    bg:verseID "V602"^^xsd:string ;
    bg:verseNumber "18.15" ;
    bg:verseText "Whatever right or wrong action a man performs by body, mind or speech is caused by these five factors." .

bg:V603 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V602 ;
    bg:nextVerse bg:V604 ;
    bg:precedes bg:V604 ;
    bg:previousVerse bg:V602 ;
    bg:verseID "V603"^^xsd:string ;
    bg:verseNumber "18.16" ;
    bg:verseText "Therefore one who thinks himself the only doer, not considering the five factors, is certainly not very intelligent and cannot see things as they are." .

bg:V604 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V603 ;
    bg:nextVerse bg:V605 ;
    bg:precedes bg:V605 ;
    bg:previousVerse bg:V603 ;
    bg:verseID "V604"^^xsd:string ;
    bg:verseNumber "18.17" ;
    bg:verseText "One who is not motivated by false ego, whose intelligence is not entangled, though he kills men in this world, does not kill. Nor is he bound by his actions." .

bg:V605 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V604 ;
    bg:nextVerse bg:V606 ;
    bg:precedes bg:V606 ;
    bg:previousVerse bg:V604 ;
    bg:verseID "V605"^^xsd:string ;
    bg:verseNumber "18.18" ;
    bg:verseText "Knowledge, the object of knowledge, and the knower are the three factors that motivate action; the senses, the work and the doer are the three constituents of action." .

bg:V606 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V605 ;
    bg:nextVerse bg:V607 ;
    bg:precedes bg:V607 ;
    bg:previousVerse bg:V605 ;
    bg:verseID "V606"^^xsd:string ;
    bg:verseNumber "18.19" ;
    bg:verseText "According to the three different modes of material nature, there are three kinds of knowledge, action and performer of action. Now hear of them from Me." .

bg:V607 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V606 ;
    bg:nextVerse bg:V608 ;
    bg:precedes bg:V608 ;
    bg:previousVerse bg:V606 ;
    bg:verseID "V607"^^xsd:string ;
    bg:verseNumber "18.20" ;
    bg:verseText "That knowledge by which one undivided spiritual nature is seen in all living entities, though they are divided into innumerable forms, you should understand to be in the mode of goodness." .

bg:V608 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V607 ;
    bg:nextVerse bg:V609 ;
    bg:precedes bg:V609 ;
    bg:previousVerse bg:V607 ;
    bg:verseID "V608"^^xsd:string ;
    bg:verseNumber "18.21" ;
    bg:verseText "That knowledge by which one sees that in every different body there is a different type of living entity you should understand to be in the mode of passion." .

bg:V609 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V608 ;
    bg:nextVerse bg:V610 ;
    bg:precedes bg:V610 ;
    bg:previousVerse bg:V608 ;
    bg:verseID "V609"^^xsd:string ;
    bg:verseNumber "18.22" ;
    bg:verseText "And that knowledge by which one is attached to one kind of work as the all in all, without knowledge of the truth, and which is very meager, is said to be in the mode of darkness." .

bg:V610 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V609 ;
    bg:nextVerse bg:V611 ;
    bg:precedes bg:V611 ;
    bg:previousVerse bg:V609 ;
    bg:verseID "V610"^^xsd:string ;
    bg:verseNumber "18.23" ;
    bg:verseText "That action which is regulated and which is performed without attachment, without love or hatred, and without desire for fruitive results is said to be in the mode of goodness." .

bg:V611 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V610 ;
    bg:nextVerse bg:V612 ;
    bg:precedes bg:V612 ;
    bg:previousVerse bg:V610 ;
    bg:verseID "V611"^^xsd:string ;
    bg:verseNumber "18.24" ;
    bg:verseText "But action performed with great effort by one seeking to gratify his desires, and enacted from a sense of false ego, is called action in the mode of passion." .

bg:V612 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V611 ;
    bg:nextVerse bg:V613 ;
    bg:precedes bg:V613 ;
    bg:previousVerse bg:V611 ;
    bg:verseID "V612"^^xsd:string ;
    bg:verseNumber "18.25" ;
    bg:verseText "That action performed in illusion, in disregard of scriptural injunctions, and without concern for future bondage or for violence or distress caused to others is said to be in the mode of ignorance." .

bg:V613 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V612 ;
    bg:nextVerse bg:V614 ;
    bg:precedes bg:V614 ;
    bg:previousVerse bg:V612 ;
    bg:verseID "V613"^^xsd:string ;
    bg:verseNumber "18.26" ;
    bg:verseText "One who performs his duty without association with the modes of material nature, without false ego, with great determination and enthusiasm, and without wavering in success or failure is said to be a worker in the mode of goodness." .

bg:V614 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V613 ;
    bg:nextVerse bg:V615 ;
    bg:precedes bg:V615 ;
    bg:previousVerse bg:V613 ;
    bg:verseID "V614"^^xsd:string ;
    bg:verseNumber "18.27" ;
    bg:verseText "The worker who is attached to work and the fruits of work, desiring to enjoy those fruits, and who is greedy, always envious, impure, and moved by joy and sorrow, is said to be in the mode of passion." .

bg:V615 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V614 ;
    bg:nextVerse bg:V616 ;
    bg:precedes bg:V616 ;
    bg:previousVerse bg:V614 ;
    bg:verseID "V615"^^xsd:string ;
    bg:verseNumber "18.28" ;
    bg:verseText "The worker who is always engaged in work against the injunctions of the scripture, who is materialistic, obstinate, cheating and expert in insulting others, and who is lazy, always morose and procrastinating is said to be a worker in the mode of ignorance." .

bg:V616 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V615 ;
    bg:nextVerse bg:V617 ;
    bg:precedes bg:V617 ;
    bg:previousVerse bg:V615 ;
    bg:verseID "V616"^^xsd:string ;
    bg:verseNumber "18.29" ;
    bg:verseText "O winner of wealth, now please listen as I tell you in detail of the different kinds of understanding and determination, according to the three modes of material nature." .

bg:V617 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V616 ;
    bg:nextVerse bg:V618 ;
    bg:precedes bg:V618 ;
    bg:previousVerse bg:V616 ;
    bg:verseID "V617"^^xsd:string ;
    bg:verseNumber "18.30" ;
    bg:verseText "O son of Pṛthā, that understanding by which one knows what ought to be done and what ought not to be done, what is to be feared and what is not to be feared, what is binding and what is liberating, is in the mode of goodness." .

bg:V618 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V617 ;
    bg:nextVerse bg:V619 ;
    bg:precedes bg:V619 ;
    bg:previousVerse bg:V617 ;
    bg:verseID "V618"^^xsd:string ;
    bg:verseNumber "18.31" ;
    bg:verseText "O son of Pṛthā, that understanding which cannot distinguish between religion and irreligion, between action that should be done and action that should not be done, is in the mode of passion." .

bg:V619 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V618 ;
    bg:nextVerse bg:V620 ;
    bg:precedes bg:V620 ;
    bg:previousVerse bg:V618 ;
    bg:verseID "V619"^^xsd:string ;
    bg:verseNumber "18.32" ;
    bg:verseText "That understanding which considers irreligion to be religion and religion to be irreligion, under the spell of illusion and darkness, and strives always in the wrong direction, O Pārtha, is in the mode of ignorance." .

bg:V620 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V619 ;
    bg:nextVerse bg:V621 ;
    bg:precedes bg:V621 ;
    bg:previousVerse bg:V619 ;
    bg:verseID "V620"^^xsd:string ;
    bg:verseNumber "18.33" ;
    bg:verseText "O son of Pṛthā, that determination which is unbreakable, which is sustained with steadfastness by yoga practice, and which thus controls the activities of the mind, life and senses is determination in the mode of goodness." .

bg:V621 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V620 ;
    bg:nextVerse bg:V622 ;
    bg:precedes bg:V622 ;
    bg:previousVerse bg:V620 ;
    bg:verseID "V621"^^xsd:string ;
    bg:verseNumber "18.34" ;
    bg:verseText "But that determination by which one holds fast to fruitive results in religion, economic development and sense gratification is of the nature of passion, O Arjuna." .

bg:V622 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V621 ;
    bg:nextVerse bg:V623 ;
    bg:precedes bg:V623 ;
    bg:previousVerse bg:V621 ;
    bg:verseID "V622"^^xsd:string ;
    bg:verseNumber "18.35" ;
    bg:verseText "And that determination which cannot go beyond dreaming, fearfulness, lamentation, moroseness and illusion—such unintelligent determination, O son of Pṛthā, is in the mode of darkness." .

bg:V623 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V622 ;
    bg:nextVerse bg:V624 ;
    bg:precedes bg:V624 ;
    bg:previousVerse bg:V622 ;
    bg:verseID "V623"^^xsd:string ;
    bg:verseNumber "18.36" ;
    bg:verseText "O best of the Bhāratas, now please hear from Me about the three kinds of happiness by which the conditioned soul enjoys, and by which he sometimes comes to the end of all distress." .

bg:V624 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V623 ;
    bg:nextVerse bg:V625 ;
    bg:precedes bg:V625 ;
    bg:previousVerse bg:V623 ;
    bg:verseID "V624"^^xsd:string ;
    bg:verseNumber "18.37" ;
    bg:verseText "That which in the beginning may be just like poison but at the end is just like nectar and which awakens one to self-realization is said to be happiness in the mode of goodness." .

bg:V625 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V624 ;
    bg:nextVerse bg:V626 ;
    bg:precedes bg:V626 ;
    bg:previousVerse bg:V624 ;
    bg:verseID "V625"^^xsd:string ;
    bg:verseNumber "18.38" ;
    bg:verseText "That happiness which is derived from contact of the senses with their objects and which appears like nec" .

bg:V626 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V625 ;
    bg:nextVerse bg:V627 ;
    bg:precedes bg:V627 ;
    bg:previousVerse bg:V625 ;
    bg:verseID "V626"^^xsd:string ;
    bg:verseNumber "18.39" ;
    bg:verseText "And that happiness which is blind to self-realization, which is delusion from beginning to end and which arises from sleep, laziness and illusion is said to be of the nature of ignorance." .

bg:V627 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V626 ;
    bg:nextVerse bg:V628 ;
    bg:precedes bg:V628 ;
    bg:previousVerse bg:V626 ;
    bg:verseID "V627"^^xsd:string ;
    bg:verseNumber "18.40" ;
    bg:verseText "There is no being existing, either here or among the demigods in the higher planetary systems, which is freed from these three modes born of material nature." .

bg:V628 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V627 ;
    bg:nextVerse bg:V629 ;
    bg:precedes bg:V629 ;
    bg:previousVerse bg:V627 ;
    bg:verseID "V628"^^xsd:string ;
    bg:verseNumber "18.41" ;
    bg:verseText "Brāhmaṇas, kṣatriyas, vaiśyas and śūdras are distinguished by the qualities born of their own natures in accordance with the material modes, O chastiser of the enemy." .

bg:V629 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V628 ;
    bg:nextVerse bg:V630 ;
    bg:precedes bg:V630 ;
    bg:previousVerse bg:V628 ;
    bg:verseID "V629"^^xsd:string ;
    bg:verseNumber "18.42" ;
    bg:verseText "Peacefulness, self-control, austerity, purity, tolerance, honesty, knowledge, wisdom and religiousness—these are the natural qualities by which the brāhmaṇas work." .

bg:V630 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V629 ;
    bg:nextVerse bg:V631 ;
    bg:precedes bg:V631 ;
    bg:previousVerse bg:V629 ;
    bg:verseID "V630"^^xsd:string ;
    bg:verseNumber "18.43" ;
    bg:verseText "Heroism, power, determination, resourcefulness, courage in battle, generosity and leadership are the natural qualities of work for the kṣatriyas." .

bg:V631 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V630 ;
    bg:nextVerse bg:V632 ;
    bg:precedes bg:V632 ;
    bg:previousVerse bg:V630 ;
    bg:verseID "V631"^^xsd:string ;
    bg:verseNumber "18.44" ;
    bg:verseText "Farming, cow protection and business are the natural work for the vaiśyas, and for the śūdras there are labor and service to others." .

bg:V632 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V631 ;
    bg:nextVerse bg:V633 ;
    bg:precedes bg:V633 ;
    bg:previousVerse bg:V631 ;
    bg:verseID "V632"^^xsd:string ;
    bg:verseNumber "18.45" ;
    bg:verseText "By following his qualities of work, every man can become perfect. Now please hear from Me how this can be done." .

bg:V633 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V632 ;
    bg:nextVerse bg:V634 ;
    bg:precedes bg:V634 ;
    bg:previousVerse bg:V632 ;
    bg:verseID "V633"^^xsd:string ;
    bg:verseNumber "18.46" ;
    bg:verseText "By worship of the Lord, who is the source of all beings and who is all-pervading, a man can attain perfection through performing his own work." .

bg:V634 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V633 ;
    bg:nextVerse bg:V635 ;
    bg:precedes bg:V635 ;
    bg:previousVerse bg:V633 ;
    bg:verseID "V634"^^xsd:string ;
    bg:verseNumber "18.47" ;
    bg:verseText "It is better to engage in one’s own occupation, even though one may perform it imperfectly, than to accept another’s occupation and perform it perfectly. Duties prescribed according to one’s nature are never affected by sinful reactions." .

bg:V635 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V634 ;
    bg:nextVerse bg:V636 ;
    bg:precedes bg:V636 ;
    bg:previousVerse bg:V634 ;
    bg:verseID "V635"^^xsd:string ;
    bg:verseNumber "18.48" ;
    bg:verseText "Every endeavor is covered by some fault, just as fire is covered by smoke. Therefore one should not give up the work born of his nature, O son of Kuntī, even if such work is full of fault." .

bg:V636 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V635 ;
    bg:nextVerse bg:V637 ;
    bg:precedes bg:V637 ;
    bg:previousVerse bg:V635 ;
    bg:verseID "V636"^^xsd:string ;
    bg:verseNumber "18.49" ;
    bg:verseText "One who is self-controlled and unattached and who disregards all material enjoyments can obtain, by practice of renunciation, the highest perfect stage of freedom from reaction." .

bg:V637 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V636 ;
    bg:nextVerse bg:V638 ;
    bg:precedes bg:V638 ;
    bg:previousVerse bg:V636 ;
    bg:verseID "V637"^^xsd:string ;
    bg:verseNumber "18.50" ;
    bg:verseText "O son of Kuntī, learn from Me how one who has achieved this perfection can attain to the supreme perfectional stage, Brahman, the stage of highest knowledge, by acting in the way I shall now summarize." .

bg:V638 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V637 ;
    bg:nextVerse bg:V639 ;
    bg:precedes bg:V639 ;
    bg:previousVerse bg:V637 ;
    bg:verseID "V638"^^xsd:string ;
    bg:verseNumber "18.51–53" ;
    bg:verseText "Being purified by his intelligence and controlling the mind with determination, giving up the objects of sense gratification, being freed from attachment and hatred, one who lives in a secluded place, who eats little, who controls his body, mind and power of speech, who is always in trance and who is detached, free from false ego, false strength, false pride, lust, anger, and acceptance of material things, free from false proprietorship, and peaceful—such a person is certainly elevated to the position of self-realization." .

bg:V639 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V638 ;
    bg:nextVerse bg:V640 ;
    bg:precedes bg:V640 ;
    bg:previousVerse bg:V638 ;
    bg:verseID "V639"^^xsd:string ;
    bg:verseNumber "18.54" ;
    bg:verseText "One who is thus transcendentally situated at once realizes the Supreme Brahman and becomes fully joyful. He never laments or desires to have anything. He is equally disposed toward every living entity. In that state he attains pure devotional service unto Me." .

bg:V640 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V639 ;
    bg:nextVerse bg:V641 ;
    bg:precedes bg:V641 ;
    bg:previousVerse bg:V639 ;
    bg:verseID "V640"^^xsd:string ;
    bg:verseNumber "18.55" ;
    bg:verseText "One can understand Me as I am, as the Supreme Personality of Godhead, only by devotional service. And when one is in full consciousness of Me by such devotion, he can enter into the kingdom of God." .

bg:V641 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V640 ;
    bg:nextVerse bg:V642 ;
    bg:precedes bg:V642 ;
    bg:previousVerse bg:V640 ;
    bg:verseID "V641"^^xsd:string ;
    bg:verseNumber "18.56" ;
    bg:verseText "Though engaged in all kinds of activities, My pure devotee, under My protection, reaches the eternal and imperishable abode by My grace." .

bg:V642 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V641 ;
    bg:nextVerse bg:V643 ;
    bg:precedes bg:V643 ;
    bg:previousVerse bg:V641 ;
    bg:verseID "V642"^^xsd:string ;
    bg:verseNumber "18.57" ;
    bg:verseText "In all activities just depend upon Me and work always under My protection. In such devotional service, be fully conscious of Me." .

bg:V643 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V642 ;
    bg:nextVerse bg:V644 ;
    bg:precedes bg:V644 ;
    bg:previousVerse bg:V642 ;
    bg:verseID "V643"^^xsd:string ;
    bg:verseNumber "18.58" ;
    bg:verseText "If you become conscious of Me, you will pass over all the obstacles of conditioned life by My grace. If, however, you do not work in such consciousness but act through false ego, not hearing Me, you will be lost." .

bg:V644 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V643 ;
    bg:nextVerse bg:V645 ;
    bg:precedes bg:V645 ;
    bg:previousVerse bg:V643 ;
    bg:verseID "V644"^^xsd:string ;
    bg:verseNumber "18.59" ;
    bg:verseText "If you do not act according to My direction and do not fight, then you will be falsely directed. By your nature, you will have to be engaged in warfare." .

bg:V645 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V644 ;
    bg:nextVerse bg:V646 ;
    bg:precedes bg:V646 ;
    bg:previousVerse bg:V644 ;
    bg:verseID "V645"^^xsd:string ;
    bg:verseNumber "18.60" ;
    bg:verseText "Under illusion you are now declining to act according to My direction. But, compelled by the work born of your own nature, you will act all the same, O son of Kuntī." .

bg:V646 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V645 ;
    bg:nextVerse bg:V647 ;
    bg:precedes bg:V647 ;
    bg:previousVerse bg:V645 ;
    bg:verseID "V646"^^xsd:string ;
    bg:verseNumber "18.61" ;
    bg:verseText "The Supreme Lord is situated in everyone’s heart, O Arjuna, and is directing the wanderings of all living entities, who are seated as on a machine, made of the material energy." .

bg:V647 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V646 ;
    bg:nextVerse bg:V648 ;
    bg:precedes bg:V648 ;
    bg:previousVerse bg:V646 ;
    bg:verseID "V647"^^xsd:string ;
    bg:verseNumber "18.62" ;
    bg:verseText "O scion of Bharata, surrender unto Him utterly. By His grace you will attain transcendental peace and the supreme and eternal abode." .

bg:V648 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V647 ;
    bg:nextVerse bg:V649 ;
    bg:precedes bg:V649 ;
    bg:previousVerse bg:V647 ;
    bg:verseID "V648"^^xsd:string ;
    bg:verseNumber "18.63" ;
    bg:verseText "Thus I have explained to you knowledge still more confidential. Deliberate on this fully, and then do what you wish to do." .

bg:V649 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V648 ;
    bg:nextVerse bg:V650 ;
    bg:precedes bg:V650 ;
    bg:previousVerse bg:V648 ;
    bg:verseID "V649"^^xsd:string ;
    bg:verseNumber "18.64" ;
    bg:verseText "Because you are My very dear friend, I am speaking to you My supreme instruction, the most confidential knowledge of all. Hear this from Me, for it is for your benefit." .

bg:V650 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V649 ;
    bg:nextVerse bg:V651 ;
    bg:precedes bg:V651 ;
    bg:previousVerse bg:V649 ;
    bg:verseID "V650"^^xsd:string ;
    bg:verseNumber "18.65" ;
    bg:verseText "Always think of Me, become My devotee, worship Me and offer your homage unto Me. Thus you will come to Me without fail. I promise you this because you are My very dear friend." .

bg:V651 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V650 ;
    bg:nextVerse bg:V652 ;
    bg:precedes bg:V652 ;
    bg:previousVerse bg:V650 ;
    bg:verseID "V651"^^xsd:string ;
    bg:verseNumber "18.66" ;
    bg:verseText "Abandon all varieties of religion and just surrender unto Me. I shall deliver you from all sinful reactions. Do not fear." .

bg:V652 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V651 ;
    bg:nextVerse bg:V653 ;
    bg:precedes bg:V653 ;
    bg:previousVerse bg:V651 ;
    bg:verseID "V652"^^xsd:string ;
    bg:verseNumber "18.67" ;
    bg:verseText "This confidential knowledge may never be explained to those who are not austere, or devoted, or engaged in devotional service, nor to one who is envious of Me." .

bg:V653 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V652 ;
    bg:nextVerse bg:V654 ;
    bg:precedes bg:V654 ;
    bg:previousVerse bg:V652 ;
    bg:verseID "V653"^^xsd:string ;
    bg:verseNumber "18.68" ;
    bg:verseText "For one who explains this supreme secret to the devotees, pure devotional service is guaranteed, and at the end he will come back to Me." .

bg:V654 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V653 ;
    bg:nextVerse bg:V655 ;
    bg:precedes bg:V655 ;
    bg:previousVerse bg:V653 ;
    bg:verseID "V654"^^xsd:string ;
    bg:verseNumber "18.69" ;
    bg:verseText "There is no servant in this world more dear to Me than he, nor will there ever be one more dear." .

bg:V655 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V654 ;
    bg:nextVerse bg:V656 ;
    bg:precedes bg:V656 ;
    bg:previousVerse bg:V654 ;
    bg:verseID "V655"^^xsd:string ;
    bg:verseNumber "18.70" ;
    bg:verseText "And I declare that he who studies this sacred conversation of ours worships Me by his intelligence." .

bg:V656 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V655 ;
    bg:nextVerse bg:V657 ;
    bg:precedes bg:V657 ;
    bg:previousVerse bg:V655 ;
    bg:verseID "V656"^^xsd:string ;
    bg:verseNumber "18.71" ;
    bg:verseText "And one who listens with faith and without envy becomes free from sinful reactions and attains to the auspicious planets where the pious dwell." .

bg:V657 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V656 ;
    bg:nextVerse bg:V658 ;
    bg:precedes bg:V658 ;
    bg:previousVerse bg:V656 ;
    bg:verseID "V657"^^xsd:string ;
    bg:verseNumber "18.72" ;
    bg:verseText "O son of Pṛthā, O conqueror of wealth, have you heard this with an attentive mind? And are your ignorance and illusions now dispelled?" .

bg:V658 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V657 ;
    bg:nextVerse bg:V659 ;
    bg:precedes bg:V659 ;
    bg:previousVerse bg:V657 ;
    bg:verseID "V658"^^xsd:string ;
    bg:verseNumber "18.73" ;
    bg:verseText "Arjuna said: My dear Kṛṣṇa, O infallible one, my illusion is now gone. I have regained my memory by Your mercy. I am now firm and free from doubt and am prepared to act according to Your instructions." .

bg:V659 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V658 ;
    bg:nextVerse bg:V660 ;
    bg:precedes bg:V660 ;
    bg:previousVerse bg:V658 ;
    bg:verseID "V659"^^xsd:string ;
    bg:verseNumber "18.74" ;
    bg:verseText "Sañjaya said: Thus have I heard the conversation of two great souls, Kṛṣṇa and Arjuna. And so wonderful is that message that my hair is standing on end." .

bg:V660 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V659 ;
    bg:nextVerse bg:V661 ;
    bg:precedes bg:V661 ;
    bg:previousVerse bg:V659 ;
    bg:verseID "V660"^^xsd:string ;
    bg:verseNumber "18.75" ;
    bg:verseText "By the mercy of Vyāsa, I have heard these most confidential talks directly from the master of all mysticism, Kṛṣṇa, who was speaking personally to Arjuna." .

bg:V661 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V660 ;
    bg:nextVerse bg:V662 ;
    bg:precedes bg:V662 ;
    bg:previousVerse bg:V660 ;
    bg:verseID "V661"^^xsd:string ;
    bg:verseNumber "18.76" ;
    bg:verseText "O King, as I repeatedly recall this wondrous and holy dialogue between Kṛṣṇa and Arjuna, I take pleasure, being thrilled at every moment." .

bg:V662 a bg:Verse,
        owl:NamedIndividual ;
    bg:belongsToChapter bg:CH18 ;
    bg:follows bg:V661 ;
    bg:nextVerse bg:V663 ;
    bg:precedes bg:V663 ;
    bg:previousVerse bg:V661 ;
    bg:verseID "V662"^^xsd:string ;
    bg:verseNumber "18.77" ;
    bg:verseText "O King, as I remember the wonderful form of Lord Kṛṣṇa, I am struck with wonder more and more, and I rejoice again and again." .

