        owl:NamedIndividual ;
    rdfs:label "One becomes envious of the Supreme and rejects authentic religion" .

bglo:Effect_CH16_FL16 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One takes birth in demoniac conditions of existence" .

