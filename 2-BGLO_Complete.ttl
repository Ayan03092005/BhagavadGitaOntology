        owl:NamedIndividual ;
    rdfs:label "One becomes deluded by ignorance and false self-conceptions" .

bglo:Effect_CH16_FL13 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One falls into degraded states of existence" .

