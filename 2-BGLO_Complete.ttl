    rdfs:label "They originate from Kṛṣṇa and cannot fully know His origin" .

bglo:Effect_CH10_FL10 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "They experience satisfaction and spiritual bliss" .

bglo:Effect_CH10_FL11 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Kṛṣṇa grants the understanding by which one can attain Him" .

bglo:Effect_CH10_FL12 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Ignorance is destroyed by the lamp of knowledge" .

bglo:Effect_CH10_FL13 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Kṛṣṇa is represented by their highest or most eminent manifestation" .

bglo:Effect_CH10_FL14 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Their supreme excellence manifests Kṛṣṇa’s presence" .

bglo:Effect_CH10_FL15 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "They express divine opulence" .

bglo:Effect_CH10_FL16 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Kṛṣṇa is its generating seed" .

bglo:Effect_CH10_FL17 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "They are only partial indications of Kṛṣṇa’s infinite opulence" .

bglo:Effect_CH10_FL18 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It arises from a spark of Kṛṣṇa’s splendor" .

bglo:Effect_CH10_FL19 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It is sustained and pervaded by a fragment of Kṛṣṇa’s power" .

bglo:Effect_CH10_FL2 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes free from sins and delusion" .

bglo:Effect_CH10_FL20 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Its existence depends upon Kṛṣṇa" .

bglo:Effect_CH10_FL21 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One should recognize it as a manifestation of the Divine" .

bglo:Effect_CH10_FL3 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "All descend from beings originating from Kṛṣṇa" .

bglo:Effect_CH10_FL4 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Kṛṣṇa is their ultimate source and origin" .

bglo:Effect_CH10_FL5 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Kṛṣṇa exists as the Supersoul and as their beginning, middle, and end" .

bglo:Effect_CH10_FL6 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "These qualities arise from Kṛṣṇa" .

bglo:Effect_CH10_FL7 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "They originate from Kṛṣṇa" .

bglo:Effect_CH10_FL8 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One engages in unalloyed devotional service" .

bglo:Effect_CH10_FL9 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One worships Him wholeheartedly in devotion" .

bglo:Effect_CH11_FL1 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Divine vision is required to perceive it" .

bglo:Effect_CH11_FL10 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Individual outcomes unfold according to divine destiny" .

bglo:Effect_CH11_FL11 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes an instrument of the Supreme purpose" .

bglo:Effect_CH11_FL12 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One should perform prescribed duty without fear or hesitation" .

bglo:Effect_CH11_FL13 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One offers obeisances, praise, and worship" .

bglo:Effect_CH11_FL14 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "He is recognized as the cause of all causes and the highest reality" .

bglo:Effect_CH11_FL15 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One repents past familiarity and seeks forgiveness" .

bglo:Effect_CH11_FL16 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "He is worthy of worship by all living entities" .

bglo:Effect_CH11_FL17 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The Supreme cannot be fully seen or known thereby" .

bglo:Effect_CH11_FL18 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One can truly know and directly perceive the Supreme" .

bglo:Effect_CH11_FL19 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One enters into the mysteries of the Supreme" .

bglo:Effect_CH11_FL2 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The universal form becomes perceivable" .

bglo:Effect_CH11_FL20 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One certainly attains the Supreme" .

bglo:Effect_CH11_FL3 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Illusion is dispelled" .

bglo:Effect_CH11_FL4 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "All moving and nonmoving realities are seen within the Supreme" .

bglo:Effect_CH11_FL5 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It possesses no beginning, middle, or end and extends infinitely" .

bglo:Effect_CH11_FL6 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The Supreme is the ultimate refuge, maintainer, and resting place of the universe" .

bglo:Effect_CH11_FL7 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The entire cosmos is pervaded by Him" .

bglo:Effect_CH11_FL8 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The Supreme manifests as Time, the destroyer of worlds" .

bglo:Effect_CH11_FL9 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Their destruction is already ordained" .

bglo:Effect_CH12_FL1 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes the most perfect yogī/devotee" .

bglo:Effect_CH12_FL10 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes self-situated and spiritually elevated" .

bglo:Effect_CH12_FL11 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Such a devotee is dear to Kṛṣṇa" .

bglo:Effect_CH12_FL12 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Such a devotee is very dear to Kṛṣṇa" .

bglo:Effect_CH12_FL13 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Such a devotee is very dear to Kṛṣṇa" .

bglo:Effect_CH12_FL14 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Such a devotee is very dear to Kṛṣṇa" .

bglo:Effect_CH12_FL15 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Such a devotee is very dear to Kṛṣṇa" .

bglo:Effect_CH12_FL16 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Such a devotee is very dear to Kṛṣṇa" .

bglo:Effect_CH12_FL17 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One exhibits authentic spiritual realization" .

bglo:Effect_CH12_FL18 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One embodies the qualities of a beloved devotee" .

bglo:Effect_CH12_FL19 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One is liberated from the cycle of birth and death" .

bglo:Effect_CH12_FL2 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One ultimately attains the Supreme" .

bglo:Effect_CH12_FL20 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One gains divine acceptance and spiritual fulfillment" .

bglo:Effect_CH12_FL3 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One advances toward perfection and spiritual realization" .

bglo:Effect_CH12_FL4 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Spiritual advancement becomes difficult and troublesome" .

bglo:Effect_CH12_FL5 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Kṛṣṇa delivers such a devotee from the ocean of birth and death" .

bglo:Effect_CH12_FL6 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One lives in Him always and attains spiritual union" .

bglo:Effect_CH12_FL7 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One reaches the perfect spiritual stage" .

bglo:Effect_CH12_FL8 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes exceedingly dear to Kṛṣṇa" .

bglo:Effect_CH12_FL9 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains peace of mind" .

bglo:Effect_CH13_FL1 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It is designated as the Field (Ksetra)" .

bglo:Effect_CH13_FL10 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Such qualities constitute true knowledge" .

bglo:Effect_CH13_FL11 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One embodies authentic knowledge" .

bglo:Effect_CH13_FL12 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One remains in ignorance" .

bglo:Effect_CH13_FL13 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Brahman is eternal and transcendental" .

bglo:Effect_CH13_FL14 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "He pervades everything" .

bglo:Effect_CH13_FL15 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "He is simultaneously inside and outside all existence" .

bglo:Effect_CH13_FL16 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The Supreme is knowledge, the object of knowledge, and its ultimate goal" .

bglo:Effect_CH13_FL17 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "He acts as overseer, permitter, proprietor, and transcendental enjoyer" .

bglo:Effect_CH13_FL18 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "He experiences enjoyment, suffering, and rebirth" .

bglo:Effect_CH13_FL19 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It encounters good and evil conditions among species" .

bglo:Effect_CH13_FL2 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It is called the knower of the Field (Ksetrajna)" .

bglo:Effect_CH13_FL20 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One remains subject to rebirth and material existence" .

bglo:Effect_CH13_FL21 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains liberation and avoids rebirth" .

bglo:Effect_CH13_FL22 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "All can lead to realization of the Supersoul" .

bglo:Effect_CH13_FL23 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One transcends birth and death" .

bglo:Effect_CH13_FL24 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "He attains the nature of the Supreme" .

bglo:Effect_CH13_FL25 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One truly sees reality" .

bglo:Effect_CH13_FL26 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One avoids self-degradation and approaches the transcendental destination" .

bglo:Effect_CH13_FL27 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains the Brahman conception" .

bglo:Effect_CH13_FL28 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One possesses true spiritual vision" .

bglo:Effect_CH13_FL29 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The self performs no material action" .

bglo:Effect_CH13_FL3 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "He is the universal knower of all fields" .

bglo:Effect_CH13_FL30 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The soul is eternal, imperishable, and beyond the modes" .

bglo:Effect_CH13_FL31 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It remains unattached and unaffected by bodily conditions" .

bglo:Effect_CH13_FL32 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Consciousness illuminates and animates the entire body" .

bglo:Effect_CH13_FL33 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains the supreme goal" .

bglo:Effect_CH13_FL34 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes liberated from future rebirth" .

bglo:Effect_CH13_FL4 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One possesses true knowledge" .

bglo:Effect_CH13_FL5 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It consists of a combination of field and knower of the field" .

bglo:Effect_CH13_FL6 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "These collectively constitute the field of activities" .

bglo:Effect_CH13_FL7 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Material transformations and modes arise" .

bglo:Effect_CH13_FL8 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Material causes and effects are produced" .

bglo:Effect_CH13_FL9 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Actions are performed by nature rather than the self" .

bglo:Effect_CH14_FL1 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains supreme perfection" .

bglo:Effect_CH14_FL10 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes bound by madness, indolence, sleep, and delusion" .

bglo:Effect_CH14_FL11 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Genuine knowledge develops" .

bglo:Effect_CH14_FL12 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains higher purified realms" .

bglo:Effect_CH14_FL13 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Pure and pious results are obtained" .

bglo:Effect_CH14_FL14 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One progresses upward toward higher states of existence" .

bglo:Effect_CH14_FL15 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Attachment, hankering, and intense striving arise" .

bglo:Effect_CH14_FL16 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Greed develops" .

bglo:Effect_CH14_FL17 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One experiences misery and is reborn among fruitive workers" .

bglo:Effect_CH14_FL18 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Darkness, illusion, inertia, and madness manifest" .

bglo:Effect_CH14_FL19 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Foolishness and delusion arise" .

bglo:Effect_CH14_FL2 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains a transcendental nature similar to the Lord's" .

bglo:Effect_CH14_FL20 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One descends to lower births and degraded worlds" .

bglo:Effect_CH14_FL21 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "They continuously compete for supremacy" .

bglo:Effect_CH14_FL22 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Corresponding psychological and behavioral symptoms emerge" .

bglo:Effect_CH14_FL23 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One recognizes that the modes perform all actions" .

bglo:Effect_CH14_FL24 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains the spiritual nature of the Lord" .

bglo:Effect_CH14_FL25 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes free from birth, death, old age, and distress" .

bglo:Effect_CH14_FL26 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One is recognized as transcendent to the modes" .

bglo:Effect_CH14_FL27 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One has transcended material nature" .

bglo:Effect_CH14_FL28 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One transcends the three modes and attains the Brahman platform" .

bglo:Effect_CH14_FL29 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The Supreme Lord is recognized as its eternal foundation" .

bglo:Effect_CH14_FL3 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One is not reborn at creation nor disturbed at dissolution" .

bglo:Effect_CH14_FL4 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains the Lord's spiritual nature" .

bglo:Effect_CH14_FL5 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It becomes the source of embodied existence" .

bglo:Effect_CH14_FL6 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The Supreme Lord is their seed-giving father" .

bglo:Effect_CH14_FL7 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The soul becomes conditioned by the three modes" .

bglo:Effect_CH14_FL8 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes attached to happiness and knowledge" .

bglo:Effect_CH14_FL9 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes bound by desire and fruitive activity" .

bglo:Effect_CH15_FL1 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Material existence is characterized as an imperishable tree rooted in transcendence and expressed through Vedic order" .

bglo:Effect_CH15_FL10 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It acquires another body and continues sensory experience" .

bglo:Effect_CH15_FL11 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One perceives the soul’s transmigration and embodied condition" .

bglo:Effect_CH15_FL12 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One clearly perceives spiritual reality" .

bglo:Effect_CH15_FL13 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The radiance of the sun, moon, and fire originates from the Supreme" .

bglo:Effect_CH15_FL14 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Cosmic order and life-supporting processes are maintained" .

bglo:Effect_CH15_FL15 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Digestion occurs through the indwelling divine fire of the Supreme" .

bglo:Effect_CH15_FL16 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The worlds and living systems are maintained and sustained" .

bglo:Effect_CH15_FL17 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Memory, knowledge, and forgetfulness arise from Him" .

bglo:Effect_CH15_FL18 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The Supreme is the object, compiler, and knower of the Vedas" .

bglo:Effect_CH15_FL19 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Beings are classified as fallible and infallible" .

bglo:Effect_CH15_FL2 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The cosmic tree of material existence becomes sustained and extended through guṇas and karma" .

bglo:Effect_CH15_FL20 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The Supreme Soul is ontologically distinct and superior to both" .

bglo:Effect_CH15_FL21 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "He is recognized as the Supreme Person" .

bglo:Effect_CH15_FL22 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One engages in full devotional service" .

bglo:Effect_CH15_FL23 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One becomes wise and achieves perfection in endeavor" .

bglo:Effect_CH15_FL3 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The bondage represented by the cosmic tree is cut down" .

bglo:Effect_CH15_FL4 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One progresses toward the supreme destination beyond material existence" .

bglo:Effect_CH15_FL5 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One attains the eternal kingdom" .

bglo:Effect_CH15_FL6 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It is self-luminous and independent of sun, moon, fire, or electricity" .

bglo:Effect_CH15_FL7 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Rebirth into the material world ceases" .

bglo:Effect_CH15_FL8 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "Every living entity is an eternal fragmental part of the Supreme" .

bglo:Effect_CH15_FL9 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "It struggles with the senses and the mind" .

