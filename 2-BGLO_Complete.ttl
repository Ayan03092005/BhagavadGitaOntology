    bglo:hasEffect bglo:Effect_CH10_FL21 ;
    bglo:hasRecommendedAction bglo:Action_CH10_FL21 ;
    bglo:hasRelationType bglo:RelationType_Normative ;
    bglo:involvesConcept bglo:Concept_Beauty,
        bglo:Concept_Divine_Manifestation,
        bglo:Concept_Excellence,
        bglo:Concept_Glory,
        bglo:Concept_Power,
        bglo:Concept_Strength,
        bglo:Concept_Wisdom ;
    bglo:supportedByVerse bgso:V401,
        bgso:V402 .

