bglo:CH10_CL6 a bglo:CanonicalLaw,
        owl:NamedIndividual ;
    rdfs:label "Cosmic Dependence Law" ;
    bglo:hasFineGrainedLaw bglo:CH10_FL19,
        bglo:CH10_FL20,
        bglo:CH10_FL21 ;
    rdfs:comment "All beings and all forms of excellence exist by dependence upon the Divine." .

bglo:CH10_FL20 a bglo:FineGrainedLaw,
        owl:NamedIndividual ;
    rdfs:label "Universal Support Law" ;
    bglo:belongsToCanonicalLaw bglo:CH10_CL6 ;
    bglo:hasCategory bglo:Category_Metaphysical ;
    bglo:hasCondition bglo:Condition_CH10_FL20 ;
    bglo:hasEffect bglo:Effect_CH10_FL20 ;
    bglo:hasRecommendedAction bglo:Action_CH10_FL20 ;
    bglo:hasRelationType bglo:RelationType_Metaphysical ;
    bglo:involvesConcept bglo:Concept_Dependence,
        bglo:Concept_Existence,
        bglo:Concept_Krsna,
        bglo:Concept_Universal_Support ;
    bglo:supportedByVerse bgso:V399,
        bgso:V402 .

bglo:CH10_FL21 a bglo:FineGrainedLaw,
        owl:NamedIndividual ;
    rdfs:label "Recognition of Divine Presence Law" ;
    bglo:affectsMentalState bglo:MentalState_Recognition,
        bglo:MentalState_Reverence ;
    bglo:belongsToCanonicalLaw bglo:CH10_CL6 ;
    bglo:hasCategory bglo:Category_Spiritual ;
