        owl:NamedIndividual ;
    rdfs:label "One becomes gradually elevated spiritually" .

bglo:Effect_CH16_FL3 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "The person is characterized as possessing demoniac nature" .

