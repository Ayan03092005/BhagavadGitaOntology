bglo:Condition_CH10_FL1 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Existence of demigods and great sages" .

bglo:Condition_CH10_FL10 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Devotees constantly think, converse, and enlighten one another about Kṛṣṇa" .

bglo:Condition_CH10_FL11 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One constantly serves Kṛṣṇa with love and devotion" .

bglo:Condition_CH10_FL12 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "A devotee receives Kṛṣṇa’s special mercy" .

bglo:Condition_CH10_FL13 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Among classes of beings, objects, powers, and phenomena" .

bglo:Condition_CH10_FL14 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Sacred entities such as Vedas, sacrifices, sages, mountains, rivers, and symbols exist" .

bglo:Condition_CH10_FL15 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Virtues such as morality, wisdom, silence, strength, victory, and patience exist" .

bglo:Condition_CH10_FL16 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Any moving or nonmoving being exists" .

bglo:Condition_CH10_FL17 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Divine manifestations are observed in creation" .

bglo:Condition_CH10_FL18 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Any entity displays exceptional beauty, glory, power, or excellence" .

bglo:Condition_CH10_FL19 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "The universe exists and functions" .

bglo:Condition_CH10_FL2 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One knows Kṛṣṇa as unborn, beginningless, and Supreme Lord" .

bglo:Condition_CH10_FL20 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Any being or object exists" .

bglo:Condition_CH10_FL21 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One observes excellence, beauty, glory, wisdom, strength, or power in creation" .

bglo:Condition_CH10_FL3 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Existence of sages, Manus, and living beings" .

bglo:Condition_CH10_FL4 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Spiritual and material worlds exist" .

bglo:Condition_CH10_FL5 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Existence of all living entities" .

bglo:Condition_CH10_FL6 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Qualities such as intelligence, truthfulness, forgiveness, equanimity, and charity exist" .

bglo:Condition_CH10_FL7 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Conditions such as happiness, distress, fear, fearlessness, birth, and death exist" .

bglo:Condition_CH10_FL8 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One becomes factually convinced of Kṛṣṇa’s opulence and mystic power" .

bglo:Condition_CH10_FL9 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One realizes that everything emanates from Kṛṣṇa" .

bglo:Condition_CH11_FL1 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One desires to behold the universal form of the Supreme" .

bglo:Condition_CH11_FL10 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "Cosmic events are governed by divine arrangement" .

bglo:Condition_CH11_FL11 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One performs duty in accordance with divine instruction" .

bglo:Condition_CH11_FL12 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One recognizes that outcomes are already arranged by the Supreme" .

bglo:Condition_CH11_FL13 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One realizes the greatness of the Supreme" .

bglo:Condition_CH11_FL14 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "The Supreme is properly understood" .

bglo:Condition_CH11_FL15 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One realizes the true glory of the Supreme" .

bglo:Condition_CH11_FL16 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "The Supreme is the father, teacher, and source of all beings" .

bglo:Condition_CH11_FL17 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One relies solely on Vedic study, sacrifice, austerity, charity, or ritual worship" .

bglo:Condition_CH11_FL18 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One engages in undivided devotional service" .

bglo:Condition_CH11_FL19 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "One practices pure devotion" .

bglo:Condition_CH11_FL2 a bglo:Condition,
        owl:NamedIndividual ;
    rdfs:label "The Supreme grants divine sight" .

bglo:Condition_CH11_FL20 a bglo:Condition,
        owl:NamedIndividual ;
