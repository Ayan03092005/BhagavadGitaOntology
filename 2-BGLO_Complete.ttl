@prefix bglo: <http://www.semanticweb.org/apurbapaul/bglo#> .
@prefix bgso: <http://www.semanticweb.org/apurbapaul/bgso#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bglo:BGLO a owl:Ontology ;
    rdfs:label "Bhagavad Gita Law Ontology" ;
    rdfs:comment "Ontology representing canonical laws, fine-grained laws, conditions, effects, actions, goals, concepts, mental states, verses and law relationships." ;
    owl:imports <http://www.semanticweb.org/apurbapaul/bgso> ;
    owl:versionInfo "1.0" .

bglo:affectsMentalState a owl:ObjectProperty ;
    rdfs:label "affects Mental State" ;
    rdfs:domain bglo:FineGrainedLaw ;
    rdfs:range bglo:MentalState .

bglo:causesLaw a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "causes Law" ;
    rdfs:domain bglo:CanonicalLaw ;
    rdfs:range bglo:CanonicalLaw ;
    rdfs:subPropertyOf bglo:relatedLaw .

bglo:confidence a owl:DatatypeProperty ;
    rdfs:domain bglo:LawRelationship ;
    rdfs:range xsd:decimal .

bglo:hasActionType a owl:ObjectProperty ;
    rdfs:label "has Action Type" ;
    rdfs:domain bglo:Action ;
    rdfs:range bglo:ActionType .

bglo:hasCategory a owl:ObjectProperty ;
    rdfs:label "has Category" ;
    rdfs:domain bglo:FineGrainedLaw ;
    rdfs:range bglo:Category .

bglo:hasCondition a owl:ObjectProperty ;
    rdfs:label "has Condition" ;
    rdfs:domain bglo:FineGrainedLaw ;
    rdfs:range bglo:Condition .

bglo:hasEffect a owl:ObjectProperty ;
    rdfs:label "has Effect" ;
    rdfs:domain bglo:FineGrainedLaw ;
    rdfs:range bglo:Effect .

bglo:hasFineGrainedLaw a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has Fine-Grained Law" ;
    rdfs:domain bglo:CanonicalLaw ;
    rdfs:range bglo:FineGrainedLaw ;
    owl:inverseOf bglo:belongsToCanonicalLaw .

bglo:hasGoal a owl:ObjectProperty ;
    rdfs:label "has Goal" ;
    rdfs:domain bglo:Action ;
    rdfs:range bglo:Goal .

bglo:hasGoalType a owl:ObjectProperty ;
    rdfs:label "has Goal Type" ;
    rdfs:domain bglo:Goal ;
    rdfs:range bglo:GoalType .

bglo:hasLawRelationship a owl:ObjectProperty ;
    rdfs:label "has Law Relationship" ;
    rdfs:domain bglo:CanonicalLaw ;
    rdfs:range bglo:LawRelationship .

bglo:hasRecommendedAction a owl:ObjectProperty ;
    rdfs:label "has Recommended Action" ;
    rdfs:domain bglo:FineGrainedLaw ;
    rdfs:range bglo:Action .

bglo:hasRelationType a owl:ObjectProperty ;
    rdfs:label "has Relation Type" ;
    rdfs:domain bglo:FineGrainedLaw ;
    rdfs:range bglo:RelationType .

bglo:involvesConcept a owl:ObjectProperty ;
    rdfs:label "involves Concept" ;
    rdfs:domain bglo:FineGrainedLaw ;
    rdfs:range bglo:Concept .

bglo:justification a owl:DatatypeProperty ;
    rdfs:domain bglo:LawRelationship ;
    rdfs:range xsd:string .

bglo:relationshipType a owl:ObjectProperty ;
    rdfs:label "relationship Type" ;
    rdfs:domain bglo:LawRelationship ;
    rdfs:range bglo:RelationType .

bglo:sourceLaw a owl:ObjectProperty ;
    rdfs:label "source Law" ;
    rdfs:domain bglo:LawRelationship ;
    rdfs:range bglo:CanonicalLaw .

bglo:supportedByLaw a owl:ObjectProperty ;
    rdfs:label "supported By Law" ;
    rdfs:domain bglo:CanonicalLaw ;
    rdfs:range bglo:CanonicalLaw ;
    rdfs:subPropertyOf bglo:relatedLaw .

bglo:supportedByVerse a owl:ObjectProperty ;
    rdfs:label "supported By Verse" ;
    rdfs:domain bglo:FineGrainedLaw ;
    rdfs:range bgso:Verse ;
    owl:inverseOf bglo:supportsLaw .

bglo:targetLaw a owl:ObjectProperty ;
    rdfs:label "target Law" ;
    rdfs:domain bglo:LawRelationship ;
    rdfs:range bglo:CanonicalLaw .

