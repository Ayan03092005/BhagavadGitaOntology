        owl:NamedIndividual ;
    rdfs:label "Lust, anger, and greed are recognized as the three gates leading to hellish existence" .

bglo:Effect_CH16_FL19 a bglo:Effect,
        owl:NamedIndividual ;
    rdfs:label "One performs acts leading toward self-realization and the supreme destination" .

